{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "yamlPatchManagementUrl": {
        "type": "String",
        "defaultValue": "",
        "description": "HTTP trigger URL of yaml-patch-management workflow"
      },
      "translationManagementUrl": {
        "type": "String",
        "defaultValue": "",
        "description": "HTTP trigger URL of translation-management workflow"
      },
      "muleBranchManagementUrl": {
        "type": "String",
        "defaultValue": "",
        "description": "HTTP trigger URL of mule-branch-management workflow"
      },
      "mulePrManagementUrl": {
        "type": "String",
        "defaultValue": "",
        "description": "HTTP trigger URL of mule-pr-management workflow"
      },
      "mainOrchestratorUrl": {
        "type": "String",
        "defaultValue": "",
        "description": "HTTP trigger URL of main-orchestrator workflow"
      }
    },
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "required": [
              "resource"
            ],
            "properties": {
              "resource": {
                "type": "string",
                "description": "yaml-patch | translation | mule-branch | mule-pr | fullOnboarding"
              },
              "action": {
                "type": "string",
                "description": "For mule-branch: create | get | list | delete. For mule-pr: create | get | list | merge"
              },
              "onboardingInput": {
                "type": "object",
                "description": "Required for: yaml-patch, translation, fullOnboarding"
              },
              "muleWebAppUrl": {
                "type": "string",
                "description": "Override web app URL for yaml-patch / translation"
              },
              "githubCredentials": {
                "type": "object",
                "properties": {
                  "pat": {
                    "type": "string"
                  }
                }
              },
              "repoConfig": {
                "type": "object",
                "description": "GitHub repo config for mule-branch, yaml-patch, mule-pr"
              },
              "payload": {
                "type": "object",
                "description": "Action-specific payload for mule-branch and mule-pr"
              },
              "notificationConfig": {
                "type": "object",
                "description": "Teams notification config for mule-pr create"
              },
              "githubConfig": {
                "type": "object",
                "description": "GitHub commit config for yaml-patch"
              },
              "branchName": {
                "type": "string",
                "description": "Feature branch override for fullOnboarding (auto-generated if omitted)"
              },
              "prTitle": {
                "type": "string"
              },
              "prBody": {
                "type": "string"
              },
              "prReviewers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "skipMuleBranch": {
                "type": "boolean"
              },
              "skipMulePr": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "actions": {
      "Route_By_Resource": {
        "type": "Switch",
        "expression": "@triggerBody()?['resource']",
        "runAfter": {},
        "cases": {
          "Case_YAML_Patch": {
            "case": "yaml-patch",
            "actions": {
              "Invoke_YAML_Patch_Management": {
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "@parameters('yamlPatchManagementUrl')",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "onboardingInput": "@triggerBody()?['onboardingInput']",
                    "muleWebAppUrl": "@triggerBody()?['muleWebAppUrl']",
                    "githubConfig": "@triggerBody()?['githubConfig']"
                  },
                  "retryPolicy": {
                    "type": "none"
                  }
                },
                "runAfter": {}
              },
              "Response_YAML_Patch": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": "@outputs('Invoke_YAML_Patch_Management')['statusCode']",
                  "body": "@body('Invoke_YAML_Patch_Management')"
                },
                "runAfter": {
                  "Invoke_YAML_Patch_Management": [
                    "Succeeded",
                    "Failed"
                  ]
                }
              }
            }
          },
          "Case_Translation": {
            "case": "translation",
            "actions": {
              "Invoke_Translation_Management": {
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "@parameters('translationManagementUrl')",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "onboardingInput": "@triggerBody()?['onboardingInput']",
                    "muleWebAppUrl": "@triggerBody()?['muleWebAppUrl']"
                  },
                  "retryPolicy": {
                    "type": "none"
                  }
                },
                "runAfter": {}
              },
              "Response_Translation": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": "@outputs('Invoke_Translation_Management')['statusCode']",
                  "body": "@body('Invoke_Translation_Management')"
                },
                "runAfter": {
                  "Invoke_Translation_Management": [
                    "Succeeded",
                    "Failed"
                  ]
                }
              }
            }
          },
          "Case_Mule_Branch": {
            "case": "mule-branch",
            "actions": {
              "Invoke_Mule_Branch_Management": {
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "@parameters('muleBranchManagementUrl')",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "githubCredentials": "@triggerBody()?['githubCredentials']",
                    "repoConfig": "@triggerBody()?['repoConfig']",
                    "action": "@triggerBody()?['action']",
                    "payload": "@triggerBody()?['payload']"
                  },
                  "retryPolicy": {
                    "type": "none"
                  }
                },
                "runAfter": {}
              },
              "Response_Mule_Branch": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": "@outputs('Invoke_Mule_Branch_Management')['statusCode']",
                  "body": "@body('Invoke_Mule_Branch_Management')"
                },
                "runAfter": {
                  "Invoke_Mule_Branch_Management": [
                    "Succeeded",
                    "Failed"
                  ]
                }
              }
            }
          },
          "Case_Mule_PR": {
            "case": "mule-pr",
            "actions": {
              "Invoke_Mule_PR_Management": {
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "@parameters('mulePrManagementUrl')",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "githubCredentials": "@triggerBody()?['githubCredentials']",
                    "repoConfig": "@triggerBody()?['repoConfig']",
                    "action": "@triggerBody()?['action']",
                    "payload": "@triggerBody()?['payload']",
                    "notificationConfig": "@triggerBody()?['notificationConfig']"
                  },
                  "retryPolicy": {
                    "type": "none"
                  }
                },
                "runAfter": {}
              },
              "Response_Mule_PR": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": "@outputs('Invoke_Mule_PR_Management')['statusCode']",
                  "body": "@body('Invoke_Mule_PR_Management')"
                },
                "runAfter": {
                  "Invoke_Mule_PR_Management": [
                    "Succeeded",
                    "Failed"
                  ]
                }
              }
            }
          },
          "Case_Full_Onboarding": {
            "case": "fullOnboarding",
            "actions": {
              "Invoke_Full_Orchestration": {
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "@parameters('mainOrchestratorUrl')",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "body": "@triggerBody()",
                  "retryPolicy": {
                    "type": "none"
                  }
                },
                "runAfter": {}
              },
              "Response_Full_Onboarding": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": "@outputs('Invoke_Full_Orchestration')['statusCode']",
                  "body": "@body('Invoke_Full_Orchestration')"
                },
                "runAfter": {
                  "Invoke_Full_Orchestration": [
                    "Succeeded",
                    "Failed"
                  ]
                }
              }
            }
          }
        },
        "default": {
          "actions": {
            "Response_Invalid_Resource": {
              "type": "Response",
              "kind": "Http",
              "runAfter": {},
              "inputs": {
                "statusCode": 400,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "error": "Invalid resource. Valid values: yaml-patch | translation | mule-branch | mule-pr | fullOnboarding",
                  "received": "@{triggerBody()?['resource']}"
                }
              }
            }
          }
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}