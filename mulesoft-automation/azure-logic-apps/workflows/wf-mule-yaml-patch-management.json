{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "muleWebAppUrl": {
        "type": "String",
        "defaultValue": "",
        "description": "Base URL of the deployed 3pl-automation web app e.g. https://3pl-onboarding.azurewebsites.net"
      },
      "githubApiBaseUrl": {
        "type": "String",
        "defaultValue": "https://api.github.com"
      }
    },
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "required": [
              "onboardingInput"
            ],
            "properties": {
              "onboardingInput": {
                "type": "object",
                "description": "Full 3PL OnboardingInput \u2014 same schema as POST /api/run body",
                "required": [
                  "country_key",
                  "country_code",
                  "nav",
                  "translation"
                ],
                "properties": {
                  "partner_comment": {
                    "type": "string"
                  },
                  "country_key": {
                    "type": "string"
                  },
                  "country_code": {
                    "type": "string"
                  },
                  "created_by": {
                    "type": "string"
                  },
                  "nav": {
                    "type": "object"
                  },
                  "nav_tst": {
                    "type": "object"
                  },
                  "nav_prod": {
                    "type": "object"
                  },
                  "translation": {
                    "type": "object"
                  }
                }
              },
              "muleWebAppUrl": {
                "type": "string",
                "description": "Override web app URL (defaults to workflow parameter)"
              },
              "githubConfig": {
                "type": "object",
                "description": "GitHub config for committing patched YAMLs \u2014 omit to skip GitHub commit",
                "properties": {
                  "pat": {
                    "type": "string",
                    "description": "GitHub Personal Access Token"
                  },
                  "owner": {
                    "type": "string",
                    "description": "GitHub org/user owning the MuleSoft repo"
                  },
                  "repo": {
                    "type": "string",
                    "description": "MuleSoft config repository name"
                  },
                  "branchName": {
                    "type": "string",
                    "description": "Feature branch to commit to"
                  },
                  "appYamlPath": {
                    "type": "string",
                    "description": "Path to app.yaml in repo e.g. src/main/resources/app.yaml"
                  },
                  "devYamlPath": {
                    "type": "string",
                    "description": "Path to dev.yaml in repo"
                  },
                  "tstYamlPath": {
                    "type": "string",
                    "description": "Path to tst.yaml in repo"
                  },
                  "prodYamlPath": {
                    "type": "string",
                    "description": "Path to prod.yaml in repo"
                  },
                  "commitMessage": {
                    "type": "string",
                    "description": "Optional commit message override"
                  }
                }
              }
            }
          }
        }
      }
    },
    "actions": {
      "Initialize_runId": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "runId",
              "type": "string",
              "value": ""
            }
          ]
        },
        "runAfter": {}
      },
      "Initialize_webAppBaseUrl": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "webAppBaseUrl",
              "type": "string",
              "value": "@{coalesce(triggerBody()?['muleWebAppUrl'], parameters('muleWebAppUrl'))}"
            }
          ]
        },
        "runAfter": {
          "Initialize_runId": [
            "Succeeded"
          ]
        }
      },
      "Initialize_commitMessage": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "commitMessage",
              "type": "string",
              "value": "@{coalesce(triggerBody()?['githubConfig']?['commitMessage'], concat('feat: add ', triggerBody()?['onboardingInput']?['country_key'], ' nav config for 3PL onboarding'))}"
            }
          ]
        },
        "runAfter": {
          "Initialize_webAppBaseUrl": [
            "Succeeded"
          ]
        }
      },
      "Invoke_YAML_Patch_WebApp": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{concat(variables('webAppBaseUrl'), '/api/tools/yaml-patch')}",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "@triggerBody()?['onboardingInput']",
          "retryPolicy": {
            "type": "none"
          }
        },
        "runAfter": {
          "Initialize_commitMessage": [
            "Succeeded"
          ]
        }
      },
      "Check_Patch_Success": {
        "type": "If",
        "expression": {
          "and": [
            {
              "equals": [
                "@outputs('Invoke_YAML_Patch_WebApp')['statusCode']",
                200
              ]
            }
          ]
        },
        "actions": {
          "Set_runId": {
            "type": "SetVariable",
            "inputs": {
              "name": "runId",
              "value": "@{body('Invoke_YAML_Patch_WebApp')?['run_id']}"
            },
            "runAfter": {}
          },
          "Check_GitHub_Commit_Requested": {
            "type": "If",
            "expression": {
              "and": [
                {
                  "not": {
                    "equals": [
                      "@coalesce(triggerBody()?['githubConfig']?['pat'], '')",
                      ""
                    ]
                  }
                },
                {
                  "not": {
                    "equals": [
                      "@coalesce(triggerBody()?['githubConfig']?['branchName'], '')",
                      ""
                    ]
                  }
                }
              ]
            },
            "actions": {
              "Download_App_YAML": {
                "type": "Http",
                "inputs": {
                  "method": "GET",
                  "uri": "@{concat(variables('webAppBaseUrl'), '/api/download/', variables('runId'), '/app-yaml')}",
                  "retryPolicy": {
                    "type": "none"
                  }
                },
                "runAfter": {}
              },
              "Download_Dev_YAML": {
                "type": "Http",
                "inputs": {
                  "method": "GET",
                  "uri": "@{concat(variables('webAppBaseUrl'), '/api/download/', variables('runId'), '/yaml')}",
                  "retryPolicy": {
                    "type": "none"
                  }
                },
                "runAfter": {}
              },
              "Download_TST_YAML": {
                "type": "Http",
                "inputs": {
                  "method": "GET",
                  "uri": "@{concat(variables('webAppBaseUrl'), '/api/download/', variables('runId'), '/tst-yaml')}",
                  "retryPolicy": {
                    "type": "none"
                  }
                },
                "runAfter": {}
              },
              "Download_PROD_YAML": {
                "type": "Http",
                "inputs": {
                  "method": "GET",
                  "uri": "@{concat(variables('webAppBaseUrl'), '/api/download/', variables('runId'), '/prod-yaml')}",
                  "retryPolicy": {
                    "type": "none"
                  }
                },
                "runAfter": {}
              },
              "Get_App_YAML_SHA": {
                "type": "Http",
                "inputs": {
                  "method": "GET",
                  "uri": "@{concat(parameters('githubApiBaseUrl'), '/repos/', triggerBody()?['githubConfig']?['owner'], '/', triggerBody()?['githubConfig']?['repo'], '/contents/', coalesce(triggerBody()?['githubConfig']?['appYamlPath'], 'src/main/resources/app.yaml'), '?ref=', triggerBody()?['githubConfig']?['branchName'])}",
                  "headers": {
                    "Authorization": "@{concat('Bearer ', triggerBody()?['githubConfig']?['pat'])}",
                    "Accept": "application/vnd.github+json",
                    "X-GitHub-Api-Version": "2022-11-28",
                    "User-Agent": "mars-3pl-mulesoft-automation/1.0"
                  },
                  "retryPolicy": {
                    "type": "none"
                  }
                },
                "runAfter": {
                  "Download_App_YAML": [
                    "Succeeded"
                  ]
                }
              },
              "Commit_App_YAML": {
                "type": "Http",
                "inputs": {
                  "method": "PUT",
                  "uri": "@{concat(parameters('githubApiBaseUrl'), '/repos/', triggerBody()?['githubConfig']?['owner'], '/', triggerBody()?['githubConfig']?['repo'], '/contents/', coalesce(triggerBody()?['githubConfig']?['appYamlPath'], 'src/main/resources/app.yaml'))}",
                  "headers": {
                    "Authorization": "@{concat('Bearer ', triggerBody()?['githubConfig']?['pat'])}",
                    "Accept": "application/vnd.github+json",
                    "X-GitHub-Api-Version": "2022-11-28",
                    "Content-Type": "application/json",
                    "User-Agent": "mars-3pl-mulesoft-automation/1.0"
                  },
                  "body": {
                    "message": "@{concat(variables('commitMessage'), ' [app.yaml]')}",
                    "content": "@{base64(body('Download_App_YAML'))}",
                    "branch": "@{triggerBody()?['githubConfig']?['branchName']}",
                    "sha": "@{body('Get_App_YAML_SHA')?['sha']}"
                  },
                  "retryPolicy": {
                    "type": "none"
                  }
                },
                "runAfter": {
                  "Get_App_YAML_SHA": [
                    "Succeeded"
                  ]
                }
              },
              "Get_Dev_YAML_SHA": {
                "type": "Http",
                "inputs": {
                  "method": "GET",
                  "uri": "@{concat(parameters('githubApiBaseUrl'), '/repos/', triggerBody()?['githubConfig']?['owner'], '/', triggerBody()?['githubConfig']?['repo'], '/contents/', coalesce(triggerBody()?['githubConfig']?['devYamlPath'], 'src/main/resources/dev.yaml'), '?ref=', triggerBody()?['githubConfig']?['branchName'])}",
                  "headers": {
                    "Authorization": "@{concat('Bearer ', triggerBody()?['githubConfig']?['pat'])}",
                    "Accept": "application/vnd.github+json",
                    "X-GitHub-Api-Version": "2022-11-28",
                    "User-Agent": "mars-3pl-mulesoft-automation/1.0"
                  },
                  "retryPolicy": {
                    "type": "none"
                  }
                },
                "runAfter": {
                  "Download_Dev_YAML": [
                    "Succeeded"
                  ]
                }
              },
              "Commit_Dev_YAML": {
                "type": "Http",
                "inputs": {
                  "method": "PUT",
                  "uri": "@{concat(parameters('githubApiBaseUrl'), '/repos/', triggerBody()?['githubConfig']?['owner'], '/', triggerBody()?['githubConfig']?['repo'], '/contents/', coalesce(triggerBody()?['githubConfig']?['devYamlPath'], 'src/main/resources/dev.yaml'))}",
                  "headers": {
                    "Authorization": "@{concat('Bearer ', triggerBody()?['githubConfig']?['pat'])}",
                    "Accept": "application/vnd.github+json",
                    "X-GitHub-Api-Version": "2022-11-28",
                    "Content-Type": "application/json",
                    "User-Agent": "mars-3pl-mulesoft-automation/1.0"
                  },
                  "body": {
                    "message": "@{concat(variables('commitMessage'), ' [dev.yaml]')}",
                    "content": "@{base64(body('Download_Dev_YAML'))}",
                    "branch": "@{triggerBody()?['githubConfig']?['branchName']}",
                    "sha": "@{body('Get_Dev_YAML_SHA')?['sha']}"
                  },
                  "retryPolicy": {
                    "type": "none"
                  }
                },
                "runAfter": {
                  "Get_Dev_YAML_SHA": [
                    "Succeeded"
                  ]
                }
              },
              "Check_TST_Download_OK": {
                "type": "If",
                "expression": {
                  "and": [
                    {
                      "equals": [
                        "@outputs('Download_TST_YAML')['statusCode']",
                        200
                      ]
                    }
                  ]
                },
                "actions": {
                  "Get_TST_YAML_SHA": {
                    "type": "Http",
                    "inputs": {
                      "method": "GET",
                      "uri": "@{concat(parameters('githubApiBaseUrl'), '/repos/', triggerBody()?['githubConfig']?['owner'], '/', triggerBody()?['githubConfig']?['repo'], '/contents/', coalesce(triggerBody()?['githubConfig']?['tstYamlPath'], 'src/main/resources/tst.yaml'), '?ref=', triggerBody()?['githubConfig']?['branchName'])}",
                      "headers": {
                        "Authorization": "@{concat('Bearer ', triggerBody()?['githubConfig']?['pat'])}",
                        "Accept": "application/vnd.github+json",
                        "X-GitHub-Api-Version": "2022-11-28",
                        "User-Agent": "mars-3pl-mulesoft-automation/1.0"
                      },
                      "retryPolicy": {
                        "type": "none"
                      }
                    },
                    "runAfter": {}
                  },
                  "Commit_TST_YAML": {
                    "type": "Http",
                    "inputs": {
                      "method": "PUT",
                      "uri": "@{concat(parameters('githubApiBaseUrl'), '/repos/', triggerBody()?['githubConfig']?['owner'], '/', triggerBody()?['githubConfig']?['repo'], '/contents/', coalesce(triggerBody()?['githubConfig']?['tstYamlPath'], 'src/main/resources/tst.yaml'))}",
                      "headers": {
                        "Authorization": "@{concat('Bearer ', triggerBody()?['githubConfig']?['pat'])}",
                        "Accept": "application/vnd.github+json",
                        "X-GitHub-Api-Version": "2022-11-28",
                        "Content-Type": "application/json",
                        "User-Agent": "mars-3pl-mulesoft-automation/1.0"
                      },
                      "body": {
                        "message": "@{concat(variables('commitMessage'), ' [tst.yaml]')}",
                        "content": "@{base64(body('Download_TST_YAML'))}",
                        "branch": "@{triggerBody()?['githubConfig']?['branchName']}",
                        "sha": "@{body('Get_TST_YAML_SHA')?['sha']}"
                      },
                      "retryPolicy": {
                        "type": "none"
                      }
                    },
                    "runAfter": {
                      "Get_TST_YAML_SHA": [
                        "Succeeded"
                      ]
                    }
                  }
                },
                "runAfter": {
                  "Download_TST_YAML": [
                    "Succeeded",
                    "Failed"
                  ]
                }
              },
              "Check_PROD_Download_OK": {
                "type": "If",
                "expression": {
                  "and": [
                    {
                      "equals": [
                        "@outputs('Download_PROD_YAML')['statusCode']",
                        200
                      ]
                    }
                  ]
                },
                "actions": {
                  "Get_PROD_YAML_SHA": {
                    "type": "Http",
                    "inputs": {
                      "method": "GET",
                      "uri": "@{concat(parameters('githubApiBaseUrl'), '/repos/', triggerBody()?['githubConfig']?['owner'], '/', triggerBody()?['githubConfig']?['repo'], '/contents/', coalesce(triggerBody()?['githubConfig']?['prodYamlPath'], 'src/main/resources/prod.yaml'), '?ref=', triggerBody()?['githubConfig']?['branchName'])}",
                      "headers": {
                        "Authorization": "@{concat('Bearer ', triggerBody()?['githubConfig']?['pat'])}",
                        "Accept": "application/vnd.github+json",
                        "X-GitHub-Api-Version": "2022-11-28",
                        "User-Agent": "mars-3pl-mulesoft-automation/1.0"
                      },
                      "retryPolicy": {
                        "type": "none"
                      }
                    },
                    "runAfter": {}
                  },
                  "Commit_PROD_YAML": {
                    "type": "Http",
                    "inputs": {
                      "method": "PUT",
                      "uri": "@{concat(parameters('githubApiBaseUrl'), '/repos/', triggerBody()?['githubConfig']?['owner'], '/', triggerBody()?['githubConfig']?['repo'], '/contents/', coalesce(triggerBody()?['githubConfig']?['prodYamlPath'], 'src/main/resources/prod.yaml'))}",
                      "headers": {
                        "Authorization": "@{concat('Bearer ', triggerBody()?['githubConfig']?['pat'])}",
                        "Accept": "application/vnd.github+json",
                        "X-GitHub-Api-Version": "2022-11-28",
                        "Content-Type": "application/json",
                        "User-Agent": "mars-3pl-mulesoft-automation/1.0"
                      },
                      "body": {
                        "message": "@{concat(variables('commitMessage'), ' [prod.yaml]')}",
                        "content": "@{base64(body('Download_PROD_YAML'))}",
                        "branch": "@{triggerBody()?['githubConfig']?['branchName']}",
                        "sha": "@{body('Get_PROD_YAML_SHA')?['sha']}"
                      },
                      "retryPolicy": {
                        "type": "none"
                      }
                    },
                    "runAfter": {
                      "Get_PROD_YAML_SHA": [
                        "Succeeded"
                      ]
                    }
                  }
                },
                "runAfter": {
                  "Download_PROD_YAML": [
                    "Succeeded",
                    "Failed"
                  ]
                }
              }
            },
            "runAfter": {
              "Set_runId": [
                "Succeeded"
              ]
            }
          },
          "Response_Success": {
            "type": "Response",
            "kind": "Http",
            "inputs": {
              "statusCode": 200,
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "step": 7,
                "stepKey": "yaml-patch",
                "status": "ok",
                "run_id": "@{variables('runId')}",
                "country_key": "@{triggerBody()?['onboardingInput']?['country_key']}",
                "country_code": "@{triggerBody()?['onboardingInput']?['country_code']}",
                "filesPatched": [
                  "app.yaml",
                  "dev.yaml",
                  "tst.yaml (if nav_tst provided)",
                  "prod.yaml (if nav_prod provided)"
                ],
                "downloadUrls": {
                  "appYaml": "@{concat(variables('webAppBaseUrl'), '/api/download/', variables('runId'), '/app-yaml')}",
                  "devYaml": "@{concat(variables('webAppBaseUrl'), '/api/download/', variables('runId'), '/yaml')}",
                  "tstYaml": "@{concat(variables('webAppBaseUrl'), '/api/download/', variables('runId'), '/tst-yaml')}",
                  "prodYaml": "@{concat(variables('webAppBaseUrl'), '/api/download/', variables('runId'), '/prod-yaml')}"
                },
                "githubCommitted": "@{not(equals(coalesce(triggerBody()?['githubConfig']?['pat'], ''), ''))}"
              }
            },
            "runAfter": {
              "Check_GitHub_Commit_Requested": [
                "Succeeded",
                "Failed"
              ]
            }
          }
        },
        "else": {
          "actions": {
            "Response_Patch_Error": {
              "type": "Response",
              "kind": "Http",
              "inputs": {
                "statusCode": "@{outputs('Invoke_YAML_Patch_WebApp')['statusCode']}",
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "step": 7,
                  "stepKey": "yaml-patch",
                  "status": "error",
                  "detail": "YAML patch web app returned an error",
                  "webAppStatus": "@{outputs('Invoke_YAML_Patch_WebApp')['statusCode']}",
                  "webAppError": "@{body('Invoke_YAML_Patch_WebApp')}"
                }
              },
              "runAfter": {}
            }
          }
        },
        "runAfter": {
          "Invoke_YAML_Patch_WebApp": [
            "Succeeded",
            "Failed"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}