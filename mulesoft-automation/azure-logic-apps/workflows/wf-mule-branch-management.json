{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "githubApiBaseUrl": {
        "type": "String",
        "defaultValue": "https://api.github.com"
      }
    },
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "required": ["githubCredentials", "repoConfig", "action"],
            "properties": {
              "githubCredentials": {
                "type": "object",
                "required": ["pat"],
                "properties": {
                  "pat": { "type": "string", "description": "GitHub Personal Access Token with repo scope" }
                }
              },
              "repoConfig": {
                "type": "object",
                "required": ["owner", "repo"],
                "properties": {
                  "owner": { "type": "string", "description": "GitHub organisation or user name" },
                  "repo":  { "type": "string", "description": "Repository name" }
                }
              },
              "action": {
                "type": "string",
                "description": "create | get | list | delete"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "branchName": { "type": "string", "description": "Branch name to create / get / delete" },
                  "baseBranch": { "type": "string", "description": "Source branch for create — defaults to main" }
                }
              }
            }
          }
        }
      }
    },
    "actions": {

      "Switch_By_Action": {
        "type": "Switch",
        "expression": "@triggerBody()?['action']",
        "runAfter": {},

        "cases": {

          "Case_Create": {
            "case": "create",
            "actions": {
              "Get_Base_Branch_Ref": {
                "type": "Http",
                "inputs": {
                  "method": "GET",
                  "uri": "@{concat(parameters('githubApiBaseUrl'), '/repos/', triggerBody()?['repoConfig']?['owner'], '/', triggerBody()?['repoConfig']?['repo'], '/git/refs/heads/', coalesce(triggerBody()?['payload']?['baseBranch'], 'main'))}",
                  "headers": {
                    "Authorization": "@{concat('Bearer ', triggerBody()?['githubCredentials']?['pat'])}",
                    "Accept": "application/vnd.github+json",
                    "X-GitHub-Api-Version": "2022-11-28",
                    "User-Agent": "mars-3pl-mulesoft-automation/1.0"
                  }
                },
                "runAfter": {}
              },
              "Create_Branch_Ref": {
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "@{concat(parameters('githubApiBaseUrl'), '/repos/', triggerBody()?['repoConfig']?['owner'], '/', triggerBody()?['repoConfig']?['repo'], '/git/refs')}",
                  "headers": {
                    "Authorization": "@{concat('Bearer ', triggerBody()?['githubCredentials']?['pat'])}",
                    "Accept": "application/vnd.github+json",
                    "X-GitHub-Api-Version": "2022-11-28",
                    "Content-Type": "application/json",
                    "User-Agent": "mars-3pl-mulesoft-automation/1.0"
                  },
                  "body": {
                    "ref": "@{concat('refs/heads/', triggerBody()?['payload']?['branchName'])}",
                    "sha": "@{body('Get_Base_Branch_Ref')?['object']?['sha']}"
                  }
                },
                "runAfter": { "Get_Base_Branch_Ref": ["Succeeded"] }
              },
              "Response_Create": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": "@{outputs('Create_Branch_Ref')['statusCode']}",
                  "headers": { "Content-Type": "application/json" },
                  "body": {
                    "step": 6,
                    "stepKey": "mule-branch",
                    "status": "ok",
                    "action": "create",
                    "branchName": "@{triggerBody()?['payload']?['branchName']}",
                    "baseBranch":  "@{coalesce(triggerBody()?['payload']?['baseBranch'], 'main')}",
                    "sha":        "@{body('Get_Base_Branch_Ref')?['object']?['sha']}",
                    "ref":        "@{body('Create_Branch_Ref')?['ref']}",
                    "repo":       "@{concat(triggerBody()?['repoConfig']?['owner'], '/', triggerBody()?['repoConfig']?['repo'])}"
                  }
                },
                "runAfter": { "Create_Branch_Ref": ["Succeeded", "Failed"] }
              },
              "Response_Base_Branch_Error": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": "@{outputs('Get_Base_Branch_Ref')['statusCode']}",
                  "headers": { "Content-Type": "application/json" },
                  "body": {
                    "step": 6,
                    "stepKey": "mule-branch",
                    "status": "error",
                    "action": "create",
                    "detail": "Base branch not found or GitHub API error",
                    "baseBranch": "@{coalesce(triggerBody()?['payload']?['baseBranch'], 'main')}",
                    "githubStatus": "@{outputs('Get_Base_Branch_Ref')['statusCode']}",
                    "githubError":  "@{body('Get_Base_Branch_Ref')}"
                  }
                },
                "runAfter": { "Get_Base_Branch_Ref": ["Failed", "TimedOut"] }
              }
            }
          },

          "Case_Get": {
            "case": "get",
            "actions": {
              "Get_Branch_Ref": {
                "type": "Http",
                "inputs": {
                  "method": "GET",
                  "uri": "@{concat(parameters('githubApiBaseUrl'), '/repos/', triggerBody()?['repoConfig']?['owner'], '/', triggerBody()?['repoConfig']?['repo'], '/git/refs/heads/', triggerBody()?['payload']?['branchName'])}",
                  "headers": {
                    "Authorization": "@{concat('Bearer ', triggerBody()?['githubCredentials']?['pat'])}",
                    "Accept": "application/vnd.github+json",
                    "X-GitHub-Api-Version": "2022-11-28",
                    "User-Agent": "mars-3pl-mulesoft-automation/1.0"
                  }
                },
                "runAfter": {}
              },
              "Response_Get": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": "@{outputs('Get_Branch_Ref')['statusCode']}",
                  "body": "@body('Get_Branch_Ref')"
                },
                "runAfter": { "Get_Branch_Ref": ["Succeeded", "Failed"] }
              }
            }
          },

          "Case_List": {
            "case": "list",
            "actions": {
              "List_Branches": {
                "type": "Http",
                "inputs": {
                  "method": "GET",
                  "uri": "@{concat(parameters('githubApiBaseUrl'), '/repos/', triggerBody()?['repoConfig']?['owner'], '/', triggerBody()?['repoConfig']?['repo'], '/branches?per_page=100')}",
                  "headers": {
                    "Authorization": "@{concat('Bearer ', triggerBody()?['githubCredentials']?['pat'])}",
                    "Accept": "application/vnd.github+json",
                    "X-GitHub-Api-Version": "2022-11-28",
                    "User-Agent": "mars-3pl-mulesoft-automation/1.0"
                  }
                },
                "runAfter": {}
              },
              "Response_List": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": "@{outputs('List_Branches')['statusCode']}",
                  "body": "@body('List_Branches')"
                },
                "runAfter": { "List_Branches": ["Succeeded", "Failed"] }
              }
            }
          },

          "Case_Delete": {
            "case": "delete",
            "actions": {
              "Delete_Branch_Ref": {
                "type": "Http",
                "inputs": {
                  "method": "DELETE",
                  "uri": "@{concat(parameters('githubApiBaseUrl'), '/repos/', triggerBody()?['repoConfig']?['owner'], '/', triggerBody()?['repoConfig']?['repo'], '/git/refs/heads/', triggerBody()?['payload']?['branchName'])}",
                  "headers": {
                    "Authorization": "@{concat('Bearer ', triggerBody()?['githubCredentials']?['pat'])}",
                    "Accept": "application/vnd.github+json",
                    "X-GitHub-Api-Version": "2022-11-28",
                    "User-Agent": "mars-3pl-mulesoft-automation/1.0"
                  }
                },
                "runAfter": {}
              },
              "Response_Delete": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": 200,
                  "headers": { "Content-Type": "application/json" },
                  "body": {
                    "status": "deleted",
                    "branchName": "@{triggerBody()?['payload']?['branchName']}",
                    "repo": "@{concat(triggerBody()?['repoConfig']?['owner'], '/', triggerBody()?['repoConfig']?['repo'])}"
                  }
                },
                "runAfter": { "Delete_Branch_Ref": ["Succeeded", "Failed"] }
              }
            }
          }

        },

        "default": {
          "actions": {
            "Response_Invalid_Action": {
              "type": "Response",
              "kind": "Http",
              "runAfter": {},
              "inputs": {
                "statusCode": 400,
                "headers": { "Content-Type": "application/json" },
                "body": {
                  "error": "Invalid action. Valid values: create | get | list | delete",
                  "received": "@{triggerBody()?['action']}"
                }
              }
            }
          }
        }
      }

    },
    "outputs": {}
  },
  "kind": "Stateful"
}
