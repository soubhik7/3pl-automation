                    <mxGeometry x="80" y="1190" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="l-btp-stub" value="&lt;b&gt;SAP BTP — 🚧 TBD&lt;/b&gt;&#xa;Compose action returns:&#xa;{status: not_configured, message: Future scope}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontColor=#888888;fontSize=11;dashed=1;align=left;spacingLeft=8;" parent="1" vertex="1">
