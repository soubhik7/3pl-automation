                <mxCell id="l-orch" value="&lt;b&gt;wf-3pl-onboarding-orchestrator&lt;/b&gt;&#xa;🌐 prod-29.eastus.logic.azure.com&#xa;&#xa;IN: {submissionId, statusPath, config}&#xa;→ PUT status: running  (services: solace=running)&#xa;→ POST wf-solace-automation-main-orchestrator&#xa;→ Compose MuleSoft stub  (not_configured)&#xa;→ Compose BTP stub          (not_configured)&#xa;→ PUT status: completed / failed&#xa;OUT: {status, solace: {serviceId, domainId}}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c7d9f5;strokeColor=#2f75b5;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="80" y="970" width="440" height="150" as="geometry"/>
