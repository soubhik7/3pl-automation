                <mxCell id="l-a-app-blob" value="PUT status: approved" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;dashed=1;strokeColor=#2f75b5;" parent="1" source="l-app-la" target="l-blob" edge="1">
