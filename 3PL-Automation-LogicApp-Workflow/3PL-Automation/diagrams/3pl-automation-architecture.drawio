                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l-a-btp" value="stub" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;dashed=1;strokeColor=#aaaaaa;" parent="1" source="l-orch" target="l-btp-stub" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l-stat-la" value="&lt;b&gt;wf-3pl-onboarding-status&lt;/b&gt;&#xa;🌐 prod-07.eastus.logic.azure.com&#xa;&#xa;IN: {submissionId}&#xa;→ GET /status/{id}-status.json&#xa;OUT: full status JSON (or 404 if not found)&#xa;Called every 10 s by UI Progress View" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c7d9f5;strokeColor=#2f75b5;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1330" width="440" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="l-prog-ui" value="&lt;b&gt;UI: Progress View&lt;/b&gt;&#xa;Solace ✅ · MuleSoft 🚧 · BTP 🚧&#xa;Polls every 10 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f7e8;strokeColor=#2ea44f;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1500" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="l-mgr2" value="👤 3PL Manager" style="shape=mxgraph.archimate3.actor;html=1;whiteSpace=wrap;fillColor=#fff;strokeColor=#2ea44f;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="365" y="1490" width="70" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="l-a-stat-poll" value="GET {submissionId}" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;" parent="1" source="l-prog-ui" target="l-stat-la" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l-a-stat-blob" value="GET status blob" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;dashed=1;strokeColor=#2ea44f;" parent="1" source="l-stat-la" target="l-blob" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="68" y="1385"/>
                            <mxPoint x="68" y="500"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="l-a-mgr-prog" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="l-mgr2" target="l-prog-ui" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l-col-b-bg" value="SOLACE AUTOMATION CHAIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=30;fontSize=13;fontStyle=1;verticalAlign=top;align=center;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="610" y="80" width="660" height="1600" as="geometry"/>
                </mxCell>
                <mxCell id="l-sol-main" value="&lt;b&gt;wf-solace-automation-main-orchestrator&lt;/b&gt;&#xa;🌐 prod-46.eastus.logic.azure.com&#xa;&#xa;IN: {config, skipEventPortal, skipCluster}&#xa;Orchestrates full provisioning sequence:&#xa;1. Service Provisioning  2. Credentials Init&#xa;3. Event Portal          4. Cluster Management&#xa;5. Export Clone&#xa;OUT: {serviceId, vpnName, domainId}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="640" y="140" width="600" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="l-a-orch-sol" value="POST {submissionId, statusPath, config}" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" parent="1" source="l-orch" target="l-sol-main" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l-sol-svc" value="&lt;b&gt;1. wf-solace-automation-service-provisioning&lt;/b&gt;&#xa;🌐 prod-79.eastus.logic.azure.com&#xa;&#xa;• POST /api/v0/services  (Solace Cloud API)&#xa;• Poll GET /api/v0/services/{id} every 15s&#xa;  until creationState = completed (max 40 polls)&#xa;OUT: {serviceId, vpnName, sempBaseUrl,&#xa;       sempUsername, sempPassword}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="640" y="330" width="600" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="l-a-sol-svc" value="1 — POST {serviceName, serviceTypeId, datacenterId}" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;" parent="1" source="l-sol-main" target="l-sol-svc" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l-sol-cred" value="&lt;b&gt;2. wf-solace-automation-credentials-init&lt;/b&gt;&#xa;🌐 prod-86.eastus.logic.azure.com&#xa;&#xa;• Validate Solace API token via GET /api/v2/organizations&#xa;• PATCH Azure ARM: update Logic App parameters&#xa;  (SOLACE_SEMP_BASE_URL, SOLACE_SEMP_USERNAME,&#xa;   SOLACE_SEMP_PASSWORD, SOLACE_SERVICE_ID)&#xa;OUT: {validated: true, parametersUpdated: true}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="640" y="510" width="600" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="l-a-sol-cred" value="2 — POST {serviceId, apiToken, sempCreds}" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;" parent="1" source="l-sol-svc" target="l-sol-cred" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l-sol-ep" value="&lt;b&gt;3. wf-solace-automation-event-portal-provisioning&lt;/b&gt;&#xa;🌐 prod-06.eastus.logic.azure.com&#xa;&#xa;• POST /architecture/eventPortalApplicationDomains&#xa;• POST schemas  (1 per unique business object)&#xa;• POST events   (1 per interface, topic-mapped)&#xa;• POST applications (3PL sender + 1NAV receiver)&#xa;• POST event-version bindings&#xa;OUT: {domainId, schemaIds[], eventIds[], appIds[]}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="640" y="700" width="600" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="l-a-sol-ep" value="3 — POST {partnerID, topicNS, schemas[], events[]}" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;" parent="1" source="l-sol-cred" target="l-sol-ep" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l-sol-cluster" value="&lt;b&gt;4. wf-solace-automation-cluster-management&lt;/b&gt;&#xa;🌐 prod-26.eastus.logic.azure.com&#xa;&#xa;Accepts: {action, subResource, payload}&#xa;subResource options: clientProfile · aclProfile · publishException&#xa;                     subscribeException · clientUsername · queue&#xa;                     queueSubscription · rdp · restConsumer · queueBinding&#xa;&#xa;Provisioning sequence (per call from main-orchestrator):&#xa;① create clientProfile    ② create aclProfile&#xa;③ create clientUsername   ④ create queue (per unique queue)&#xa;⑤ create queueSubscription (per queue × topic)&#xa;⑥ create restDeliveryPoint + restConsumer + queueBinding&#xa;All via Solace SEMP v2 API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="640" y="900" width="600" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="l-a-sol-cluster" value="4 — POST {action:create, subResource:queue, payload:{name, accessType, subscriptions[]}}" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;" parent="1" source="l-sol-ep" target="l-sol-cluster" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l-sol-export" value="&lt;b&gt;5. wf-solace-automation-export-clone&lt;/b&gt;&#xa;🌐 prod-52.eastus.logic.azure.com&#xa;&#xa;• GET full service config from Solace Cloud API&#xa;• PUT export JSON to Azure Blob Storage&#xa;OUT: {blobUrl, exportedAt}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="640" y="1160" width="600" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="l-a-sol-export" value="5 — POST {serviceId, exportConfig}" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;" parent="1" source="l-sol-cluster" target="l-sol-export" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l-sol-svc-mgmt" value="&lt;b&gt;wf-solace-automation-service-management&lt;/b&gt;&#xa;🌐 prod-83.eastus.logic.azure.com&#xa;Used for service CRUD ops via Solace Cloud API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="640" y="1320" width="290" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="l-sol-ep-mgmt" value="&lt;b&gt;wf-solace-automation-event-portal-management&lt;/b&gt;&#xa;🌐 prod-94.eastus.logic.azure.com&#xa;Used for EP CRUD ops (domains, schemas, events)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="950" y="1320" width="290" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="l-sol-dispatcher" value="&lt;b&gt;wf-solace-automation-main-dispatcher&lt;/b&gt;&#xa;🌐 prod-64.eastus.logic.azure.com&#xa;Routes {action, subResource} to correct sub-workflow&#xa;Used by main-orchestrator for DEV run dispatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="640" y="1420" width="290" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="l-sol-blob-trigger" value="&lt;b&gt;wf-solace-automation-blob-trigger&lt;/b&gt;&#xa;🌐 prod-37.eastus.logic.azure.com&#xa;Triggered by blob-upload, reads config from&#xa;blob and calls main-orchestrator for UAT/PROD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="950" y="1420" width="290" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="l-sol-blob-upload" value="&lt;b&gt;wf-solace-automation-blob-upload&lt;/b&gt;&#xa;🌐 prod-73.eastus.logic.azure.com&#xa;Receives config payload, writes to Azure Blob&#xa;then calls blob-trigger to start orchestration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="640" y="1530" width="290" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="l-col-c-bg" value="EXTERNAL SYSTEMS &amp; APIs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#e67e22;opacity=30;fontSize=13;fontStyle=1;verticalAlign=top;align=center;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="1330" y="80" width="620" height="1600" as="geometry"/>
                </mxCell>
                <mxCell id="l-api-cloud" value="&lt;b&gt;Solace Cloud API&lt;/b&gt;&#xa;https://api.solace.cloud/api/v0&#xa;&#xa;POST  /services                    (create)&#xa;GET   /services/{id}               (poll state)&#xa;GET   /services/{id}               (get SEMP creds)&#xa;&#xa;Auth: Bearer {SOLACE_API_TOKEN}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#e67e22;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="1360" y="330" width="560" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="l-a-svc-cloud" value="POST /services" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;" parent="1" source="l-sol-svc" target="l-api-cloud" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l-api-arm" value="&lt;b&gt;Azure ARM API&lt;/b&gt;&#xa;https://management.azure.com&#xa;&#xa;PATCH /subscriptions/{sub}/resourceGroups/{rg}&#xa;      /providers/Microsoft.Logic/workflows/{wf}&#xa;      ?api-version=2019-05-01&#xa;&#xa;Updates: SOLACE_SEMP_* parameters in Logic Apps&#xa;Auth: MSI / Bearer token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#e67e22;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="1360" y="510" width="560" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="l-a-cred-arm" value="PATCH workflow params" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;" parent="1" source="l-sol-cred" target="l-api-arm" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l-api-ep" value="&lt;b&gt;Solace Event Portal API&lt;/b&gt;&#xa;https://api.solace.cloud/api/v2/architecture&#xa;&#xa;POST /eventPortalApplicationDomains&#xa;POST /schemaObjects + /schemaVersions&#xa;POST /eventObjects + /eventVersions&#xa;POST /applicationObjects + /applicationVersions&#xa;POST /eventVersions/{id}/publishedEventVersions&#xa;&#xa;Auth: Bearer {SOLACE_API_TOKEN}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#e67e22;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="1360" y="700" width="560" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="l-a-ep-api" value="POST domain, schemas, events, apps" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;" parent="1" source="l-sol-ep" target="l-api-ep" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l-api-semp" value="&lt;b&gt;Solace SEMP v2 Config API&lt;/b&gt;&#xa;https://mr-connection-bv61r48nseq.messaging.solace.cloud&#xa;:943/SEMP/v2/config&#xa;&#xa;POST /msgVpns/{vpn}/clientProfiles&#xa;POST /msgVpns/{vpn}/aclProfiles&#xa;POST /msgVpns/{vpn}/aclProfiles/{acl}/publishTopicExceptions&#xa;POST /msgVpns/{vpn}/aclProfiles/{acl}/subscribeTopicExceptions&#xa;POST /msgVpns/{vpn}/clientUsernames&#xa;POST /msgVpns/{vpn}/queues&#xa;POST /msgVpns/{vpn}/queues/{q}/subscriptions&#xa;POST /msgVpns/{vpn}/restDeliveryPoints&#xa;POST /msgVpns/{vpn}/restDeliveryPoints/{rdp}/restConsumers&#xa;POST /msgVpns/{vpn}/restDeliveryPoints/{rdp}/queueBindings&#xa;&#xa;Auth: Basic {SEMP_USERNAME}:{SEMP_PASSWORD}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#e67e22;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="1360" y="900" width="560" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="l-a-cluster-semp" value="POST queues + subscriptions + RDP" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;" parent="1" source="l-sol-cluster" target="l-api-semp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l-blob-export" value="&lt;b&gt;Azure Blob Storage (Export)&lt;/b&gt;&#xa;integrationpulsestore&#xa;/exports/{serviceId}-config.json" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="1390" y="1260" width="360" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="l-a-export-blob" value="PUT export JSON" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;" parent="1" source="l-sol-export" target="l-blob-export" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l-ref-bg" value="LOGIC APP REFERENCE (all deployed in ODL-IBM-2262033 / eastus)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;fontSize=12;fontStyle=1;verticalAlign=top;align=center;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="50" y="1680" width="2380" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="l-ref1" value="&lt;b&gt;3PL Pipeline&lt;/b&gt;&#xa;submission → prod-31&#xa;approve → prod-15&#xa;orchestrator → prod-29&#xa;status → prod-07" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c7d9f5;strokeColor=#2f75b5;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1740" width="220" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="l-ref2" value="&lt;b&gt;Solace Main&lt;/b&gt;&#xa;main-orchestrator → prod-46&#xa;main-dispatcher → prod-64&#xa;blob-trigger → prod-37&#xa;blob-upload → prod-73" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="300" y="1740" width="220" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="l-ref3" value="&lt;b&gt;Solace Provisioning&lt;/b&gt;&#xa;service-provisioning → prod-79&#xa;credentials-init → prod-86&#xa;event-portal-provisioning → prod-06&#xa;cluster-management → prod-26" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="540" y="1740" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="l-ref4" value="&lt;b&gt;Solace Management&lt;/b&gt;&#xa;service-management → prod-83&#xa;event-portal-management → prod-94&#xa;export-clone → prod-52" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="800" y="1740" width="220" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="l-ref5" value="&lt;b&gt;Blob Storage&lt;/b&gt;&#xa;Account: integrationpulsestore&#xa;Container: 3pl-onboarding&#xa;SAS expiry: 2027-12-31&#xa;Region: eastus" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="1040" y="1740" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="l-ref6" value="&lt;b&gt;Solace Service&lt;/b&gt;&#xa;Service ID: ruj2y805m8u&#xa;VPN: msgvpn-ruj2y805m8u&#xa;SEMP: mr-connection-bv61r48nseq&#xa;         .messaging.solace.cloud:943" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a9c4a0;strokeColor=#67ae5d;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="1740" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="l-ref7" value="&lt;b&gt;MuleSoft (TBD)&lt;/b&gt;&#xa;Compose stub in orchestrator&#xa;returns: not_configured&#xa;&#xa;&lt;b&gt;SAP BTP (TBD)&lt;/b&gt;&#xa;Compose stub in orchestrator&#xa;returns: not_configured" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontColor=#888888;fontSize=10;dashed=1;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="1540" y="1740" width="220" height="90" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
