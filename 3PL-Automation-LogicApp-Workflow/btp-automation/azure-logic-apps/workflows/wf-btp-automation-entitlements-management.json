{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "defaultEntitlementsServiceUrl": {
        "type": "String",
        "defaultValue": "https://entitlements-service.cfapps.eu10.hana.ondemand.com"
      }
    },
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "required": [
              "cisCredentials",
              "action"
            ],
            "properties": {
              "cisCredentials": {
                "type": "object",
                "properties": {
                  "tokenUrl": {
                    "type": "string"
                  },
                  "clientId": {
                    "type": "string"
                  },
                  "clientSecret": {
                    "type": "string"
                  }
                }
              },
              "btpConfig": {
                "type": "object",
                "properties": {
                  "subaccountGuid": {
                    "type": "string"
                  },
                  "entitlementsServiceUrl": {
                    "type": "string"
                  }
                }
              },
              "action": {
                "type": "string",
                "description": "list | assign | unassign | bulkAssign"
              },
              "payload": {
                "type": "object",
                "description": "list: {} | assign/unassign: {serviceName, planName} | bulkAssign: {assignments:[{serviceName, planName}]}"
              }
            }
          }
        }
      }
    },
    "actions": {
      "Get_CIS_Token": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{triggerBody()?['cisCredentials']?['tokenUrl']}",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "authentication": {
            "type": "Basic",
            "username": "@{triggerBody()?['cisCredentials']?['clientId']}",
            "password": "@{triggerBody()?['cisCredentials']?['clientSecret']}"
          },
          "body": "grant_type=client_credentials",
          "retryPolicy": {
            "type": "none"
          }
        },
        "runAfter": {}
      },
      "Set_EntitlementsBaseUrl": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "entitlementsBaseUrl",
              "type": "string",
              "value": "@{coalesce(triggerBody()?['btpConfig']?['entitlementsServiceUrl'], parameters('defaultEntitlementsServiceUrl'))}"
            }
          ]
        },
        "runAfter": {
          "Get_CIS_Token": [
            "Succeeded"
          ]
        }
      },
      "Initialize_BulkServicePlans": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "bulkServicePlans",
              "type": "array",
              "value": []
            }
          ]
        },
        "runAfter": {
          "Set_EntitlementsBaseUrl": [
            "Succeeded"
          ]
        }
      },
      "Switch_By_Action": {
        "type": "Switch",
        "expression": "@triggerBody()?['action']",
        "runAfter": {
          "Initialize_BulkServicePlans": [
            "Succeeded"
          ]
        },
        "cases": {
          "Case_List": {
            "case": "list",
            "actions": {
              "HTTP_List_Entitlements": {
                "type": "Http",
                "runAfter": {},
                "inputs": {
                  "method": "GET",
                  "uri": "@{variables('entitlementsBaseUrl')}/entitlements/v1/subaccountAssignments?subaccountGUID=@{triggerBody()?['btpConfig']?['subaccountGuid']}",
                  "headers": {
                    "Authorization": "Bearer @{body('Get_CIS_Token')?['access_token']}"
                  },
                  "retryPolicy": {
                    "type": "none"
                  }
                }
              },
              "Response_List": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": "@outputs('HTTP_List_Entitlements')['statusCode']",
                  "body": "@body('HTTP_List_Entitlements')"
                },
                "runAfter": {
                  "HTTP_List_Entitlements": [
                    "Succeeded",
                    "Failed"
                  ]
                }
              }
            }
          },
          "Case_Assign": {
            "case": "assign",
            "actions": {
              "HTTP_Assign_Entitlement": {
                "type": "Http",
                "runAfter": {},
                "inputs": {
                  "method": "PUT",
                  "uri": "@{variables('entitlementsBaseUrl')}/entitlements/v1/subaccountServicePlans",
                  "headers": {
                    "Authorization": "Bearer @{body('Get_CIS_Token')?['access_token']}",
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "servicePlans": [
                      {
                        "serviceName": "@{triggerBody()?['payload']?['serviceName']}",
                        "servicePlanName": "@{triggerBody()?['payload']?['planName']}",
                        "assignmentInfo": [
                          {
                            "subaccountGUID": "@{triggerBody()?['btpConfig']?['subaccountGuid']}",
                            "enable": true
                          }
                        ]
                      }
                    ]
                  },
                  "retryPolicy": {
                    "type": "none"
                  }
                }
              },
              "Response_Assign": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": "@outputs('HTTP_Assign_Entitlement')['statusCode']",
                  "body": "@body('HTTP_Assign_Entitlement')"
                },
                "runAfter": {
                  "HTTP_Assign_Entitlement": [
                    "Succeeded",
                    "Failed"
                  ]
                }
              }
            }
          },
          "Case_Unassign": {
            "case": "unassign",
            "actions": {
              "HTTP_Unassign_Entitlement": {
                "type": "Http",
                "runAfter": {},
                "inputs": {
                  "method": "PUT",
                  "uri": "@{variables('entitlementsBaseUrl')}/entitlements/v1/subaccountServicePlans",
                  "headers": {
                    "Authorization": "Bearer @{body('Get_CIS_Token')?['access_token']}",
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "servicePlans": [
                      {
                        "serviceName": "@{triggerBody()?['payload']?['serviceName']}",
                        "servicePlanName": "@{triggerBody()?['payload']?['planName']}",
                        "assignmentInfo": [
                          {
                            "subaccountGUID": "@{triggerBody()?['btpConfig']?['subaccountGuid']}",
                            "enable": false
                          }
                        ]
                      }
                    ]
                  },
                  "retryPolicy": {
                    "type": "none"
                  }
                }
              },
              "Response_Unassign": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": "@outputs('HTTP_Unassign_Entitlement')['statusCode']",
                  "body": {
                    "status": "unassigned",
                    "serviceName": "@triggerBody()?['payload']?['serviceName']",
                    "planName": "@triggerBody()?['payload']?['planName']"
                  }
                },
                "runAfter": {
                  "HTTP_Unassign_Entitlement": [
                    "Succeeded",
                    "Failed"
                  ]
                }
              }
            }
          },
          "Case_BulkAssign": {
            "case": "bulkAssign",
            "actions": {
              "Build_ServicePlans_Array": {
                "type": "Select",
                "inputs": {
                  "from": "@triggerBody()?['payload']?['assignments']",
                  "select": {
                    "serviceName": "@item()?['serviceName']",
                    "servicePlanName": "@item()?['planName']",
                    "assignmentInfo": [
                      {
                        "subaccountGUID": "@{triggerBody()?['btpConfig']?['subaccountGuid']}",
                        "enable": true
                      }
                    ]
                  }
                },
                "runAfter": {}
              },
              "HTTP_BulkAssign_Entitlements": {
                "type": "Http",
                "runAfter": {
                  "Build_ServicePlans_Array": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "method": "PUT",
                  "uri": "@{variables('entitlementsBaseUrl')}/entitlements/v1/subaccountServicePlans",
                  "headers": {
                    "Authorization": "Bearer @{body('Get_CIS_Token')?['access_token']}",
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "servicePlans": "@body('Build_ServicePlans_Array')"
                  },
                  "retryPolicy": {
                    "type": "none"
                  }
                }
              },
              "Response_BulkAssign": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": "@outputs('HTTP_BulkAssign_Entitlements')['statusCode']",
                  "body": {
                    "status": "success",
                    "message": "Bulk entitlement assignment completed",
                    "count": "@length(triggerBody()?['payload']?['assignments'])"
                  }
                },
                "runAfter": {
                  "HTTP_BulkAssign_Entitlements": [
                    "Succeeded",
                    "Failed"
                  ]
                }
              }
            }
          }
        },
        "default": {
          "actions": {
            "Response_Invalid_Action": {
              "type": "Response",
              "kind": "Http",
              "runAfter": {},
              "inputs": {
                "statusCode": 400,
                "body": {
                  "error": "Invalid action. Use: list | assign | unassign | bulkAssign",
                  "received": "@triggerBody()?['action']"
                }
              }
            }
          }
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}