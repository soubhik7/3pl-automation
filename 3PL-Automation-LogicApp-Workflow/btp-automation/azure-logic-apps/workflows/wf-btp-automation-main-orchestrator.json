{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "subaccountManagementUrl": {
        "type": "String",
        "defaultValue": "",
        "description": "HTTP trigger URL of subaccount-management workflow"
      },
      "entitlementsManagementUrl": {
        "type": "String",
        "defaultValue": "",
        "description": "HTTP trigger URL of entitlements-management workflow"
      },
      "provisioningManagementUrl": {
        "type": "String",
        "defaultValue": "",
        "description": "HTTP trigger URL of provisioning-management workflow"
      },
      "authorizationManagementUrl": {
        "type": "String",
        "defaultValue": "",
        "description": "HTTP trigger URL of authorization-management workflow"
      }
    },
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "required": [
              "cisCredentials",
              "config"
            ],
            "properties": {
              "cisCredentials": {
                "type": "object",
                "description": "CIS Central OAuth2 credentials for accounts/entitlements/provisioning",
                "properties": {
                  "tokenUrl": {
                    "type": "string"
                  },
                  "clientId": {
                    "type": "string"
                  },
                  "clientSecret": {
                    "type": "string"
                  }
                }
              },
              "xsuaaCredentials": {
                "type": "object",
                "description": "XSUAA OAuth2 credentials for authorization",
                "properties": {
                  "tokenUrl": {
                    "type": "string"
                  },
                  "clientId": {
                    "type": "string"
                  },
                  "clientSecret": {
                    "type": "string"
                  },
                  "baseUrl": {
                    "type": "string"
                  }
                }
              },
              "btpConfig": {
                "type": "object",
                "properties": {
                  "globalAccountGuid": {
                    "type": "string"
                  },
                  "globalAccountSubdomain": {
                    "type": "string"
                  },
                  "accountsServiceUrl": {
                    "type": "string"
                  },
                  "entitlementsServiceUrl": {
                    "type": "string"
                  },
                  "provisioningServiceUrl": {
                    "type": "string"
                  }
                }
              },
              "config": {
                "type": "object",
                "description": "Full BTP provisioning configuration",
                "properties": {
                  "subaccount": {
                    "type": "object",
                    "properties": {
                      "guid": {
                        "type": "string",
                        "description": "Leave empty to create new subaccount"
                      },
                      "displayName": {
                        "type": "string"
                      },
                      "subdomain": {
                        "type": "string"
                      },
                      "region": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      }
                    }
                  },
                  "entitlements": {
                    "type": "array",
                    "description": "List of service plans to assign",
                    "items": {
                      "type": "object",
                      "properties": {
                        "serviceName": {
                          "type": "string"
                        },
                        "planName": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "environment": {
                    "type": "object",
                    "description": "CF or Kyma environment to provision",
                    "properties": {
                      "type": {
                        "type": "string",
                        "description": "cloudfoundry | kyma"
                      },
                      "name": {
                        "type": "string"
                      },
                      "planName": {
                        "type": "string"
                      },
                      "serviceName": {
                        "type": "string"
                      },
                      "parameters": {
                        "type": "object"
                      }
                    }
                  },
                  "roleCollections": {
                    "type": "array",
                    "description": "Role collections to create and populate",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "roles": {
                          "type": "array"
                        },
                        "users": {
                          "type": "array"
                        }
                      }
                    }
                  }
                }
              },
              "skipEntitlements": {
                "type": "boolean",
                "default": false
              },
              "skipProvisioning": {
                "type": "boolean",
                "default": false
              },
              "skipAuthorization": {
                "type": "boolean",
                "default": false
              }
            }
          }
        }
      }
    },
    "actions": {
      "Initialize_subaccountGuid": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "subaccountGuid",
              "type": "string",
              "value": ""
            }
          ]
        },
        "runAfter": {}
      },
      "Initialize_environmentId": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "environmentId",
              "type": "string",
              "value": ""
            }
          ]
        },
        "runAfter": {
          "Initialize_subaccountGuid": [
            "Succeeded"
          ]
        }
      },
      "Initialize_cfApiUrl": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "cfApiUrl",
              "type": "string",
              "value": ""
            }
          ]
        },
        "runAfter": {
          "Initialize_environmentId": [
            "Succeeded"
          ]
        }
      },
      "Scope_Subaccount": {
        "type": "Scope",
        "actions": {
          "Check_Subaccount_Exists": {
            "type": "If",
            "expression": {
              "and": [
                {
                  "not": {
                    "equals": [
                      "@triggerBody()?['config']?['subaccount']?['guid']",
                      ""
                    ]
                  }
                }
              ]
            },
            "actions": {
              "Set_Existing_SubaccountGuid": {
                "type": "SetVariable",
                "inputs": {
                  "name": "subaccountGuid",
                  "value": "@triggerBody()?['config']?['subaccount']?['guid']"
                }
              }
            },
            "else": {
              "actions": {
                "Invoke_Create_Subaccount": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@parameters('subaccountManagementUrl')",
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "cisCredentials": "@triggerBody()?['cisCredentials']",
                      "btpConfig": "@triggerBody()?['btpConfig']",
                      "action": "create",
                      "subResource": "subaccount",
                      "payload": {
                        "displayName": "@triggerBody()?['config']?['subaccount']?['displayName']",
                        "subdomain": "@triggerBody()?['config']?['subaccount']?['subdomain']",
                        "region": "@triggerBody()?['config']?['subaccount']?['region']",
                        "description": "@coalesce(triggerBody()?['config']?['subaccount']?['description'], '')"
                      }
                    },
                    "retryPolicy": {
                      "type": "none"
                    }
                  },
                  "runAfter": {}
                },
                "Set_New_SubaccountGuid": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "subaccountGuid",
                    "value": "@body('Invoke_Create_Subaccount')?['guid']"
                  },
                  "runAfter": {
                    "Invoke_Create_Subaccount": [
                      "Succeeded"
                    ]
                  }
                }
              }
            }
          }
        },
        "runAfter": {
          "Initialize_cfApiUrl": [
            "Succeeded"
          ]
        }
      },
      "Scope_Entitlements": {
        "type": "Scope",
        "actions": {
          "Check_Skip_Entitlements": {
            "type": "If",
            "expression": {
              "and": [
                {
                  "equals": [
                    "@coalesce(triggerBody()?['skipEntitlements'], false)",
                    false
                  ]
                }
              ]
            },
            "actions": {
              "Invoke_Bulk_Assign_Entitlements": {
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "@parameters('entitlementsManagementUrl')",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "cisCredentials": "@triggerBody()?['cisCredentials']",
                    "btpConfig": {
                      "globalAccountGuid": "@triggerBody()?['btpConfig']?['globalAccountGuid']",
                      "subaccountGuid": "@variables('subaccountGuid')",
                      "entitlementsServiceUrl": "@coalesce(triggerBody()?['btpConfig']?['entitlementsServiceUrl'], 'https://entitlements-service.cfapps.eu10.hana.ondemand.com')"
                    },
                    "action": "bulkAssign",
                    "payload": {
                      "assignments": "@triggerBody()?['config']?['entitlements']"
                    }
                  },
                  "retryPolicy": {
                    "type": "none"
                  }
                },
                "runAfter": {}
              }
            }
          }
        },
        "runAfter": {
          "Scope_Subaccount": [
            "Succeeded"
          ]
        }
      },
      "Scope_Provisioning": {
        "type": "Scope",
        "actions": {
          "Check_Skip_Provisioning": {
            "type": "If",
            "expression": {
              "and": [
                {
                  "equals": [
                    "@coalesce(triggerBody()?['skipProvisioning'], false)",
                    false
                  ]
                }
              ]
            },
            "actions": {
              "Check_Environment_Config_Exists": {
                "type": "If",
                "expression": {
                  "and": [
                    {
                      "not": {
                        "equals": [
                          "@triggerBody()?['config']?['environment']?['name']",
                          null
                        ]
                      }
                    }
                  ]
                },
                "actions": {
                  "Invoke_Create_Environment": {
                    "type": "Http",
                    "inputs": {
                      "method": "POST",
                      "uri": "@parameters('provisioningManagementUrl')",
                      "headers": {
                        "Content-Type": "application/json"
                      },
                      "body": {
                        "cisCredentials": "@triggerBody()?['cisCredentials']",
                        "btpConfig": {
                          "subaccountGuid": "@variables('subaccountGuid')",
                          "provisioningServiceUrl": "@coalesce(triggerBody()?['btpConfig']?['provisioningServiceUrl'], 'https://provisioning-service.cfapps.eu10.hana.ondemand.com')"
                        },
                        "action": "create",
                        "payload": {
                          "environmentType": "@coalesce(triggerBody()?['config']?['environment']?['type'], 'cloudfoundry')",
                          "name": "@triggerBody()?['config']?['environment']?['name']",
                          "planName": "@coalesce(triggerBody()?['config']?['environment']?['planName'], 'standard')",
                          "serviceName": "@coalesce(triggerBody()?['config']?['environment']?['serviceName'], 'cloudfoundry')",
                          "parameters": "@coalesce(triggerBody()?['config']?['environment']?['parameters'], json('{}'))"
                        }
                      },
                      "retryPolicy": {
                        "type": "none"
                      }
                    },
                    "runAfter": {}
                  },
                  "Set_EnvironmentId": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "environmentId",
                      "value": "@body('Invoke_Create_Environment')?['environmentId']"
                    },
                    "runAfter": {
                      "Invoke_Create_Environment": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Set_CfApiUrl": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "cfApiUrl",
                      "value": "@coalesce(body('Invoke_Create_Environment')?['cfApiUrl'], '')"
                    },
                    "runAfter": {
                      "Set_EnvironmentId": [
                        "Succeeded"
                      ]
                    }
                  }
                },
                "runAfter": {}
              }
            }
          }
        },
        "runAfter": {
          "Scope_Entitlements": [
            "Succeeded"
          ]
        }
      },
      "Scope_Authorization": {
        "type": "Scope",
        "actions": {
          "Check_Skip_Authorization": {
            "type": "If",
            "expression": {
              "and": [
                {
                  "equals": [
                    "@coalesce(triggerBody()?['skipAuthorization'], false)",
                    false
                  ]
                }
              ]
            },
            "actions": {
              "For_Each_RoleCollection": {
                "type": "Foreach",
                "foreach": "@triggerBody()?['config']?['roleCollections']",
                "actions": {
                  "Invoke_Create_RoleCollection": {
                    "type": "Http",
                    "inputs": {
                      "method": "POST",
                      "uri": "@parameters('authorizationManagementUrl')",
                      "headers": {
                        "Content-Type": "application/json"
                      },
                      "body": {
                        "xsuaaCredentials": "@triggerBody()?['xsuaaCredentials']",
                        "btpConfig": {
                          "subaccountGuid": "@variables('subaccountGuid')",
                          "subaccountSubdomain": "@triggerBody()?['btpConfig']?['globalAccountSubdomain']"
                        },
                        "action": "create",
                        "subResource": "roleCollection",
                        "payload": {
                          "name": "@items('For_Each_RoleCollection')?['name']",
                          "description": "@coalesce(items('For_Each_RoleCollection')?['description'], '')"
                        }
                      },
                      "retryPolicy": {
                        "type": "none"
                      }
                    },
                    "runAfter": {}
                  },
                  "For_Each_Role_In_Collection": {
                    "type": "Foreach",
                    "foreach": "@items('For_Each_RoleCollection')?['roles']",
                    "actions": {
                      "Invoke_Add_Role": {
                        "type": "Http",
                        "inputs": {
                          "method": "POST",
                          "uri": "@parameters('authorizationManagementUrl')",
                          "headers": {
                            "Content-Type": "application/json"
                          },
                          "body": {
                            "xsuaaCredentials": "@triggerBody()?['xsuaaCredentials']",
                            "btpConfig": {
                              "subaccountGuid": "@variables('subaccountGuid')",
                              "subaccountSubdomain": "@triggerBody()?['btpConfig']?['globalAccountSubdomain']"
                            },
                            "action": "addRole",
                            "subResource": "roleCollection",
                            "payload": {
                              "collectionName": "@items('For_Each_RoleCollection')?['name']",
                              "roleName": "@items('For_Each_Role_In_Collection')?['roleName']",
                              "roleTemplateName": "@items('For_Each_Role_In_Collection')?['roleTemplateName']",
                              "appId": "@items('For_Each_Role_In_Collection')?['appId']"
                            }
                          },
                          "retryPolicy": {
                            "type": "none"
                          }
                        },
                        "runAfter": {}
                      }
                    },
                    "runAfter": {
                      "Invoke_Create_RoleCollection": [
                        "Succeeded"
                      ]
                    }
                  },
                  "For_Each_User_In_Collection": {
                    "type": "Foreach",
                    "foreach": "@items('For_Each_RoleCollection')?['users']",
                    "actions": {
                      "Invoke_Assign_User": {
                        "type": "Http",
                        "inputs": {
                          "method": "POST",
                          "uri": "@parameters('authorizationManagementUrl')",
                          "headers": {
                            "Content-Type": "application/json"
                          },
                          "body": {
                            "xsuaaCredentials": "@triggerBody()?['xsuaaCredentials']",
                            "btpConfig": {
                              "subaccountGuid": "@variables('subaccountGuid')",
                              "subaccountSubdomain": "@triggerBody()?['btpConfig']?['globalAccountSubdomain']"
                            },
                            "action": "assignUser",
                            "subResource": "user",
                            "payload": {
                              "collectionName": "@items('For_Each_RoleCollection')?['name']",
                              "userName": "@items('For_Each_User_In_Collection')",
                              "origin": "sap.default"
                            }
                          },
                          "retryPolicy": {
                            "type": "none"
                          }
                        },
                        "runAfter": {}
                      }
                    },
                    "runAfter": {
                      "For_Each_Role_In_Collection": [
                        "Succeeded"
                      ]
                    }
                  }
                },
                "runAfter": {}
              }
            }
          }
        },
        "runAfter": {
          "Scope_Provisioning": [
            "Succeeded"
          ]
        }
      },
      "Response_Success": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 200,
          "body": {
            "status": "success",
            "message": "BTP provisioning completed successfully",
            "subaccountGuid": "@variables('subaccountGuid')",
            "environmentId": "@variables('environmentId')",
            "cfApiUrl": "@variables('cfApiUrl')"
          }
        },
        "runAfter": {
          "Scope_Authorization": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}