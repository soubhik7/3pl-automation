{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "SOLACE_API_TOKEN": {
        "type": "SecureString"
      },
      "SOLACE_SERVICE_ID": {
        "type": "String"
      }
    },
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "properties": {
              "serviceId": {
                "type": "string",
                "description": "Solace serviceId to fetch creds for. Falls back to SOLACE_SERVICE_ID app setting if omitted."
              }
            }
          }
        }
      }
    },
    "actions": {
      "Resolve_ServiceId": {
        "type": "Compose",
        "inputs": "@coalesce(triggerBody()?['serviceId'], parameters('SOLACE_SERVICE_ID'))",
        "runAfter": {}
      },
      "Get_Service_Details": {
        "type": "Http",
        "inputs": {
          "method": "GET",
          "uri": "https://api.solace.cloud/api/v0/services/@{outputs('Resolve_ServiceId')}",
          "headers": {
            "Authorization": "Bearer @{parameters('SOLACE_API_TOKEN')}"
          },
          "retryPolicy": {
            "type": "none"
          }
        },
        "runAfter": {
          "Resolve_ServiceId": [
            "Succeeded"
          ]
        }
      },
      "Parse_Service_Response": {
        "type": "ParseJson",
        "inputs": {
          "content": "@body('Get_Service_Details')",
          "schema": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "serviceId": {
                    "type": "string"
                  },
                  "msgVpnName": {
                    "type": "string"
                  },
                  "serviceConnectionEndpoints": {
                    "type": "array"
                  },
                  "managementProtocols": {
                    "type": "array"
                  }
                }
              }
            }
          }
        },
        "runAfter": {
          "Get_Service_Details": [
            "Succeeded"
          ]
        }
      },
      "Compose_SEMP_Creds": {
        "type": "Compose",
        "inputs": {
          "serviceId": "@{outputs('Resolve_ServiceId')}",
          "vpnName": "@{body('Parse_Service_Response')?['data']?['msgVpnName']}",
          "brokerHost": "@{first(body('Parse_Service_Response')?['data']?['serviceConnectionEndpoints'])?['hostNames']?[0]}",
          "sempBaseUrl": "@{concat('https://', first(body('Parse_Service_Response')?['data']?['serviceConnectionEndpoints'])?['hostNames']?[0], ':', coalesce(first(body('Parse_Service_Response')?['data']?['serviceConnectionEndpoints'])?['ports']?['serviceManagementTlsListenPort'], 943), '/SEMP/v2/config')}",
          "sempUsername": "@{body('Parse_Service_Response')?['data']?['managementProtocols']?[0]?['username']}",
          "sempPassword": "@{body('Parse_Service_Response')?['data']?['managementProtocols']?[0]?['password']}"
        },
        "runAfter": {
          "Parse_Service_Response": [
            "Succeeded"
          ]
        }
      },
      "Response_Success": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 200,
          "body": {
            "status": "success",
            "message": "SEMP credentials fetched successfully",
            "serviceId": "@{outputs('Compose_SEMP_Creds')?['serviceId']}",
            "vpnName": "@{outputs('Compose_SEMP_Creds')?['vpnName']}",
            "sempBaseUrl": "@{outputs('Compose_SEMP_Creds')?['sempBaseUrl']}",
            "sempUsername": "@{outputs('Compose_SEMP_Creds')?['sempUsername']}",
            "sempPassword": "@{outputs('Compose_SEMP_Creds')?['sempPassword']}"
          }
        },
        "runAfter": {
          "Compose_SEMP_Creds": [
            "Succeeded"
          ]
        }
      },
      "Response_Failed": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 500,
          "body": {
            "status": "error",
            "message": "Failed to fetch service details or SEMP credentials",
            "serviceId": "@{outputs('Resolve_ServiceId')}"
          }
        },
        "runAfter": {
          "Compose_SEMP_Creds": [
            "Failed",
            "Skipped"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}