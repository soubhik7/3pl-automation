# SAP BTP Automation - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ── CIS Central credentials ────────────────────────────────────────────────────
# Obtained from: cf service-key cis-central-instance cis-central-key
# Look for "clientid" and "clientsecret" in the service key JSON
BTP_CIS_CLIENT_ID=sb-ut-<uuid>-clone!b<number>|cis-central!b<number>
BTP_CIS_CLIENT_SECRET=<uuid>$<base64-secret>

# ── XSUAA credentials ──────────────────────────────────────────────────────────
# Obtained from: cf service-key xsuaa-mcp-instance xsuaa-mcp-key
# Look for "clientid" and "clientsecret" in the service key JSON
BTP_XSUAA_CLIENT_ID=sb-<app-name>!t<number>
BTP_XSUAA_CLIENT_SECRET=<uuid>$<base64-secret>

# ── Cloud Foundry (optional, for cf CLI operations) ────────────────────────────
BTP_CF_USERNAME=your-email@example.com
BTP_CF_PASSWORD=your-cf-password
