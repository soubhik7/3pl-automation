{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workflowName": {
      "type": "string",
      "defaultValue": "btp-mail-trigger-workflow"
    },
    "teamsConnectionId": {
      "type": "string",
      "defaultValue": "/subscriptions/a556a28c-c14a-4657-b59f-e0c80f0bb54c/resourceGroups/ODL-IBM-2262033/providers/Microsoft.Web/connections/teams",
      "metadata": {
        "description": "Resource ID of the existing 'teams' API connection (already authenticated for the Standard deployment) — reused as-is, no new connection needed."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('workflowName')]",
      "location": "canadacentral",
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            }
          },
          "triggers": {
            "manual": {
              "type": "Request",
              "kind": "Http",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "from": { "type": "string" },
                    "subject": { "type": "string" },
                    "body": { "type": "string" }
                  },
                  "required": ["from", "subject", "body"]
                }
              }
            }
          },
          "actions": {
            "Response_Acknowledged": {
              "type": "Response",
              "kind": "Http",
              "inputs": {
                "statusCode": 202,
                "body": {
                  "status": "RECEIVED",
                  "platform": "btp",
                  "note": "Generation, Teams approval, and publish continue asynchronously in this run (Teams approval can take hours, far longer than an HTTP caller should wait). Poll the btp_requests Cosmos container for the record matching this request for final status."
                }
              },
              "runAfter": {}
            },
            "Generate_BTP_Config": {
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "https://ip-3pl-mcp.azurewebsites.net/api/btp-generate",
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "from": "@triggerBody()?['from']",
                  "subject": "@triggerBody()?['subject']",
                  "body": "@triggerBody()?['body']"
                }
              },
              "runAfter": {}
            },
            "Post_adaptive_card_and_wait_for_a_response": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['teams']['connectionId']"
                  }
                },
                "path": "/flowbot/actions/cardWithResponse/recipienttypes/channel",
                "body": {
                  "recipient": {
                    "groupId": "<TEAM_ID — fill in via the designer's Team/Channel picker>",
                    "channelId": "<CHANNEL_ID — fill in via the designer's Team/Channel picker>"
                  },
                  "messageBody": {
                    "type": "AdaptiveCard",
                    "version": "1.4",
                    "body": [
                      {
                        "type": "TextBlock",
                        "size": "Medium",
                        "weight": "Bolder",
                        "text": "BTP Onboarding - Approval Needed"
                      },
                      {
                        "type": "TextBlock",
                        "text": "@{body('Generate_BTP_Config')?['summaryForApproval']}",
                        "wrap": true
                      },
                      {
                        "type": "TextBlock",
                        "text": "btp_config.yaml",
                        "weight": "Bolder",
                        "size": "Small"
                      },
                      {
                        "type": "TextBlock",
                        "text": "@{body('Generate_BTP_Config')?['btpConfigYaml']}",
                        "wrap": true,
                        "fontType": "Monospace",
                        "size": "Small"
                      },
                      {
                        "type": "TextBlock",
                        "text": "manifest.yml",
                        "weight": "Bolder",
                        "size": "Small"
                      },
                      {
                        "type": "TextBlock",
                        "text": "@{coalesce(body('Generate_BTP_Config')?['manifestYaml'], 'N/A — no Cloud Foundry app deployment requested')}",
                        "wrap": true,
                        "fontType": "Monospace",
                        "size": "Small"
                      }
                    ],
                    "actions": [
                      {
                        "type": "Action.Submit",
                        "title": "Approve",
                        "data": {
                          "decision": "approve"
                        }
                      },
                      {
                        "type": "Action.Submit",
                        "title": "Reject",
                        "data": {
                          "decision": "reject"
                        }
                      }
                    ]
                  },
                  "shouldUpdateCard": true
                }
              },
              "runAfter": {
                "Generate_BTP_Config": [
                  "Succeeded"
                ]
              }
            },
            "Decision_check": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@coalesce(body('Post_adaptive_card_and_wait_for_a_response')?['data']?['decision'], '')",
                      "approve"
                    ]
                  }
                ]
              },
              "actions": {
                "Publish_to_GitHub": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "https://ip-3pl-mcp.azurewebsites.net/api/btp-publish",
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "id": "@body('Generate_BTP_Config')?['id']",
                      "btpConfigYaml": "@body('Generate_BTP_Config')?['btpConfigYaml']",
                      "manifestYaml": "@body('Generate_BTP_Config')?['manifestYaml']",
                      "branchName": "@body('Generate_BTP_Config')?['branchName']",
                      "filePaths": "@body('Generate_BTP_Config')?['filePaths']"
                    }
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Post_adaptive_card_and_wait_for_a_response": [
                  "Succeeded"
                ]
              }
            },
            "Compose_Final_Status": {
              "type": "Compose",
              "inputs": {
                "platform": "btp",
                "decision": "@coalesce(body('Post_adaptive_card_and_wait_for_a_response')?['data']?['decision'], 'none')",
                "publishResult": "@coalesce(body('Publish_to_GitHub'), json('null'))"
              },
              "runAfter": {
                "Decision_check": [
                  "Succeeded",
                  "Failed",
                  "Skipped"
                ]
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "teams": {
                "connectionId": "[parameters('teamsConnectionId')]",
                "connectionName": "teams",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/teams')]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "workflowResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', parameters('workflowName'))]"
    }
  }
}
