{
  "type": "AdaptiveCard",
  "version": "1.4",
  "body": [
    {
      "type": "TextBlock",
      "size": "Medium",
      "weight": "Bolder",
      "text": "Solace Request — Approval Needed"
    },
    {
      "type": "TextBlock",
      "text": "@{body('Generate_Solace_JSON')?['summaryForApproval']}",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "@{string(body('Generate_Solace_JSON')?['solaceJson'])}",
      "wrap": true,
      "fontType": "Monospace",
      "size": "Small"
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Approve",
      "data": { "decision": "approve" }
    },
    {
      "type": "Action.Submit",
      "title": "Reject",
      "data": { "decision": "reject" }
    }
  ]
}
