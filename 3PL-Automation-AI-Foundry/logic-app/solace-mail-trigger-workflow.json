{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "parameters": {},
        "triggers": {
            "manual": {
                "type": "Request",
                "kind": "Http",
                "inputs": {
                    "schema": {
                        "type": "object",
                        "properties": {
                            "from": {
                                "type": "string"
                            },
                            "subject": {
                                "type": "string"
                            },
                            "body": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "from",
                            "subject",
                            "body"
                        ]
                    }
                }
            }
        },
        "actions": {
            "Generate_Solace_JSON": {
                "type": "Http",
                "inputs": {
                    "uri": "https://ip-solace-mcp.azurewebsites.net/api/solace-generate",
                    "method": "POST",
                    "headers": {
                        "Content-Type": "application/json"
                    },
                    "body": {
                        "from": "@triggerBody()?['from']",
                        "subject": "@triggerBody()?['subject']",
                        "body": "@triggerBody()?['body']"
                    }
                },
                "runAfter": {}
            },
            "Build_Adaptive_Card": {
                "type": "Compose",
                "inputs": {
                    "type": "AdaptiveCard",
                    "version": "1.4",
                    "body": [
                        {
                            "type": "TextBlock",
                            "size": "Medium",
                            "weight": "Bolder",
                            "text": "Solace Request - Approval Needed"
                        },
                        {
                            "type": "TextBlock",
                            "text": "@{body('Generate_Solace_JSON')?['summaryForApproval']}",
                            "wrap": true
                        },
                        {
                            "type": "TextBlock",
                            "text": "@{string(body('Generate_Solace_JSON')?['solaceJson'])}",
                            "wrap": true,
                            "fontType": "Monospace",
                            "size": "Small"
                        }
                    ],
                    "actions": [
                        {
                            "type": "Action.Submit",
                            "title": "Approve",
                            "data": {
                                "decision": "approve"
                            }
                        },
                        {
                            "type": "Action.Submit",
                            "title": "Reject",
                            "data": {
                                "decision": "reject"
                            }
                        }
                    ]
                },
                "runAfter": {
                    "Generate_Solace_JSON": [
                        "Succeeded"
                    ]
                }
            },
            "Post_adaptive_card_and_wait_for_a_response": {
                "type": "ApiConnectionWebhook",
                "inputs": {
                    "host": {
                        "connection": {
                            "referenceName": "teams-1"
                        }
                    },
                    "body": {
                        "notificationUrl": "@listCallbackUrl()",
                        "body": {
                            "messageBody": "@{string(outputs('Build_Adaptive_Card'))}",
                            "updateMessage": "Thanks for your response!",
                            "recipient": {
                                "to": "odl_user_2262033@sandboxailabs1009.onmicrosoft.com"
                            }
                        }
                    },
                    "path": "/v1.0/teams/conversation/gatherinput/poster/Flow bot/location/@{encodeURIComponent('Chat with Flow bot')}/$subscriptions"
                },
                "runAfter": {
                    "Build_Adaptive_Card": [
                        "Succeeded"
                    ]
                }
            },
            "Decision_check": {
                "type": "If",
                "expression": {
                    "and": [
                        {
                            "equals": [
                                "@coalesce(body('Post_adaptive_card_and_wait_for_a_response')?['data']?['decision'], '')",
                                "approve"
                            ]
                        }
                    ]
                },
                "actions": {
                    "Publish_to_GitHub": {
                        "type": "Http",
                        "inputs": {
                            "uri": "https://ip-solace-mcp.azurewebsites.net/api/solace-publish",
                            "method": "POST",
                            "headers": {
                                "Content-Type": "application/json"
                            },
                            "body": {
                                "id": "@body('Generate_Solace_JSON')?['id']",
                                "solaceJson": "@body('Generate_Solace_JSON')?['solaceJson']",
                                "branchName": "@body('Generate_Solace_JSON')?['branchName']",
                                "filePath": "@body('Generate_Solace_JSON')?['filePath']"
                            }
                        }
                    }
                },
                "else": {
                    "actions": {}
                },
                "runAfter": {
                    "Post_adaptive_card_and_wait_for_a_response": [
                        "Succeeded"
                    ]
                }
            },
            "Response_Final_Status": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                    "statusCode": 200,
                    "body": {
                        "platform": "solace",
                        "decision": "@coalesce(body('Post_adaptive_card_and_wait_for_a_response')?['data']?['decision'], 'none')",
                        "publishResult": "@coalesce(body('Publish_to_GitHub'), json('null'))"
                    }
                },
                "runAfter": {
                    "Decision_check": [
                        "Succeeded",
                        "Failed",
                        "Skipped"
                    ]
                }
            }
        },
        "outputs": {}
    },
    "kind": "Stateful"
}