{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      }
    },
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "properties": {
              "from": { "type": "string" },
              "subject": { "type": "string" },
              "body": { "type": "string" }
            },
            "required": ["from", "subject", "body"]
          }
        }
      }
    },
    "actions": {
      "Generate_BTP_Config": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "https://ip-solace-mcp.azurewebsites.net/api/btp-generate",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "from": "@triggerBody()?['from']",
            "subject": "@triggerBody()?['subject']",
            "body": "@triggerBody()?['body']"
          }
        },
        "runAfter": {}
      },
      "Post_adaptive_card_and_wait_for_a_response": {
        "type": "ApiConnectionWebhook",
        "inputs": {
          "host": {
            "connection": {
              "name": "@parameters('$connections')['teams']['connectionId']"
            }
          },
          "path": "/flowbot/actions/cardWithResponse/recipienttypes/channel",
          "body": {
            "recipient": {
              "groupId": "<TEAM_ID — fill in via the designer's Team/Channel picker>",
              "channelId": "<CHANNEL_ID — fill in via the designer's Team/Channel picker>"
            },
            "messageBody": {
              "type": "AdaptiveCard",
              "version": "1.4",
              "body": [
                {
                  "type": "TextBlock",
                  "size": "Medium",
                  "weight": "Bolder",
                  "text": "BTP Onboarding - Approval Needed"
                },
                {
                  "type": "TextBlock",
                  "text": "@{body('Generate_BTP_Config')?['summaryForApproval']}",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "btp_config.yaml",
                  "weight": "Bolder",
                  "size": "Small"
                },
                {
                  "type": "TextBlock",
                  "text": "@{body('Generate_BTP_Config')?['btpConfigYaml']}",
                  "wrap": true,
                  "fontType": "Monospace",
                  "size": "Small"
                },
                {
                  "type": "TextBlock",
                  "text": "manifest.yml",
                  "weight": "Bolder",
                  "size": "Small"
                },
                {
                  "type": "TextBlock",
                  "text": "@{coalesce(body('Generate_BTP_Config')?['manifestYaml'], 'N/A — no Cloud Foundry app deployment requested')}",
                  "wrap": true,
                  "fontType": "Monospace",
                  "size": "Small"
                }
              ],
              "actions": [
                {
                  "type": "Action.Submit",
                  "title": "Approve",
                  "data": {
                    "decision": "approve"
                  }
                },
                {
                  "type": "Action.Submit",
                  "title": "Reject",
                  "data": {
                    "decision": "reject"
                  }
                }
              ]
            },
            "shouldUpdateCard": true
          }
        },
        "runAfter": {
          "Generate_BTP_Config": [
            "Succeeded"
          ]
        }
      },
      "Decision_check": {
        "type": "If",
        "expression": {
          "and": [
            {
              "equals": [
                "@coalesce(body('Post_adaptive_card_and_wait_for_a_response')?['data']?['decision'], '')",
                "approve"
              ]
            }
          ]
        },
        "actions": {
          "Publish_to_GitHub": {
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "https://ip-solace-mcp.azurewebsites.net/api/btp-publish",
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "id": "@body('Generate_BTP_Config')?['id']",
                "btpConfigYaml": "@body('Generate_BTP_Config')?['btpConfigYaml']",
                "manifestYaml": "@body('Generate_BTP_Config')?['manifestYaml']",
                "branchName": "@body('Generate_BTP_Config')?['branchName']",
                "filePaths": "@body('Generate_BTP_Config')?['filePaths']"
              }
            },
            "runAfter": {}
          }
        },
        "else": {
          "actions": {}
        },
        "runAfter": {
          "Post_adaptive_card_and_wait_for_a_response": [
            "Succeeded"
          ]
        }
      },
      "Response_Final_Status": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 200,
          "body": {
            "platform": "btp",
            "decision": "@coalesce(body('Post_adaptive_card_and_wait_for_a_response')?['data']?['decision'], 'none')",
            "publishResult": "@coalesce(body('Publish_to_GitHub'), json('null'))"
          }
        },
        "runAfter": {
          "Decision_check": [
            "Succeeded",
            "Failed",
            "Skipped"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
