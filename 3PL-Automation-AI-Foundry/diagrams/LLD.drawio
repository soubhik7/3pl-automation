<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram name="LLD - 3PL Publisher (common pattern, all 3 platforms)" id="lld-3pl-publisher">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="L1" value="Caller&#10;(any HTTP client)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="LL1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="139" y="110" width="2" height="1790" as="geometry"/></mxCell>
        <mxCell id="L2" value="Logic App (Standard)&#10;3pl-onboarding-orchestrator-workflow&#10;(main orchestrator)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="60" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="LL2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="379" y="110" width="2" height="1790" as="geometry"/></mxCell>
        <mxCell id="L3" value="Logic App (Standard)&#10;{platform}-mail-trigger-workflow&#10;(solace / mulesoft / btp — sub-workflow)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="60" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="LL3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="619" y="110" width="2" height="1790" as="geometry"/></mxCell>
        <mxCell id="L4" value="Microsoft Teams&#10;(Adaptive Card)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="60" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="LL4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="859" y="110" width="2" height="1790" as="geometry"/></mxCell>
        <mxCell id="L5" value="ip-3pl-mcp&#10;(Function App, shared)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="60" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="LL5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1099" y="110" width="2" height="1790" as="geometry"/></mxCell>
        <mxCell id="L6" value="integration-pulse-&#10;{platform}-publisher (Foundry)&#10;(solace / mulesoft / btp)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1240" y="60" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="LL6" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1339" y="110" width="2" height="1790" as="geometry"/></mxCell>
        <mxCell id="L7" value="GitHub REST API&#10;soubhik7/3pl-automation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1480" y="60" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="LL7" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1579" y="110" width="2" height="1790" as="geometry"/></mxCell>
        <mxCell id="L8" value="Cosmos DB&#10;{platform}_requests" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1720" y="60" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="LL8" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1819" y="110" width="2" height="1790" as="geometry"/></mxCell>

        <mxCell id="TXT1" value="PHASE 0 — DISPATCH (master fan-out, fire-and-acknowledge)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="700" height="24" as="geometry"/></mxCell>
        <mxCell id="A1" value="POST (trigger &#x27;manual&#x27;)  body: {from, subject, body, platforms[]}" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="180" as="sourcePoint"/><mxPoint x="380" y="180" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A2" value="202 {status:&#x27;DISPATCHED&#x27;, platforms} — returned immediately; does NOT wait for any child workflow to finish" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="230" as="sourcePoint"/><mxPoint x="140" y="230" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A3" value="Workflow action: invoke up to 3 child workflows in parallel (native, same app) — one per platform in platforms[]: solace-mail-trigger-workflow / mulesoft-mail-trigger-workflow / btp-mail-trigger-workflow. This lane represents whichever one(s) ran — body: {from, subject, body}" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="280" as="sourcePoint"/><mxPoint x="620" y="280" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="TXT2" value="PHASE 1 — GENERATE (common to all 3 platforms; payload shape differs — see comparison below)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="900" height="24" as="geometry"/></mxCell>
        <mxCell id="A4" value="POST /api/{platform}-generate  body: {from, subject, body}" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="380" as="sourcePoint"/><mxPoint x="1100" y="380" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A5" value="responses.create(agent_reference={platform}-generate-workflow)&#10;input: {phase:&#x27;generate&#x27;, emailFrom, emailSubject, emailBody}" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="430" as="sourcePoint"/><mxPoint x="1340" y="430" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A6" value="text reply: {&lt;platform-specific config&gt;, branchName, &lt;filePath(s)&gt;, summaryForApproval}&#10;(no tool calls — pure generation, credentials pre-masked)" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="486" as="sourcePoint"/><mxPoint x="1100" y="486" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="CMP1" value="Where the 3 platforms differ (Phase 1 output):&#10;Solace     -&gt;  {solaceJson, filePath}                     — 1 file:  solace-automation/config/3pl/&lt;slug&gt;.json&#10;MuleSoft  -&gt;  {mulesoftYaml: app/dev/tst/prod.yaml, filePaths} — 4 files: mulesoft-automation/config/&lt;slug&gt;/*.yaml&#10;BTP         -&gt;  {btpConfigYaml, manifestYaml?, filePaths}     — 1-2 files: btp-automation/config/&lt;slug&gt;/btp_config.yaml (+ optional apps/&lt;slug&gt;/manifest.yml)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacing=8;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="535" width="1940" height="80" as="geometry"/></mxCell>
        <mxCell id="A7" value="save_{platform}_request({id, tenantId:&#x27;demo&#x27;, status:&#x27;GENERATED&#x27;, &lt;config&gt;, branchName, &lt;filePath(s)&gt;, ...})" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="650" as="sourcePoint"/><mxPoint x="1820" y="650" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A8" value="200  {id, &lt;config&gt;, branchName, &lt;filePath(s)&gt;, summaryForApproval}" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="700" as="sourcePoint"/><mxPoint x="620" y="700" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="TXT3" value="PHASE 2 — HUMAN APPROVAL via Adaptive Card (Logic App pauses for a response; common to all 3 platforms)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="900" height="24" as="geometry"/></mxCell>
        <mxCell id="A9" value="Post adaptive card and wait for a response&#10;card: summary + generated config, actions: Adaptive Card (Approve / Reject)" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="800" as="sourcePoint"/><mxPoint x="860" y="800" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A10" value="Action.Submit data: {decision: &#x27;approve&#x27; | &#x27;reject&#x27;}  (the Approve / Reject button click)" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="856" as="sourcePoint"/><mxPoint x="620" y="856" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="BOX1" value="Decision_check:  decision == &#x27;approve&#x27; ?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="560" y="906" width="200" height="34" as="geometry"/></mxCell>

        <mxCell id="BOX2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="500" y="956" width="1200" height="822" as="geometry"/></mxCell>
        <mxCell id="TXT4" value="PHASE 3a — APPROVE branch (Decision_check = true; common to all 3 platforms)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="956" width="700" height="24" as="geometry"/></mxCell>
        <mxCell id="A11" value="POST /api/{platform}-publish  body: {id, &lt;config&gt;, branchName, &lt;filePath(s)&gt;}" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="996" as="sourcePoint"/><mxPoint x="1100" y="996" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A12" value="responses.create(agent_reference={platform}-publish-workflow)&#10;input: {phase:&#x27;publish&#x27;, &lt;config&gt;, branchName, &lt;filePath(s)&gt;}  (verbatim, never re-derived)" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="1046" as="sourcePoint"/><mxPoint x="1340" y="1046" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A13" value="MCP tool_call: github_create_branch({branchName})" style="html=1;fontSize=10;strokeColor=#d79b00;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="1102" as="sourcePoint"/><mxPoint x="1100" y="1102" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A14" value="GET /git/ref/heads/main -&gt; sha&#10;POST /git/refs  {ref:&#x27;refs/heads/&lt;branchName&gt;&#x27;, sha}" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="1148" as="sourcePoint"/><mxPoint x="1580" y="1148" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A15" value="201 (or 422 &#x27;already exists&#x27; -&gt; treated as OK)" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1580" y="1204" as="sourcePoint"/><mxPoint x="1100" y="1204" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A16" value="MCP tool_call: github_commit_file({branchName, path, content, message})  — looped once per file" style="html=1;fontSize=10;strokeColor=#d79b00;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="1250" as="sourcePoint"/><mxPoint x="1100" y="1250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="CMP2" value="Where the 3 platforms differ (Phase 3a commit loop):&#10;Solace     -&gt;  1 call   (the JSON file)&#10;MuleSoft  -&gt;  4 calls  (app.yaml, dev.yaml, tst.yaml, prod.yaml)&#10;BTP         -&gt;  1-2 calls (btp_config.yaml, optionally manifest.yml)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacing=8;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="540" y="1296" width="1120" height="70" as="geometry"/></mxCell>
        <mxCell id="A17" value="GET /contents/{path}?ref=&lt;branchName&gt; -&gt; sha (if exists)&#10;PUT /contents/{path}  {message, content: base64(...), branch, sha?}  — repeated per file" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="1392" as="sourcePoint"/><mxPoint x="1580" y="1392" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A18" value="200/201  {commit.html_url, content.html_url}  — once per file" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1580" y="1448" as="sourcePoint"/><mxPoint x="1100" y="1448" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A19" value="MCP tool_call: github_open_pull_request({headBranch, baseBranch:&#x27;main&#x27;, title, body})" style="html=1;fontSize=10;strokeColor=#d79b00;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="1494" as="sourcePoint"/><mxPoint x="1100" y="1494" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A20" value="POST /repos/{owner}/{repo}/pulls  {title, body, head, base}" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="1540" as="sourcePoint"/><mxPoint x="1580" y="1540" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A21" value="201 {html_url, number} (or 422 &#x27;already exists&#x27; -&gt; treated as OK)" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1580" y="1586" as="sourcePoint"/><mxPoint x="1100" y="1586" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A22" value="text reply: {status:&#x27;PUBLISHED&#x27;, branch, commitUrl(s), prUrl}" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="1632" as="sourcePoint"/><mxPoint x="1100" y="1632" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A23" value="update_{platform}_request_status({id, status:&#x27;PUBLISHED&#x27;, githubBranch, githubCommitUrl(s), githubPrUrl})" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="1678" as="sourcePoint"/><mxPoint x="1820" y="1678" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A24" value="200  {status:&#x27;PUBLISHED&#x27;, branch, commitUrl(s), prUrl}" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="1724" as="sourcePoint"/><mxPoint x="620" y="1724" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="TXT5" value="PHASE 3b — REJECT branch (Decision_check = false; common to all 3 platforms)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="1838" width="700" height="24" as="geometry"/></mxCell>
        <mxCell id="BOX3" value="else: no action — run ends.&#10;(Cosmos record stays &#x27;GENERATED&#x27;; nothing pushed to GitHub.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="560" y="1878" width="200" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
