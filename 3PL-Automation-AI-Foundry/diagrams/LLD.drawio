        <mxCell id="leg_r1_desc" value="POST (trigger &#39;manual&#39;) body: {from, subject, body, platforms[]}" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="70" y="2120" width="860" height="34" as="geometry"/></mxCell>
