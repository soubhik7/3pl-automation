        <mxCell id="leg_r5_desc" value="responses.create(agent_reference={platform}-generate-workflow) input: {phase:&#39;generate&#39;, emailFrom, emailSubject, emailBody}" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="70" y="2256" width="860" height="34" as="geometry"/></mxCell>
