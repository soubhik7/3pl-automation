        <mxCell id="A14" value="GET /git/ref/heads/main -&gt; sha&#10;POST /git/refs  {ref:&#x27;refs/heads/&lt;branchName&gt;&#x27;, sha}" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="1040" as="sourcePoint"/><mxPoint x="1580" y="1040" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A15" value="201 (or 422 &#x27;already exists&#x27; -&gt; treated as OK)" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1580" y="1096" as="sourcePoint"/><mxPoint x="1100" y="1096" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A16" value="MCP tool_call: github_commit_file({branchName, path, content, message})" style="html=1;fontSize=10;strokeColor=#d79b00;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="1142" as="sourcePoint"/><mxPoint x="1100" y="1142" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A17" value="GET /contents/{path}?ref=&lt;branchName&gt; -&gt; sha (if exists)&#10;PUT /contents/{path}  {message, content: base64(json), branch, sha?}" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="1188" as="sourcePoint"/><mxPoint x="1580" y="1188" as="targetPoint"/></mxGeometry></mxCell>
