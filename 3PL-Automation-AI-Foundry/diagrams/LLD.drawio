        <mxCell id="leg_h_desc_20" value="Step" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="70" y="2094" width="860" height="26" as="geometry"/></mxCell>
