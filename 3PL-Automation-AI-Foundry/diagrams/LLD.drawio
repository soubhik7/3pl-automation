        <mxCell id="leg_r6_desc" value="MCP tool_call: github_get_file({branchName, path}) &#8212; read-only, looped once per candidate file (1 Solace, up to 4 MuleSoft, up to 2 BTP)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="70" y="2290" width="860" height="34" as="geometry"/></mxCell>
