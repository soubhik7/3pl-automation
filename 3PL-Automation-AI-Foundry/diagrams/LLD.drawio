        <mxCell id="leg_r2_desc" value="202 {status:&#39;DISPATCHED&#39;, platforms} &#8212; returned immediately; does NOT wait for any child workflow to finish" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="70" y="2154" width="860" height="34" as="geometry"/></mxCell>
