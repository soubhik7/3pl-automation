        <mxCell id="TXT4" value="PHASE 3a — APPROVE branch (Decision_check = true)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="848" width="600" height="24" as="geometry"/></mxCell>
