        <mxCell id="leg_r7_desc" value="GET /repos/{owner}/{repo}/contents/{path}?ref=&lt;branchName&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="70" y="2324" width="860" height="34" as="geometry"/></mxCell>
