        <mxCell id="leg_r10_ref" value="10" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="20" y="2426" width="50" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r10_desc" value="save_{platform}_request({id, tenantId:&#39;demo&#39;, status:&#39;GENERATED&#39;, &lt;config&gt;, branchName, &lt;filePath(s)&gt;, ...})" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="70" y="2426" width="860" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r11_ref" value="11" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="20" y="2460" width="50" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r11_desc" value="200 {id, &lt;config&gt;, branchName, &lt;filePath(s)&gt;, summaryForApproval}" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="70" y="2460" width="860" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r12_ref" value="12" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="20" y="2494" width="50" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r12_desc" value="Post adaptive card and wait for a response &#8212; card: summary + generated config, actions: Approve / Reject" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="70" y="2494" width="860" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r13_ref" value="13" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="20" y="2528" width="50" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r13_desc" value="Action.Submit data: {decision: &#39;approve&#39; | &#39;reject&#39;} (the Approve / Reject button click)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="70" y="2528" width="860" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_title_980" value="Reference legend (LLD) &#8212; Phase 3a/3b" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="980" y="2070" width="910" height="24" as="geometry"/></mxCell>
        <mxCell id="leg_h_ref_980" value="Ref" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1"><mxGeometry x="980" y="2094" width="50" height="26" as="geometry"/></mxCell>
        <mxCell id="leg_h_desc_980" value="Step" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="1030" y="2094" width="860" height="26" as="geometry"/></mxCell>
        <mxCell id="leg_r14_ref" value="14" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="980" y="2120" width="50" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r14_desc" value="POST /api/{platform}-publish body: {id, &lt;config&gt;, branchName, &lt;filePath(s)&gt;}" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="1030" y="2120" width="860" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r15_ref" value="15" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="980" y="2154" width="50" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r15_desc" value="responses.create(agent_reference={platform}-publish-workflow) input: {phase:&#39;publish&#39;, &lt;config&gt;, branchName, &lt;filePath(s)&gt;} (verbatim, never re-derived)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="1030" y="2154" width="860" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r16_ref" value="16" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="980" y="2188" width="50" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r16_desc" value="No branch-creation step &#8212; branchName is already that platform&#39;s one persistent feature branch (created once, manually). First tool call commits straight to it. No github_get_file in Phase 2 either &#8212; it trusts the human-approved content as-is." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="1030" y="2188" width="860" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r17_ref" value="17" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="980" y="2222" width="50" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r17_desc" value="MCP tool_call: github_commit_file({branchName, path, content, message}) &#8212; looped once per file Phase 1 actually produced" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="1030" y="2222" width="860" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r18_ref" value="18" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="980" y="2256" width="50" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r18_desc" value="GET /contents/{path}?ref=&lt;branchName&gt; -&gt; sha (if exists); PUT /contents/{path} {message, content: base64(...), branch, sha?} &#8212; repeated per file. Auth: Bearer &lt;token&gt; &#8212; GITHUB_TOKEN PAT today (see diagrams/github-token-auth-flow.drawio for the full code-level lookup), GitHub App installation token as a coded-but-inactive fallback." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="1030" y="2256" width="860" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r19_ref" value="19" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="980" y="2290" width="50" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r19_desc" value="200/201 {commit.html_url, content.html_url} &#8212; once per file" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="1030" y="2290" width="860" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r20_ref" value="20" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="980" y="2324" width="50" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r20_desc" value="MCP tool_call: github_open_pull_request({headBranch, baseBranch:&#39;main&#39;, title, body})" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="1030" y="2324" width="860" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r21_ref" value="21" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="980" y="2358" width="50" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r21_desc" value="POST /repos/{owner}/{repo}/pulls {title, body, head, base}" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="1030" y="2358" width="860" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r22_ref" value="22" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="980" y="2392" width="50" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r22_desc" value="201 {html_url, number} (or 422 &#39;already exists&#39; -&gt; normal after the first request ever on this branch &#8212; treated as OK)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="1030" y="2392" width="860" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r23_ref" value="23" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="980" y="2426" width="50" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r23_desc" value="text reply: {status:&#39;PUBLISHED&#39;, branch, commitUrl(s), prUrl}" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="1030" y="2426" width="860" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r24_ref" value="24" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="980" y="2460" width="50" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r24_desc" value="update_{platform}_request_status({id, status:&#39;PUBLISHED&#39;, githubBranch, githubCommitUrl(s), githubPrUrl})" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="1030" y="2460" width="860" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r25_ref" value="25" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="980" y="2494" width="50" height="34" as="geometry"/></mxCell>
        <mxCell id="leg_r25_desc" value="200 {status:&#39;PUBLISHED&#39;, branch, commitUrl(s), prUrl}" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="1030" y="2494" width="860" height="34" as="geometry"/></mxCell>
