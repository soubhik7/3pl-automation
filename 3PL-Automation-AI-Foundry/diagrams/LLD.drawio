        <mxCell id="leg_r3_desc" value="HTTP POST to each child&#39;s own trigger callback URL, one per platform in platforms[] &#8212; body: {from, subject, body}. Child acks 202 within ~1s and keeps running (Consumption tier: no native cross-app workflow action)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;strokeColor=#666666;fillColor=#ffffff;spacingLeft=4;" parent="1" vertex="1"><mxGeometry x="70" y="2188" width="860" height="34" as="geometry"/></mxCell>
