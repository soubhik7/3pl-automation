        <mxCell id="A20" value="POST /repos/{owner}/{repo}/pulls  {title, body, head, base}" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="1336" as="sourcePoint"/><mxPoint x="1580" y="1336" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A21" value="201 {html_url, number} (or 422 &#x27;already exists&#x27; -&gt; treated as OK)" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1580" y="1382" as="sourcePoint"/><mxPoint x="1100" y="1382" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A22" value="text reply: {status:&#x27;PUBLISHED&#x27;, branch, commitUrl, prUrl}" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="1428" as="sourcePoint"/><mxPoint x="1100" y="1428" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A23" value="update_solace_request_status({id, status:&#x27;PUBLISHED&#x27;, githubBranch, githubCommitUrl, githubPrUrl})" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="1474" as="sourcePoint"/><mxPoint x="1820" y="1474" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="A24" value="200  {status:&#x27;PUBLISHED&#x27;, branch, commitUrl, prUrl}" style="html=1;fontSize=10;strokeColor=#000000;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="1520" as="sourcePoint"/><mxPoint x="620" y="1520" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="TXT5" value="PHASE 3b — REJECT branch (Decision_check = false)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="1630" width="600" height="24" as="geometry"/></mxCell>
        <mxCell id="BOX3" value="else: no action — run ends.&#10;(Cosmos record stays &#x27;GENERATED&#x27;; nothing pushed to GitHub.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="560" y="1670" width="200" height="34" as="geometry"/></mxCell>

        <mxCell id="BOX4" value="This is the Solace pipeline (JSON config, 1 file). See the &#x27;LLD - MuleSoft Publisher&#x27; and &#x27;LLD - BTP Publisher&#x27; tabs for the other 2 pipelines — same orchestrator, same Function App, same 3 GitHub MCP tools, different agent/routes/file count." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="1730" width="1980" height="50" as="geometry"/></mxCell>
