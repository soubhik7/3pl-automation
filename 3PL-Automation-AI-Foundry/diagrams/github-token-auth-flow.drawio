        <mxCell id="B5" value="Authorization: Bearer &lt;token&gt;&#10;attached to the outgoing GitHub REST API request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="650" width="540" height="60" as="geometry"/></mxCell>
