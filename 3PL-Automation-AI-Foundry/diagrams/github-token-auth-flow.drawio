        <mxCell id="B4B" value="Exchange the GitHub App's private key (Key Vault)&#10;for a short-lived installation token&#10;(coded fallback &#8212; currently inactive)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="520" width="400" height="80" as="geometry"/></mxCell>
