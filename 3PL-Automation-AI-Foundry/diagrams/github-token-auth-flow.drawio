        <mxCell id="B4A" value="Use the PAT as-is&#10;(GITHUB_TOKEN App Setting)&#10;&#171; LIVE PATH TODAY &#187;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="360" height="80" as="geometry"/></mxCell>
