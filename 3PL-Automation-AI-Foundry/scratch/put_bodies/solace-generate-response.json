{
  "id": "7f2a1c3e-4b5d-4e6f-8a9b-0c1d2e3f4a5b",
  "solaceJson": {
    "config": {
      "service": {
        "serviceId": "ruj2y805m8u",
        "name": "3pl-automation-dev",
        "datacenterId": "aks-australiaeast",
