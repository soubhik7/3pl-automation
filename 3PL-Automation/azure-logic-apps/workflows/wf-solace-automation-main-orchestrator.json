{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "serviceProvisioningUrl": {
        "type": "String",
        "defaultValue": "",
        "description": "HTTP trigger URL of the service-provisioning workflow"
      },
      "credentialsInitUrl": {
        "type": "String",
        "defaultValue": "",
        "description": "HTTP trigger URL of the credentials-init workflow \u2014 fetches SEMP creds and stores them in app settings"
      },
      "eventPortalUrl": {
        "type": "String",
        "defaultValue": "",
        "description": "HTTP trigger URL of the event-portal-provisioning workflow"
      },
      "clusterManagementUrl": {
        "type": "String",
        "defaultValue": "",
        "description": "HTTP trigger URL of the cluster-management workflow"
      }
    },
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "required": [
              "config"
            ],
            "properties": {
              "config": {
                "type": "object",
                "description": "Full Solace service configuration object",
                "properties": {
                  "service": {
                    "type": "object",
                    "properties": {
                      "serviceId": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "datacenterId": {
                        "type": "string"
                      },
                      "serviceTypeId": {
                        "type": "string"
                      },
                      "serviceClassId": {
                        "type": "string"
                      }
                    }
                  },
                  "eventPortal": {
                    "type": "object",
                    "properties": {
                      "domainName": {
                        "type": "string"
                      },
                      "domainDescription": {
                        "type": "string"
                      },
                      "schemas": {
                        "type": "array"
                      },
                      "events": {
                        "type": "array"
                      },
                      "applications": {
                        "type": "array"
                      }
                    }
                  },
                  "clusterManagement": {
                    "type": "object",
                    "properties": {
                      "clientProfiles": {
                        "type": "array"
                      },
                      "aclProfiles": {
                        "type": "array"
                      },
                      "clientUsernames": {
                        "type": "array"
                      },
                      "queues": {
                        "type": "array"
                      },
                      "restDeliveryPoints": {
                        "type": "array"
                      }
                    }
                  }
                }
              },
              "skipEventPortal": {
                "type": "boolean",
                "default": false
              },
              "skipCluster": {
                "type": "boolean",
                "default": false
              }
            }
          }
        }
      }
    },
    "actions": {
      "Initialize_serviceId": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "serviceId",
              "type": "string",
              "value": ""
            }
          ]
        },
        "runAfter": {}
      },
      "Initialize_domainId": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "domainId",
              "type": "string",
              "value": ""
            }
          ]
        },
        "runAfter": {
          "Initialize_serviceId": [
            "Succeeded"
          ]
        }
      },
      "Scope_Service_Provisioning": {
        "type": "Scope",
        "actions": {
          "Check_If_Service_Exists": {
            "type": "If",
            "expression": {
              "and": [
                {
                  "not": {
                    "equals": [
                      "@triggerBody()?['config']?['service']?['serviceId']",
                      ""
                    ]
                  }
                }
              ]
            },
            "actions": {
              "Set_Existing_ServiceId": {
                "type": "SetVariable",
                "inputs": {
                  "name": "serviceId",
                  "value": "@triggerBody()?['config']?['service']?['serviceId']"
                },
                "runAfter": {}
              },
              "Init_Creds_Existing": {
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "@parameters('credentialsInitUrl')",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "serviceId": "@triggerBody()?['config']?['service']?['serviceId']"
                  },
                  "retryPolicy": {
                    "type": "none"
                  }
                },
                "runAfter": {
                  "Set_Existing_ServiceId": [
                    "Succeeded"
                  ]
                }
              }
            },
            "else": {
              "actions": {
                "Invoke_Service_Provisioning": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@parameters('serviceProvisioningUrl')",
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "serviceName": "@triggerBody()?['config']?['service']?['name']",
                      "datacenterId": "@triggerBody()?['config']?['service']?['datacenterId']",
                      "serviceTypeId": "@triggerBody()?['config']?['service']?['serviceTypeId']",
                      "serviceClassId": "@triggerBody()?['config']?['service']?['serviceClassId']"
                    },
                    "retryPolicy": {
                      "type": "none"
                    }
                  },
                  "runAfter": {}
                },
                "Set_New_ServiceId": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "serviceId",
                    "value": "@body('Invoke_Service_Provisioning')?['serviceId']"
                  },
                  "runAfter": {
                    "Invoke_Service_Provisioning": [
                      "Succeeded"
                    ]
                  }
                },
                "Init_Creds_New": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@parameters('credentialsInitUrl')",
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "serviceId": "@body('Invoke_Service_Provisioning')?['serviceId']"
                    },
                    "retryPolicy": {
                      "type": "none"
                    }
                  },
                  "runAfter": {
                    "Set_New_ServiceId": [
                      "Succeeded"
                    ]
                  }
                }
              }
            }
          }
        },
        "runAfter": {
          "Initialize_domainId": [
            "Succeeded"
          ]
        }
      },
      "Scope_Event_Portal_Provisioning": {
        "type": "Scope",
        "actions": {
          "Check_Skip_EventPortal": {
            "type": "If",
            "expression": {
              "and": [
                {
                  "equals": [
                    "@coalesce(triggerBody()?['skipEventPortal'], false)",
                    false
                  ]
                }
              ]
            },
            "actions": {
              "Invoke_EventPortal_Provisioning": {
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "@parameters('eventPortalUrl')",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "eventPortalConfig": "@triggerBody()?['config']?['eventPortal']"
                  },
                  "retryPolicy": {
                    "type": "none"
                  }
                }
              },
              "Set_DomainId": {
                "type": "SetVariable",
                "inputs": {
                  "name": "domainId",
                  "value": "@body('Invoke_EventPortal_Provisioning')?['domainId']"
                },
                "runAfter": {
                  "Invoke_EventPortal_Provisioning": [
                    "Succeeded"
                  ]
                }
              }
            }
          }
        },
        "runAfter": {
          "Scope_Service_Provisioning": [
            "Succeeded"
          ]
        }
      },
      "Scope_Cluster_Provisioning": {
        "type": "Scope",
        "actions": {
          "Check_Skip_Cluster": {
            "type": "If",
            "expression": {
              "and": [
                {
                  "equals": [
                    "@coalesce(triggerBody()?['skipCluster'], false)",
                    false
                  ]
                }
              ]
            },
            "actions": {
              "Invoke_Cluster_Management": {
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "@parameters('clusterManagementUrl')",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "action": "provision",
                    "payload": {
                      "clusterConfig": "@triggerBody()?['config']?['clusterManagement']"
                    }
                  },
                  "retryPolicy": {
                    "type": "none"
                  }
                }
              }
            }
          }
        },
        "runAfter": {
          "Scope_Event_Portal_Provisioning": [
            "Succeeded"
          ]
        }
      },
      "Response_Success": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 200,
          "body": {
            "status": "success",
            "message": "Provisioning completed successfully",
            "serviceId": "@variables('serviceId')",
            "domainId": "@variables('domainId')"
          }
        },
        "runAfter": {
          "Scope_Cluster_Provisioning": [
            "Succeeded"
          ]
        }
      },
      "Response_Error": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 500,
          "body": {
            "status": "error",
            "message": "Provisioning failed \u2014 check Azure Logic Apps run history for details",
            "failedStep": "@{if(not(equals(actions('Scope_Service_Provisioning')?['status'], 'Succeeded')), 'service-provisioning', if(not(equals(actions('Scope_Event_Portal_Provisioning')?['status'], 'Succeeded')), 'event-portal-provisioning', 'cluster-provisioning'))}",
            "serviceId": "@variables('serviceId')",
            "domainId": "@variables('domainId')"
          }
        },
        "runAfter": {
          "Scope_Cluster_Provisioning": [
            "Failed",
            "TimedOut",
            "Skipped"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}