{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "orchestratorUrl": {
        "type": "String",
        "defaultValue": "",
        "description": "HTTP trigger URL of wf-3pl-onboarding-orchestrator"
      }
    },
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST",
          "schema": {
            "type": "object",
            "required": ["submissionId", "blobPath"],
            "properties": {
              "submissionId": { "type": "string" },
              "blobPath":     { "type": "string",  "description": "3pl-onboarding/pending/{submissionId}.json" },
              "statusPath":   { "type": "string",  "description": "3pl-onboarding/status/{submissionId}-status.json" },
              "approvedBy":   { "type": "string" }
            }
          }
        }
      }
    },
    "actions": {
      "Initialize_StatusPath": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "statusPath",
              "type": "string",
              "value": "@{coalesce(triggerBody()?['statusPath'], concat('3pl-onboarding/status/', triggerBody()?['submissionId'], '-status.json'))}"
            }
          ]
        },
        "runAfter": {}
      },
      "Read_Config_Blob": {
        "type": "Http",
        "inputs": {
          "method": "GET",
          "uri": "@{concat(appsetting('BLOB_STORAGE_URL'), '/', triggerBody()?['blobPath'], '?', appsetting('BLOB_SAS_TOKEN'))}"
        },
        "runAfter": {
          "Initialize_StatusPath": ["Succeeded"]
        }
      },
      "Parse_Config_Blob": {
        "type": "ParseJson",
        "inputs": {
          "content": "@body('Read_Config_Blob')",
          "schema": {
            "type": "object",
            "properties": {
              "submissionId":   { "type": "string" },
              "partnerID":      { "type": "string" },
              "partnerName":    { "type": "string" },
              "submittedAt":    { "type": "string" },
              "approvalStatus": { "type": "string" },
              "config":         { "type": "object" }
            }
          }
        },
        "runAfter": {
          "Read_Config_Blob": ["Succeeded"]
        }
      },
      "Write_Approved_Status_Blob": {
        "type": "Http",
        "inputs": {
          "method": "PUT",
          "uri": "@{concat(appsetting('BLOB_STORAGE_URL'), '/', variables('statusPath'), '?', appsetting('BLOB_SAS_TOKEN'))}",
          "headers": {
            "x-ms-blob-type": "BlockBlob",
            "Content-Type": "application/json"
          },
          "body": {
            "submissionId": "@{body('Parse_Config_Blob')?['submissionId']}",
            "partnerID":    "@{body('Parse_Config_Blob')?['partnerID']}",
            "partnerName":  "@{body('Parse_Config_Blob')?['partnerName']}",
            "submittedAt":  "@{body('Parse_Config_Blob')?['submittedAt']}",
            "approvedAt":   "@{utcNow()}",
            "approvedBy":   "@{coalesce(triggerBody()?['approvedBy'], 'Architect')}",
            "status":       "approved",
            "blobPath":     "@{triggerBody()?['blobPath']}",
            "services": {
              "solace":   { "status": "pending", "message": "Automation starting..." },
              "mulesoft": { "status": "not_configured", "message": "Future scope — not yet enabled" },
              "btp":      { "status": "not_configured", "message": "Future scope — not yet enabled" }
            }
          }
        },
        "runAfter": {
          "Parse_Config_Blob": ["Succeeded"]
        }
      },
      "Response_Accepted": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 200,
          "headers": { "Content-Type": "application/json" },
          "body": {
            "status":       "approved",
            "submissionId": "@{triggerBody()?['submissionId']}",
            "approvedAt":   "@{utcNow()}",
            "message":      "Approved. Automation pipeline starting."
          }
        },
        "runAfter": {
          "Write_Approved_Status_Blob": ["Succeeded"]
        }
      },
      "Trigger_Orchestrator_Async": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@parameters('orchestratorUrl')",
          "headers": { "Content-Type": "application/json" },
          "body": {
            "submissionId": "@{triggerBody()?['submissionId']}",
            "statusPath":   "@{variables('statusPath')}",
            "config":       "@body('Parse_Config_Blob')?['config']"
          },
          "retryPolicy": { "type": "none" }
        },
        "operationOptions": "DisableAsyncPattern",
        "runAfter": {
          "Response_Accepted": ["Succeeded"]
        }
      },
      "Response_Error": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 500,
          "headers": { "Content-Type": "application/json" },
          "body": {
            "status":  "error",
            "message": "Approval failed — unable to read submission or update status"
          }
        },
        "runAfter": {
          "Write_Approved_Status_Blob": ["Failed", "TimedOut", "Skipped"]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
