{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {},
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "properties": {
              "serviceId": {
                "type": "string",
                "description": "Solace serviceId to fetch creds for. Falls back to SOLACE_SERVICE_ID app setting if omitted."
              }
            }
          }
        }
      }
    },
    "actions": {
      "Resolve_ServiceId": {
        "type": "Compose",
        "inputs": "@coalesce(triggerBody()?['serviceId'], appsetting('SOLACE_SERVICE_ID'))",
        "runAfter": {}
      },
      "Get_Service_Details": {
        "type": "Http",
        "inputs": {
          "method": "GET",
          "uri": "https://api.solace.cloud/api/v0/services/@{outputs('Resolve_ServiceId')}",
          "headers": {
            "Authorization": "Bearer @{appsetting('SOLACE_API_TOKEN')}"
          }
        },
        "runAfter": {
          "Resolve_ServiceId": [
            "Succeeded"
          ]
        }
      },
      "Parse_Service_Response": {
        "type": "ParseJson",
        "inputs": {
          "content": "@body('Get_Service_Details')",
          "schema": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "serviceId": {
                    "type": "string"
                  },
                  "msgVpnName": {
                    "type": "string"
                  },
                  "serviceConnectionEndpoints": {
                    "type": "array"
                  },
                  "managementProtocols": {
                    "type": "array"
                  }
                }
              }
            }
          }
        },
        "runAfter": {
          "Get_Service_Details": [
            "Succeeded"
          ]
        }
      },
      "Compose_SEMP_Creds": {
        "type": "Compose",
        "inputs": {
          "serviceId": "@{outputs('Resolve_ServiceId')}",
          "vpnName": "@{body('Parse_Service_Response')?['data']?['msgVpnName']}",
          "brokerHost": "@{first(body('Parse_Service_Response')?['data']?['serviceConnectionEndpoints'])?['hostNames']?[0]}",
          "sempBaseUrl": "@{concat('https://', first(body('Parse_Service_Response')?['data']?['serviceConnectionEndpoints'])?['hostNames']?[0], ':', coalesce(first(body('Parse_Service_Response')?['data']?['serviceConnectionEndpoints'])?['ports']?['serviceManagementTlsListenPort'], 943), '/SEMP/v2/config')}",
          "sempUsername": "@{body('Parse_Service_Response')?['data']?['managementProtocols']?[0]?['username']}",
          "sempPassword": "@{body('Parse_Service_Response')?['data']?['managementProtocols']?[0]?['password']}"
        },
        "runAfter": {
          "Parse_Service_Response": [
            "Succeeded"
          ]
        }
      },
      "Get_Current_App_Settings": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "https://management.azure.com/subscriptions/@{appsetting('AZURE_SUBSCRIPTION_ID')}/resourceGroups/@{appsetting('AZURE_RESOURCE_GROUP')}/providers/Microsoft.Web/sites/@{appsetting('AZURE_LOGIC_APP_NAME')}/config/appsettings/list?api-version=2022-03-01",
          "authentication": {
            "type": "ManagedServiceIdentity"
          }
        },
        "runAfter": {
          "Compose_SEMP_Creds": [
            "Succeeded"
          ]
        }
      },
      "Compose_Merged_App_Settings": {
        "type": "Compose",
        "inputs": "@union(body('Get_Current_App_Settings')?['properties'], createObject('SOLACE_SERVICE_ID', outputs('Compose_SEMP_Creds')?['serviceId'], 'SOLACE_VPN_NAME', outputs('Compose_SEMP_Creds')?['vpnName'], 'SOLACE_SEMP_BASE_URL', outputs('Compose_SEMP_Creds')?['sempBaseUrl'], 'SOLACE_SEMP_USERNAME', outputs('Compose_SEMP_Creds')?['sempUsername'], 'SOLACE_SEMP_PASSWORD', outputs('Compose_SEMP_Creds')?['sempPassword']))",
        "runAfter": {
          "Get_Current_App_Settings": [
            "Succeeded"
          ]
        }
      },
      "Update_App_Settings": {
        "type": "Http",
        "inputs": {
          "method": "PUT",
          "uri": "https://management.azure.com/subscriptions/@{appsetting('AZURE_SUBSCRIPTION_ID')}/resourceGroups/@{appsetting('AZURE_RESOURCE_GROUP')}/providers/Microsoft.Web/sites/@{appsetting('AZURE_LOGIC_APP_NAME')}/config/appsettings?api-version=2022-03-01",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "properties": "@outputs('Compose_Merged_App_Settings')"
          },
          "authentication": {
            "type": "ManagedServiceIdentity"
          }
        },
        "runAfter": {
          "Compose_Merged_App_Settings": [
            "Succeeded"
          ]
        }
      },
      "Response_Success": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 200,
          "body": {
            "status": "success",
            "message": "App settings updated with SEMP credentials",
            "serviceId": "@{outputs('Compose_SEMP_Creds')?['serviceId']}",
            "vpnName": "@{outputs('Compose_SEMP_Creds')?['vpnName']}",
            "sempBaseUrl": "@{outputs('Compose_SEMP_Creds')?['sempBaseUrl']}"
          }
        },
        "runAfter": {
          "Update_App_Settings": [
            "Succeeded",
            "Failed"
          ]
        }
      },
      "Response_Failed": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 500,
          "body": {
            "status": "error",
            "message": "Failed to fetch service details or update app settings",
            "serviceId": "@{outputs('Resolve_ServiceId')}"
          }
        },
        "runAfter": {
          "Get_Service_Details": [
            "Failed"
          ],
          "Update_App_Settings": [
            "Failed"
          ],
          "Get_Current_App_Settings": [
            "Failed"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
