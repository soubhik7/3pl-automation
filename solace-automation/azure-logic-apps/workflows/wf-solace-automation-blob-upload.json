{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "blobTriggerUrl": {
        "type": "String",
        "defaultValue": "",
        "description": "HTTP trigger URL of wf-solace-automation-blob-trigger \u2014 called after the blob is written"
      }
    },
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "required": [
              "config"
            ],
            "properties": {
              "config": {
                "type": "object",
                "description": "Full Solace onboarding config generated by the 3PL Onboarding UI"
              }
            }
          }
        }
      }
    },
    "actions": {
      "Initialize_partnerID": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "partnerID",
              "type": "string",
              "value": "@{coalesce(triggerBody()?['config']?['partner']?['id'], triggerBody()?['config']?['_metadata']?['partnerID'], 'unknown')}"
            }
          ]
        },
        "runAfter": {}
      },
      "Initialize_timestamp": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "timestamp",
              "type": "string",
              "value": "@{formatDateTime(utcNow(), 'yyyyMMdd-HHmmss')}"
            }
          ]
        },
        "runAfter": {
          "Initialize_partnerID": [
            "Succeeded"
          ]
        }
      },
      "Initialize_blobName": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "blobName",
              "type": "string",
              "value": "@{concat('solace-onboarding/', variables('partnerID'), '/', variables('timestamp'), '-onboarding.json')}"
            }
          ]
        },
        "runAfter": {
          "Initialize_timestamp": [
            "Succeeded"
          ]
        }
      },
      "Build_stamped_config": {
        "type": "Compose",
        "inputs": "@setProperty(triggerBody()?['config'], '_uploadedAt', utcNow())",
        "runAfter": {
          "Initialize_blobName": [
            "Succeeded"
          ]
        }
      },
      "Write_Blob": {
        "type": "Http",
        "inputs": {
          "method": "PUT",
          "uri": "@{concat(appsetting('BLOB_STORAGE_URL'), '/', variables('blobName'), '?', appsetting('BLOB_SAS_TOKEN'))}",
          "headers": {
            "x-ms-blob-type": "BlockBlob",
            "Content-Type": "application/json"
          },
          "body": "@outputs('Build_stamped_config')",
          "retryPolicy": {
            "type": "none"
          }
        },
        "runAfter": {
          "Build_stamped_config": [
            "Succeeded"
          ]
        }
      },
      "Invoke_Blob_Trigger_Workflow": {
        "type": "Http",
        "operationOptions": "DisableAsyncPattern",
        "inputs": {
          "method": "POST",
          "uri": "@parameters('blobTriggerUrl')",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "blobName": "@variables('blobName')",
            "partnerID": "@variables('partnerID')",
            "config": "@outputs('Build_stamped_config')"
          },
          "retryPolicy": {
            "type": "none"
          }
        },
        "runAfter": {
          "Write_Blob": [
            "Succeeded"
          ]
        }
      },
      "Response_Accepted": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 202,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "status": "accepted",
            "message": "Config written to Azure Blob Storage. Automation pipeline started.",
            "blobPath": "@variables('blobName')",
            "partnerID": "@variables('partnerID')",
            "uploadedAt": "@utcNow()"
          }
        },
        "runAfter": {
          "Invoke_Blob_Trigger_Workflow": [
            "Succeeded",
            "Failed"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}