{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "actions": {
      "Initialize_Target_Branch": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "targetBranch",
              "type": "string",
              "value": "@coalesce(triggerBody()?['featureBranchName'], triggerBody()?['branch'], 'main')"
            }
          ]
        },
        "runAfter": {}
      },
      "Scope-Try": {
        "type": "Scope",
        "actions": {
          "Check_Branch_Exists": {
            "type": "InvokeFunction",
            "inputs": {
              "functionName": "CheckGitHubBranchExists",
              "parameters": {
                "repoOwner": "@coalesce(triggerBody()?['repoOwner'], '')",
                "repoName": "@coalesce(triggerBody()?['repoName'], '')",
                "branch": "@variables('targetBranch')"
              }
            }
          },
          "If_Feature_Branch_Missing": {
            "type": "If",
            "expression": {
              "or": [
                {
                  "equals": [
                    "@body('Check_Branch_Exists')?['exists']",
                    false
                  ]
                },
                {
                  "equals": [
                    "@empty(triggerBody()?['featureBranchName'])",
                    false
                  ]
                }
              ]
            },
            "actions": {
              "Request_Feature_Branch_Via_Teams": {
                "type": "Workflow",
                "inputs": {
                  "host": {
                    "workflow": {
                      "id": "request-feature-branch-via-teams"
                    }
                  },
                  "body": {
                    "title": "Solace Config Onboarding — Feature Branch Needed",
                    "subtitle": "Approval needed before the config pipeline can continue",
                    "requesterEmail": "@coalesce(triggerBody()?['requesterEmail'], '')",
                    "repoOwner": "@coalesce(triggerBody()?['repoOwner'], '')",
                    "repoName": "@coalesce(triggerBody()?['repoName'], '')",
                    "baseBranch": "@coalesce(triggerBody()?['baseBranch'], 'main')",
                    "suggestedBranchName": "@variables('targetBranch')",
                    "configPath": "@coalesce(triggerBody()?['filePath'], '')",
                    "summary": "@concat('Solace onboarding config for ', coalesce(triggerBody()?['repoOwner'], ''), '/', coalesce(triggerBody()?['repoName'], ''))",
                    "recipientEmail": "@coalesce(triggerBody()?['recipientEmail'], appsetting('SolaceDevOpsOwnerEmail'))"
                  }
                }
              },
              "If_Branch_Request_Rejected": {
                "type": "If",
                "expression": {
                  "equals": [
                    "@coalesce(body('Request_Feature_Branch_Via_Teams')?['decision'], '')",
                    "reject"
                  ]
                },
                "actions": {
                  "Response-Branch-Request-Rejected": {
                    "type": "Response",
                    "kind": "Http",
                    "inputs": {
                      "statusCode": 409,
                      "body": {
                        "status": "Feature branch request was rejected by the DevOps owner.",
                        "branch": "@variables('targetBranch')"
                      }
                    }
                  }
                },
                "else": {
                  "actions": {
                    "Update_Target_Branch_From_Response": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "targetBranch",
                        "value": "@body('Request_Feature_Branch_Via_Teams')?['branchName']"
                      }
                    },
                    "Ensure_Branch_Now_Exists": {
                      "type": "InvokeFunction",
                      "inputs": {
                        "functionName": "EnsureGitHubBranchExists",
                        "parameters": {
                          "repoOwner": "@coalesce(triggerBody()?['repoOwner'], '')",
                          "repoName": "@coalesce(triggerBody()?['repoName'], '')",
                          "branch": "@variables('targetBranch')"
                        }
                      },
                      "runAfter": {
                        "Update_Target_Branch_From_Response": [
                          "Succeeded"
                        ]
                      }
                    }
                  }
                },
                "runAfter": {
                  "Request_Feature_Branch_Via_Teams": [
                    "Succeeded"
                  ]
                }
              }
            },
            "else": {
              "actions": {}
            },
            "runAfter": {
              "Check_Branch_Exists": [
                "Succeeded"
              ]
            }
          },
          "Fetch_Existing_Solace_Config": {
            "type": "InvokeFunction",
            "inputs": {
              "functionName": "FetchExistingConfigFile",
              "parameters": {
                "repoOwner": "@coalesce(triggerBody()?['repoOwner'], '')",
                "repoName": "@coalesce(triggerBody()?['repoName'], '')",
                "branch": "@variables('targetBranch')",
                "filePath": "@coalesce(triggerBody()?['filePath'], '')"
              }
            },
            "runAfter": {
              "If_Feature_Branch_Missing": [
                "Succeeded"
              ]
            }
          },
          "Call_a_local_function-_Generate_Solace_Config": {
            "type": "InvokeFunction",
            "inputs": {
              "functionName": "GenerateSolaceConfig",
              "parameters": {
                "csvContent": "@triggerBody()?['csvContent']"
              }
            }
          },
          "Merge_Solace_Config": {
            "type": "InvokeFunction",
            "inputs": {
              "functionName": "MergeSolaceConfig",
              "parameters": {
                "newConfigJson": "@string(coalesce(body('Call_a_local_function-_Generate_Solace_Config')?['Results']?[0]?['SolaceConfig'], body('Call_a_local_function-_Generate_Solace_Config')?['results']?[0]?['solaceConfig']))",
                "existingConfigJson": "@coalesce(body('Fetch_Existing_Solace_Config')?['content'], '')"
              }
            },
            "runAfter": {
              "Fetch_Existing_Solace_Config": [
                "Succeeded"
              ],
              "Call_a_local_function-_Generate_Solace_Config": [
                "Succeeded"
              ]
            }
          },
          "Response-Success": {
            "type": "Response",
            "kind": "Http",
            "inputs": {
              "statusCode": 200,
              "body": {
                "generated": "@body('Call_a_local_function-_Generate_Solace_Config')",
                "mergedConfigJson": "@body('Merge_Solace_Config')?['mergedConfigJson']"
              }
            },
            "runAfter": {
              "Merge_Solace_Config": [
                "SUCCEEDED"
              ]
            }
          }
        },
        "runAfter": {
          "Initialize_Target_Branch": [
            "Succeeded"
          ]
        }
      },
      "Scope-Catch": {
        "type": "Scope",
        "actions": {
          "Response-Error": {
            "type": "Response",
            "kind": "Http",
            "inputs": {
              "statusCode": 500,
              "body": {
                "status": "solace-config-generation failed.",
                "details": "@result('Scope-Try')"
              }
            }
          }
        },
        "runAfter": {
          "Scope-Try": [
            "FAILED"
          ]
        }
      }
    },
    "triggers": {
      "When_a_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http"
      }
    },
    "contentVersion": "1.0.0.0",
    "outputs": {}
  },
  "kind": "stateful"
}