{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "actions": {
      "Initialize_Correlation_Id": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "correlationId",
              "type": "string",
              "value": "@coalesce(triggerBody()?['correlationId'], '')"
            }
          ]
        },
        "runAfter": {}
      },
      "Scope-Try": {
        "type": "Scope",
        "actions": {
          "Build_Adaptive_Card": {
            "type": "Compose",
            "inputs": {
              "type": "AdaptiveCard",
              "version": "1.4",
              "body": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "bleed": true,
                  "items": [
                    {
                      "type": "ColumnSet",
                      "columns": [
                        {
                          "type": "Column",
                          "width": "auto",
                          "verticalContentAlignment": "Center",
                          "items": [
                            {
                              "type": "TextBlock",
                              "text": "🟦",
                              "size": "ExtraLarge",
                              "spacing": "None"
                            }
                          ]
                        },
                        {
                          "type": "Column",
                          "width": "stretch",
                          "verticalContentAlignment": "Center",
                          "items": [
                            {
                              "type": "TextBlock",
                              "text": "@{coalesce(triggerBody()?['title'], 'Feature branch requested')}",
                              "size": "Large",
                              "weight": "Bolder",
                              "spacing": "None"
                            },
                            {
                              "type": "TextBlock",
                              "text": "@{coalesce(triggerBody()?['subtitle'], 'Approval needed')}",
                              "size": "Small",
                              "isSubtle": true,
                              "spacing": "None"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "Container",
                  "spacing": "Medium",
                  "items": [
                    {
                      "type": "FactSet",
                      "facts": [
                        {
                          "title": "Requester",
                          "value": "@{coalesce(triggerBody()?['requesterEmail'], 'n/a')}"
                        },
                        {
                          "title": "Repository",
                          "value": "@{coalesce(triggerBody()?['repoOwner'], '')}/@{coalesce(triggerBody()?['repoName'], '')}"
                        },
                        {
                          "title": "Suggested branch",
                          "value": "@{coalesce(triggerBody()?['suggestedBranchName'], '')}"
                        },
                        {
                          "title": "From base branch",
                          "value": "@{coalesce(triggerBody()?['baseBranch'], 'main')}"
                        },
                        {
                          "title": "Config path",
                          "value": "@{coalesce(triggerBody()?['configPath'], '')}"
                        }
                      ]
                    },
                    {
                      "type": "Input.Text",
                      "id": "branchName",
                      "label": "Feature branch to publish to",
                      "value": "@{coalesce(triggerBody()?['suggestedBranchName'], '')}",
                      "isRequired": true,
                      "errorMessage": "Enter the GitHub feature branch this config should be committed to."
                    }
                  ]
                },
                {
                  "type": "Container",
                  "spacing": "Medium",
                  "separator": true,
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "Summary",
                      "weight": "Bolder",
                      "size": "Small"
                    },
                    {
                      "type": "TextBlock",
                      "text": "@{coalesce(triggerBody()?['summary'], '')}",
                      "wrap": true,
                      "spacing": "Small"
                    }
                  ]
                }
              ],
              "actions": [
                {
                  "type": "Action.Submit",
                  "title": "✅ Approve",
                  "style": "positive",
                  "data": {
                    "decision": "approve"
                  }
                },
                {
                  "type": "Action.Submit",
                  "title": "❌ Reject",
                  "style": "destructive",
                  "associatedInputs": "none",
                  "data": {
                    "decision": "reject"
                  }
                }
              ]
            },
            "runAfter": {}
          },
          "Post_adaptive_card_and_wait_for_a_response": {
            "type": "ApiConnectionWebhook",
            "inputs": {
              "host": {
                "connection": {
                  "referenceName": "teams"
                }
              },
              "body": {
                "notificationUrl": "@listCallbackUrl()",
                "body": {
                  "messageBody": "@string(outputs('Build_Adaptive_Card'))",
                  "updateMessage": "Thanks for your response!",
                  "recipient": {
                    "to": "@triggerBody()?['recipientEmail']"
                  }
                }
              },
              "path": "/v1.0/teams/conversation/gatherinput/poster/Flow bot/location/@{encodeURIComponent('Chat with Flow bot')}/$subscriptions"
            },
            "runAfter": {
              "Build_Adaptive_Card": [
                "Succeeded"
              ]
            }
          },
          "Response-Success": {
            "type": "Response",
            "kind": "Http",
            "inputs": {
              "statusCode": 200,
              "body": {
                "decision": "@coalesce(body('Post_adaptive_card_and_wait_for_a_response')?['data']?['decision'], '')",
                "branchName": "@coalesce(body('Post_adaptive_card_and_wait_for_a_response')?['data']?['branchName'], triggerBody()?['suggestedBranchName'])",
                "correlationId": "@variables('correlationId')"
              }
            },
            "runAfter": {
              "Post_adaptive_card_and_wait_for_a_response": [
                "Succeeded"
              ]
            }
          }
        },
        "runAfter": {
          "Initialize_Correlation_Id": [
            "Succeeded"
          ]
        }
      },
      "Scope-Catch": {
        "type": "Scope",
        "actions": {
          "Response-Error": {
            "type": "Response",
            "kind": "Http",
            "inputs": {
              "statusCode": 500,
              "body": {
                "status": "request-feature-branch-via-teams failed.",
                "correlationId": "@variables('correlationId')",
                "details": "@result('Scope-Try')"
              }
            },
            "runAfter": {}
          }
        },
        "runAfter": {
          "Scope-Try": [
            "FAILED"
          ]
        }
      }
    },
    "triggers": {
      "When_a_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http"
      }
    },
    "contentVersion": "1.0.0.0",
    "outputs": {}
  },
  "kind": "stateful"
}