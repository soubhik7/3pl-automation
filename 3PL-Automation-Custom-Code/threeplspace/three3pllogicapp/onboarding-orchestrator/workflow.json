{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "actions": {
      "Initialize_Correlation_Id": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "correlationId",
              "type": "string",
              "value": "@coalesce(triggerBody()?['correlationId'], trigger().clientTrackingId)"
            }
          ]
        },
        "runAfter": {}
      },
      "Scope-Try": {
        "type": "Scope",
        "actions": {
          "Scope-BTP": {
            "type": "Scope",
            "actions": {
              "Invoke_BTP_Config_Publish": {
                "type": "Workflow",
                "inputs": {
                  "host": {
                    "workflow": {
                      "id": "btp-config-publish"
                    }
                  },
                  "body": {
                    "correlationId": "@variables('correlationId')",
                    "repoOwner": "@triggerBody()?['btp']?['repoOwner']",
                    "repoName": "@triggerBody()?['btp']?['repoName']",
                    "workflowFileName": "@triggerBody()?['btp']?['workflowFileName']",
                    "branchRef": "@triggerBody()?['btp']?['branchRef']",
                    "subAccount": "@triggerBody()?['btp']?['subAccount']",
                    "mode": "@triggerBody()?['btp']?['mode']",
                    "environment": "@triggerBody()?['btp']?['environment']",
                    "developerId": "@triggerBody()?['btp']?['developerId']",
                    "title": "@triggerBody()?['btp']?['title']",
                    "shortText": "@triggerBody()?['btp']?['shortText']",
                    "productName": "@triggerBody()?['btp']?['productName']"
                  }
                },
                "runAfter": {}
              }
            },
            "runAfter": {}
          },
          "Scope-MuleSoft": {
            "type": "Scope",
            "actions": {
              "Invoke_MuleSoft_Config_Generation": {
                "type": "Workflow",
                "inputs": {
                  "host": {
                    "workflow": {
                      "id": "mulesoft-config-generation"
                    }
                  },
                  "body": {
                    "correlationId": "@variables('correlationId')",
                    "csvContent": "@triggerBody()?['mulesoft']?['generate']?['csvContent']",
                    "updateExisting": "@triggerBody()?['mulesoft']?['generate']?['updateExisting']",
                    "existingAppYaml": "@triggerBody()?['mulesoft']?['generate']?['existingAppYaml']",
                    "existingDevYaml": "@triggerBody()?['mulesoft']?['generate']?['existingDevYaml']",
                    "existingTstYaml": "@triggerBody()?['mulesoft']?['generate']?['existingTstYaml']",
                    "existingProdYaml": "@triggerBody()?['mulesoft']?['generate']?['existingProdYaml']",
                    "repoOwner": "@triggerBody()?['mulesoft']?['generate']?['repoOwner']",
                    "repoName": "@triggerBody()?['mulesoft']?['generate']?['repoName']",
                    "branch": "@triggerBody()?['mulesoft']?['generate']?['branch']",
                    "filePathPrefix": "@triggerBody()?['mulesoft']?['generate']?['filePathPrefix']",
                    "featureBranchName": "@triggerBody()?['mulesoft']?['generate']?['featureBranchName']",
                    "baseBranch": "@triggerBody()?['mulesoft']?['generate']?['baseBranch']",
                    "requesterEmail": "@triggerBody()?['mulesoft']?['generate']?['requesterEmail']",
                    "recipientEmail": "@triggerBody()?['mulesoft']?['generate']?['recipientEmail']"
                  }
                },
                "runAfter": {}
              },
              "Invoke_MuleSoft_Config_Publish": {
                "type": "Workflow",
                "inputs": {
                  "host": {
                    "workflow": {
                      "id": "mulesoft-config-publish"
                    }
                  },
                  "body": {
                    "correlationId": "@variables('correlationId')",
                    "repoOwner": "@triggerBody()?['mulesoft']?['publish']?['repoOwner']",
                    "repoName": "@triggerBody()?['mulesoft']?['publish']?['repoName']",
                    "baseBranch": "@triggerBody()?['mulesoft']?['publish']?['baseBranch']",
                    "featureBranchName": "@triggerBody()?['mulesoft']?['publish']?['featureBranchName']",
                    "filePathPrefix": "@triggerBody()?['mulesoft']?['publish']?['filePathPrefix']",
                    "appYaml": "@coalesce(body('Invoke_MuleSoft_Config_Generation')?['app.yaml'], '')",
                    "devYaml": "@coalesce(body('Invoke_MuleSoft_Config_Generation')?['dev.yaml'], '')",
                    "tstYaml": "@coalesce(body('Invoke_MuleSoft_Config_Generation')?['tst.yaml'], '')",
                    "prodYaml": "@coalesce(body('Invoke_MuleSoft_Config_Generation')?['prod.yaml'], '')",
                    "commitMessage": "@triggerBody()?['mulesoft']?['publish']?['commitMessage']"
                  }
                },
                "runAfter": {
                  "Invoke_MuleSoft_Config_Generation": [
                    "Succeeded"
                  ]
                }
              }
            },
            "runAfter": {}
          },
          "Scope-Solace": {
            "type": "Scope",
            "actions": {
              "Invoke_Solace_Config_Generation": {
                "type": "Workflow",
                "inputs": {
                  "host": {
                    "workflow": {
                      "id": "solace-config-generation"
                    }
                  },
                  "body": {
                    "correlationId": "@variables('correlationId')",
                    "csvContent": "@triggerBody()?['solace']?['generate']?['csvContent']",
                    "repoOwner": "@triggerBody()?['solace']?['generate']?['repoOwner']",
                    "repoName": "@triggerBody()?['solace']?['generate']?['repoName']",
                    "branch": "@triggerBody()?['solace']?['generate']?['branch']",
                    "filePath": "@triggerBody()?['solace']?['generate']?['filePath']",
                    "featureBranchName": "@triggerBody()?['solace']?['generate']?['featureBranchName']",
                    "baseBranch": "@triggerBody()?['solace']?['generate']?['baseBranch']",
                    "requesterEmail": "@triggerBody()?['solace']?['generate']?['requesterEmail']",
                    "recipientEmail": "@triggerBody()?['solace']?['generate']?['recipientEmail']"
                  }
                },
                "runAfter": {}
              },
              "Invoke_Solace_Config_Publish": {
                "type": "Workflow",
                "inputs": {
                  "host": {
                    "workflow": {
                      "id": "solace-config-publish"
                    }
                  },
                  "body": {
                    "correlationId": "@variables('correlationId')",
                    "repoOwner": "@triggerBody()?['solace']?['publish']?['repoOwner']",
                    "repoName": "@triggerBody()?['solace']?['publish']?['repoName']",
                    "baseBranch": "@triggerBody()?['solace']?['publish']?['baseBranch']",
                    "featureBranchName": "@triggerBody()?['solace']?['publish']?['featureBranchName']",
                    "filePath": "@triggerBody()?['solace']?['publish']?['filePath']",
                    "solaceConfigJson": "@body('Invoke_Solace_Config_Generation')?['mergedConfigJson']",
                    "commitMessage": "@triggerBody()?['solace']?['publish']?['commitMessage']"
                  }
                },
                "runAfter": {
                  "Invoke_Solace_Config_Generation": [
                    "Succeeded"
                  ]
                }
              }
            },
            "runAfter": {}
          },
          "Response-Success": {
            "type": "Response",
            "kind": "Http",
            "inputs": {
              "statusCode": 200,
              "body": {
                "status": "All child workflows completed successfully.",
                "correlationId": "@variables('correlationId')",
                "btp": "@body('Invoke_BTP_Config_Publish')",
                "mulesoft": {
                  "generate": "@body('Invoke_MuleSoft_Config_Generation')",
                  "publish": "@body('Invoke_MuleSoft_Config_Publish')"
                },
                "solace": {
                  "generate": "@body('Invoke_Solace_Config_Generation')",
                  "publish": "@body('Invoke_Solace_Config_Publish')"
                }
              }
            },
            "runAfter": {
              "Scope-BTP": [
                "Succeeded"
              ],
              "Scope-MuleSoft": [
                "Succeeded"
              ],
              "Scope-Solace": [
                "Succeeded"
              ]
            }
          }
        },
        "runAfter": {
          "Initialize_Correlation_Id": [
            "Succeeded"
          ]
        }
      },
      "Scope-Catch": {
        "type": "Scope",
        "actions": {
          "Response-Error": {
            "type": "Response",
            "kind": "Http",
            "inputs": {
              "statusCode": 500,
              "body": {
                "status": "One or more child workflows failed during orchestration.",
                "correlationId": "@variables('correlationId')",
                "summary": "@result('Scope-Try')",
                "btpDetails": "@result('Scope-BTP')",
                "mulesoftDetails": "@result('Scope-MuleSoft')",
                "solaceDetails": "@result('Scope-Solace')"
              }
            }
          }
        },
        "runAfter": {
          "Scope-Try": [
            "FAILED"
          ]
        }
      }
    },
    "triggers": {
      "When_a_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http"
      }
    },
    "contentVersion": "1.0.0.0",
    "outputs": {}
  },
  "kind": "stateful"
}
