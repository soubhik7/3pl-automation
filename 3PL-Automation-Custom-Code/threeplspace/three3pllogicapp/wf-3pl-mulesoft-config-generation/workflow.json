{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "actions": {
      "Scope-Try": {
        "type": "Scope",
        "actions": {
          "Check_Branch_Exists": {
            "type": "InvokeFunction",
            "inputs": {
              "functionName": "CheckGitHubBranchExists",
              "parameters": {
                "repoOwner": "@coalesce(triggerBody()?['repoOwner'], '')",
                "repoName": "@coalesce(triggerBody()?['repoName'], '')",
                "branch": "@variables('targetBranch')",
                "correlationId": "@variables('correlationId')"
              }
            }
          },
          "If_Feature_Branch_Missing": {
            "type": "If",
            "expression": {
              "and": [
                {
                  "equals": [
                    "@body('Check_Branch_Exists')?['exists']",
                    false
                  ]
                }
              ]
            },
            "actions": {
              "Request_Branch_Approval_Via_Email": {
                "type": "Workflow",
                "inputs": {
                  "host": {
                    "workflow": {
                      "id": "request-branch-approval-via-email"
                    }
                  },
                  "body": {
                    "correlationId": "@variables('correlationId')",
                    "title": "MuleSoft Config Onboarding — Feature Branch Needed",
                    "subtitle": "Approval needed before the config pipeline can continue",
                    "requesterEmail": "@coalesce(triggerBody()?['requesterEmail'], '')",
                    "repoOwner": "@coalesce(triggerBody()?['repoOwner'], '')",
                    "repoName": "@coalesce(triggerBody()?['repoName'], '')",
                    "baseBranch": "@coalesce(triggerBody()?['baseBranch'], 'main')",
                    "suggestedBranchName": "@variables('targetBranch')",
                    "configPath": "@variables('normalizedFilePathPrefix')",
                    "summary": "@concat('MuleSoft NAV onboarding config for ', coalesce(triggerBody()?['repoOwner'], ''), '/', coalesce(triggerBody()?['repoName'], ''))",
                    "recipientEmail": "@coalesce(triggerBody()?['recipientEmail'], appsetting('MuleSoftDevOpsOwnerEmail'))",
                    "domain": "MuleSoft"
                  }
                },
                "runAfter": {}
              },
              "Response-Awaiting-Branch-Approval": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "status": "AwaitingBranchApproval",
                    "correlationId": "@variables('correlationId')",
                    "branch": "@variables('targetBranch')"
                  }
                },
                "runAfter": {
                  "Request_Branch_Approval_Via_Email": [
                    "Succeeded"
                  ]
                }
              }
            },
            "else": {
              "actions": {
                "Fetch_Existing_App_Yaml": {
                  "type": "InvokeFunction",
                  "inputs": {
                    "functionName": "FetchExistingConfigFile",
                    "parameters": {
                      "repoOwner": "@coalesce(triggerBody()?['repoOwner'], '')",
                      "repoName": "@coalesce(triggerBody()?['repoName'], '')",
                      "branch": "@variables('targetBranch')",
                      "filePath": "@if(empty(variables('normalizedFilePathPrefix')), '', concat(variables('normalizedFilePathPrefix'), 'app.yaml'))",
                      "correlationId": "@variables('correlationId')"
                    }
                  },
                  "runAfter": {}
                },
                "Fetch_Existing_Dev_Yaml": {
                  "type": "InvokeFunction",
                  "inputs": {
                    "functionName": "FetchExistingConfigFile",
                    "parameters": {
                      "repoOwner": "@coalesce(triggerBody()?['repoOwner'], '')",
                      "repoName": "@coalesce(triggerBody()?['repoName'], '')",
                      "branch": "@variables('targetBranch')",
                      "filePath": "@if(empty(variables('normalizedFilePathPrefix')), '', concat(variables('normalizedFilePathPrefix'), 'dev.yaml'))",
                      "correlationId": "@variables('correlationId')"
                    }
                  },
                  "runAfter": {}
                },
                "Fetch_Existing_Tst_Yaml": {
                  "type": "InvokeFunction",
                  "inputs": {
                    "functionName": "FetchExistingConfigFile",
                    "parameters": {
                      "repoOwner": "@coalesce(triggerBody()?['repoOwner'], '')",
                      "repoName": "@coalesce(triggerBody()?['repoName'], '')",
                      "branch": "@variables('targetBranch')",
                      "filePath": "@if(empty(variables('normalizedFilePathPrefix')), '', concat(variables('normalizedFilePathPrefix'), 'tst.yaml'))",
                      "correlationId": "@variables('correlationId')"
                    }
                  },
                  "runAfter": {}
                },
                "Fetch_Existing_Prod_Yaml": {
                  "type": "InvokeFunction",
                  "inputs": {
                    "functionName": "FetchExistingConfigFile",
                    "parameters": {
                      "repoOwner": "@coalesce(triggerBody()?['repoOwner'], '')",
                      "repoName": "@coalesce(triggerBody()?['repoName'], '')",
                      "branch": "@variables('targetBranch')",
                      "filePath": "@if(empty(variables('normalizedFilePathPrefix')), '', concat(variables('normalizedFilePathPrefix'), 'prod.yaml'))",
                      "correlationId": "@variables('correlationId')"
                    }
                  },
                  "runAfter": {}
                },
                "Call_a_local_function-Generate_MuleSoft_Config_YAML": {
                  "type": "InvokeFunction",
                  "inputs": {
                    "functionName": "GenerateMuleSoftConfig",
                    "parameters": {
                      "csvContent": "@triggerBody()?['csvContent']",
                      "updateExisting": "@coalesce(triggerBody()?['updateExisting'], false)",
                      "existingAppYaml": "@coalesce(triggerBody()?['existingAppYaml'], body('Fetch_Existing_App_Yaml')?['content'], '')",
                      "existingDevYaml": "@coalesce(triggerBody()?['existingDevYaml'], body('Fetch_Existing_Dev_Yaml')?['content'], '')",
                      "existingTstYaml": "@coalesce(triggerBody()?['existingTstYaml'], body('Fetch_Existing_Tst_Yaml')?['content'], '')",
                      "existingProdYaml": "@coalesce(triggerBody()?['existingProdYaml'], body('Fetch_Existing_Prod_Yaml')?['content'], '')",
                      "correlationId": "@variables('correlationId')"
                    }
                  },
                  "runAfter": {
                    "Fetch_Existing_App_Yaml": [
                      "Succeeded"
                    ],
                    "Fetch_Existing_Dev_Yaml": [
                      "Succeeded"
                    ],
                    "Fetch_Existing_Tst_Yaml": [
                      "Succeeded"
                    ],
                    "Fetch_Existing_Prod_Yaml": [
                      "Succeeded"
                    ]
                  }
                },
                "Response-Success": {
                  "type": "Response",
                  "kind": "Http",
                  "inputs": {
                    "statusCode": 200,
                    "body": "@union(body('Call_a_local_function-Generate_MuleSoft_Config_YAML'), json('{\"status\":\"Complete\"}'))"
                  },
                  "runAfter": {
                    "Call_a_local_function-Generate_MuleSoft_Config_YAML": [
                      "SUCCEEDED"
                    ]
                  }
                }
              }
            },
            "runAfter": {
              "Check_Branch_Exists": [
                "Succeeded"
              ]
            }
          }
        },
        "runAfter": {
          "Initialize_Target_Branch": [
            "Succeeded"
          ]
        }
      },
      "Scope-Catch": {
        "type": "Scope",
        "actions": {
          "Response-Error": {
            "type": "Response",
            "kind": "Http",
            "inputs": {
              "statusCode": 500,
              "body": {
                "status": "mulesoft-config-generation failed.",
                "correlationId": "@variables('correlationId')",
                "details": "@result('Scope-Try')"
              }
            }
          }
        },
        "runAfter": {
          "Scope-Try": [
            "FAILED"
          ]
        }
      },
      "Initialize_Target_Branch": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "normalizedFilePathPrefix",
              "type": "string",
              "value": "@if(or(empty(coalesce(triggerBody()?['filePathPrefix'], '')), endsWith(coalesce(triggerBody()?['filePathPrefix'], ''), '/')), coalesce(triggerBody()?['filePathPrefix'], ''), concat(coalesce(triggerBody()?['filePathPrefix'], ''), '/'))"
            },
            {
              "name": "targetBranch",
              "type": "string",
              "value": "@coalesce(triggerBody()?['featureBranchName'], triggerBody()?['branch'], 'main')"
            },
            {
              "name": "correlationId",
              "type": "string",
              "value": "@coalesce(triggerBody()?['correlationId'], '')"
            }
          ]
        },
        "runAfter": {}
      }
    },
    "triggers": {
      "When_a_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http"
      }
    },
    "contentVersion": "1.0.0.0",
    "outputs": {}
  },
  "kind": "stateful"
}
