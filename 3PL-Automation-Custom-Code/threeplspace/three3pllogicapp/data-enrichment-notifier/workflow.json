{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "actions": {
      "Scope-Try": {
        "type": "Scope",
        "actions": {
          "Scope-Btp": {
            "type": "Scope",
            "actions": {
              "Get_Btp_Pending_Rows": {
                "type": "ServiceProvider",
                "inputs": {
                  "parameters": {
                    "query": "SELECT TOP 20 * FROM [dbo].[BtpConfig] WHERE EnrichmentStatus = 'AwaitingInput' AND CardSentAt IS NULL"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "sql",
                    "operationId": "executeQuery",
                    "serviceProviderId": "/serviceProviders/sql"
                  },
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 3,
                    "interval": "PT5S",
                    "maximumInterval": "PT1M"
                  }
                }
              },
              "Compose_Btp_Pending_Rows": {
                "type": "Compose",
                "inputs": "@coalesce(body('Get_Btp_Pending_Rows')?[0], body('Get_Btp_Pending_Rows'), json('[]'))",
                "runAfter": {
                  "Get_Btp_Pending_Rows": [
                    "Succeeded"
                  ]
                }
              },
              "For_each_Btp_Pending_Row": {
                "type": "Foreach",
                "foreach": "@outputs('Compose_Btp_Pending_Rows')",
                "actions": {
                  "Set_Btp_CardSentAt": {
                    "type": "ServiceProvider",
                    "inputs": {
                      "parameters": {
                        "tableName": "[dbo].[BtpConfig]",
                        "setColumns": {
                          "CardSentAt": "@utcNow()"
                        },
                        "columnValuesForWhereCondition": {
                          "Id": "@item()?['Id']"
                        }
                      },
                      "serviceProviderConfiguration": {
                        "connectionName": "sql",
                        "operationId": "updateRows",
                        "serviceProviderId": "/serviceProviders/sql"
                      },
                      "retryPolicy": {
                        "type": "exponential",
                        "count": 3,
                        "interval": "PT5S",
                        "maximumInterval": "PT1M"
                      }
                    }
                  },
                  "Insert_Btp_Audit_CardSent": {
                    "type": "ServiceProvider",
                    "inputs": {
                      "parameters": {
                        "tableName": "[dbo].[EnrichmentAuditLog]",
                        "setColumns": {
                          "Domain": "Btp",
                          "CorrelationId": "@item()?['CorrelationId']",
                          "EntityKey": "@concat(coalesce(item()?['SubAccount'],''), '/', coalesce(item()?['ProductName'],''), '/', coalesce(item()?['Environment'],''))",
                          "Channel": "System",
                          "ActorEmail": "@item()?['RecipientEmail']",
                          "EventType": "CardSent",
                          "EventDetail": "@null"
                        }
                      },
                      "serviceProviderConfiguration": {
                        "connectionName": "sql",
                        "operationId": "insertRow",
                        "serviceProviderId": "/serviceProviders/sql"
                      },
                      "retryPolicy": {
                        "type": "exponential",
                        "count": 3,
                        "interval": "PT5S",
                        "maximumInterval": "PT1M"
                      }
                    },
                    "runAfter": {
                      "Set_Btp_CardSentAt": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Compose_Btp_Email_Missing_Fields": {
                    "type": "Compose",
                    "inputs": [
                      "@if(empty(item()?['Mode']), 'mode', null)",
                      "@if(empty(item()?['DeveloperId']), 'developerId', null)",
                      "@if(empty(item()?['Title']), 'title', null)",
                      "@if(empty(item()?['ShortText']), 'shortText', null)",
                      "@if(empty(item()?['RepoOwner']), 'repoOwner', null)",
                      "@if(empty(item()?['RepoName']), 'repoName', null)",
                      "@if(empty(item()?['WorkflowFileName']), 'workflowFileName', null)",
                      "@if(empty(item()?['BranchRef']), 'branchRef', null)",
                      "@if(equals(item()?['ServiceExists'], null), 'serviceExists', null)"
                    ],
                    "runAfter": {
                      "Insert_Btp_Audit_CardSent": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Filter_Btp_Email_Missing_Fields": {
                    "type": "Query",
                    "inputs": {
                      "from": "@outputs('Compose_Btp_Email_Missing_Fields')",
                      "where": "@not(equals(item(), null))"
                    },
                    "runAfter": {
                      "Compose_Btp_Email_Missing_Fields": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Select_Btp_Email_Field_Lines": {
                    "type": "Select",
                    "inputs": {
                      "from": "@body('Filter_Btp_Email_Missing_Fields')",
                      "select": "@concat(item(), ': ')"
                    },
                    "runAfter": {
                      "Filter_Btp_Email_Missing_Fields": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Compose_Btp_Email_Body": {
                    "type": "Compose",
                    "inputs": "@concat('<p>A few details are still needed to finish BTP onboarding (Tracking: ', item()?['CorrelationId'], ').</p>', '<p>Reply to this email. Only edit the blank after each colon between the two [[FIELDS]] lines — do not change the field names or markers. If a Message Type / child row list is what''s missing instead, please use the onboarding UI directly, since that can''t be answered by email.</p>', '<pre>[[FIELDS]]', decodeUriComponent('%0A'), join(body('Select_Btp_Email_Field_Lines'), decodeUriComponent('%0A')), decodeUriComponent('%0A'), '[[/FIELDS]]</pre>')",
                    "runAfter": {
                      "Select_Btp_Email_Field_Lines": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Send_Btp_Enrichment_Email": {
                    "type": "ApiConnection",
                    "inputs": {
                      "host": {
                        "connection": {
                          "referenceName": "outlook"
                        }
                      },
                      "method": "post",
                      "body": {
                        "To": "@item()?['RecipientEmail']",
                        "Subject": "@concat('[Tracking: ', item()?['CorrelationId'], '] BTP onboarding — information needed')",
                        "Body": "@outputs('Compose_Btp_Email_Body')",
                        "Importance": "Normal"
                      },
                      "path": "/v2/Mail",
                      "retryPolicy": {
                        "type": "exponential",
                        "count": 3,
                        "interval": "PT5S",
                        "maximumInterval": "PT1M"
                      }
                    },
                    "runAfter": {
                      "Compose_Btp_Email_Body": [
                        "Succeeded"
                      ]
                    }
                  }
                },
                "runAfter": {
                  "Compose_Btp_Pending_Rows": [
                    "Succeeded"
                  ]
                },
                "runtimeConfiguration": {
                  "concurrency": {
                    "repetitions": 5
                  }
                }
              },
              "Get_Btp_TimedOut_Rows": {
                "type": "ServiceProvider",
                "inputs": {
                  "parameters": {
                    "query": "SELECT TOP 20 * FROM [dbo].[BtpConfig] WHERE EnrichmentStatus = 'AwaitingInput' AND CardSentAt IS NOT NULL AND CardRespondedAt IS NULL AND DATEDIFF(day, CardSentAt, SYSUTCDATETIME()) >= 5"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "sql",
                    "operationId": "executeQuery",
                    "serviceProviderId": "/serviceProviders/sql"
                  },
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 3,
                    "interval": "PT5S",
                    "maximumInterval": "PT1M"
                  }
                },
                "runAfter": {
                  "For_each_Btp_Pending_Row": [
                    "Succeeded"
                  ]
                }
              },
              "Compose_Btp_TimedOut_Rows": {
                "type": "Compose",
                "inputs": "@coalesce(body('Get_Btp_TimedOut_Rows')?[0], body('Get_Btp_TimedOut_Rows'), json('[]'))",
                "runAfter": {
                  "Get_Btp_TimedOut_Rows": [
                    "Succeeded"
                  ]
                }
              },
              "For_each_Btp_TimedOut_Row": {
                "type": "Foreach",
                "foreach": "@outputs('Compose_Btp_TimedOut_Rows')",
                "actions": {
                  "Update_Btp_Row_CardTimedOut": {
                    "type": "ServiceProvider",
                    "inputs": {
                      "parameters": {
                        "tableName": "[dbo].[BtpConfig]",
                        "setColumns": {
                          "EnrichmentStatus": "CardTimedOut"
                        },
                        "columnValuesForWhereCondition": {
                          "Id": "@item()?['Id']"
                        }
                      },
                      "serviceProviderConfiguration": {
                        "connectionName": "sql",
                        "operationId": "updateRows",
                        "serviceProviderId": "/serviceProviders/sql"
                      },
                      "retryPolicy": {
                        "type": "exponential",
                        "count": 3,
                        "interval": "PT5S",
                        "maximumInterval": "PT1M"
                      }
                    },
                    "runAfter": {}
                  },
                  "Insert_Btp_Audit_CardTimedOut": {
                    "type": "ServiceProvider",
                    "inputs": {
                      "parameters": {
                        "tableName": "[dbo].[EnrichmentAuditLog]",
                        "setColumns": {
                          "Domain": "Btp",
                          "CorrelationId": "@item()?['CorrelationId']",
                          "EntityKey": "@concat(coalesce(item()?['SubAccount'],''), '/', coalesce(item()?['ProductName'],''), '/', coalesce(item()?['Environment'],''))",
                          "Channel": "System",
                          "ActorEmail": "@item()?['RecipientEmail']",
                          "EventType": "CardTimedOut",
                          "EventDetail": "@null"
                        }
                      },
                      "serviceProviderConfiguration": {
                        "connectionName": "sql",
                        "operationId": "insertRow",
                        "serviceProviderId": "/serviceProviders/sql"
                      },
                      "retryPolicy": {
                        "type": "exponential",
                        "count": 3,
                        "interval": "PT5S",
                        "maximumInterval": "PT1M"
                      }
                    },
                    "runAfter": {
                      "Update_Btp_Row_CardTimedOut": [
                        "Succeeded"
                      ]
                    }
                  }
                },
                "runAfter": {
                  "Compose_Btp_TimedOut_Rows": [
                    "Succeeded"
                  ]
                }
              }
            }
          },
          "Scope-Solace": {
            "type": "Scope",
            "actions": {
              "Get_Solace_Pending_Rows": {
                "type": "ServiceProvider",
                "inputs": {
                  "parameters": {
                    "query": "SELECT TOP 20 * FROM [dbo].[SolaceClient] WHERE EnrichmentStatus = 'AwaitingInput' AND CardSentAt IS NULL"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "sql",
                    "operationId": "executeQuery",
                    "serviceProviderId": "/serviceProviders/sql"
                  },
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 3,
                    "interval": "PT5S",
                    "maximumInterval": "PT1M"
                  }
                }
              },
              "Compose_Solace_Pending_Rows": {
                "type": "Compose",
                "inputs": "@coalesce(body('Get_Solace_Pending_Rows')?[0], body('Get_Solace_Pending_Rows'), json('[]'))",
                "runAfter": {
                  "Get_Solace_Pending_Rows": [
                    "Succeeded"
                  ]
                }
              },
              "For_each_Solace_Pending_Row": {
                "type": "Foreach",
                "foreach": "@outputs('Compose_Solace_Pending_Rows')",
                "actions": {
                  "Set_Solace_CardSentAt": {
                    "type": "ServiceProvider",
                    "inputs": {
                      "parameters": {
                        "tableName": "[dbo].[SolaceClient]",
                        "setColumns": {
                          "CardSentAt": "@utcNow()"
                        },
                        "columnValuesForWhereCondition": {
                          "Id": "@item()?['Id']"
                        }
                      },
                      "serviceProviderConfiguration": {
                        "connectionName": "sql",
                        "operationId": "updateRows",
                        "serviceProviderId": "/serviceProviders/sql"
                      },
                      "retryPolicy": {
                        "type": "exponential",
                        "count": 3,
                        "interval": "PT5S",
                        "maximumInterval": "PT1M"
                      }
                    }
                  },
                  "Insert_Solace_Audit_CardSent": {
                    "type": "ServiceProvider",
                    "inputs": {
                      "parameters": {
                        "tableName": "[dbo].[EnrichmentAuditLog]",
                        "setColumns": {
                          "Domain": "Solace",
                          "CorrelationId": "@item()?['CorrelationId']",
                          "EntityKey": "@concat(concat(coalesce(item()?['Brand'],''), '/', coalesce(item()?['Env'],'')), '/', concat(coalesce(item()?['SystemName'],''), '/', coalesce(item()?['ThreePLCode'],'')))",
                          "Channel": "System",
                          "ActorEmail": "@item()?['RecipientEmail']",
                          "EventType": "CardSent",
                          "EventDetail": "@null"
                        }
                      },
                      "serviceProviderConfiguration": {
                        "connectionName": "sql",
                        "operationId": "insertRow",
                        "serviceProviderId": "/serviceProviders/sql"
                      },
                      "retryPolicy": {
                        "type": "exponential",
                        "count": 3,
                        "interval": "PT5S",
                        "maximumInterval": "PT1M"
                      }
                    },
                    "runAfter": {
                      "Set_Solace_CardSentAt": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Compose_Solace_Email_Missing_Fields": {
                    "type": "Compose",
                    "inputs": [
                      "@if(empty(item()?['Action']), 'action', null)",
                      "@if(empty(item()?['AclClientConnectDefaultAction']), 'aclClientConnectDefaultAction', null)",
                      "@if(empty(item()?['AclPublishTopicDefaultAction']), 'aclPublishTopicDefaultAction', null)",
                      "@if(empty(item()?['AclSubscribeShareNameDefaultAction']), 'aclSubscribeShareNameDefaultAction', null)",
                      "@if(empty(item()?['AclSubscribeTopicDefaultAction']), 'aclSubscribeTopicDefaultAction', null)",
                      "@if(empty(item()?['RepoOwner']), 'repoOwner', null)",
                      "@if(empty(item()?['RepoName']), 'repoName', null)",
                      "@if(empty(item()?['FilePath']), 'filePath', null)",
                      "@if(empty(item()?['Branch']), 'branch', null)",
                      "@if(empty(item()?['BaseBranch']), 'baseBranch', null)",
                      "@if(empty(item()?['FeatureBranchName']), 'featureBranchName', null)",
                      "@if(empty(item()?['RequesterEmail']), 'requesterEmail', null)",
                      "@if(empty(item()?['RecipientEmail']), 'recipientEmail', null)",
                      "@if(empty(item()?['CommitMessage']), 'commitMessage', null)",
                      "@if(equals(item()?['ClientProfileAllowGuaranteedMsgSendEnabled'], null), 'clientProfileAllowGuaranteedMsgSendEnabled', null)",
                      "@if(equals(item()?['ClientProfileAllowGuaranteedMsgReceiveEnabled'], null), 'clientProfileAllowGuaranteedMsgReceiveEnabled', null)",
                      "@if(equals(item()?['ClientProfileCompressionEnabled'], null), 'clientProfileCompressionEnabled', null)",
                      "@if(equals(item()?['ClientProfileReplicationAllowClientConnectWhenStandbyEnabled'], null), 'clientProfileReplicationAllowClientConnectWhenStandbyEnabled', null)",
                      "@if(equals(item()?['ClientProfileAllowTransactedSessionsEnabled'], null), 'clientProfileAllowTransactedSessionsEnabled', null)",
                      "@if(equals(item()?['ClientProfileAllowBridgeConnectionsEnabled'], null), 'clientProfileAllowBridgeConnectionsEnabled', null)",
                      "@if(equals(item()?['ClientProfileAllowGuaranteedEndpointCreateEnabled'], null), 'clientProfileAllowGuaranteedEndpointCreateEnabled', null)",
                      "@if(equals(item()?['ClientProfileAllowSharedSubscriptionsEnabled'], null), 'clientProfileAllowSharedSubscriptionsEnabled', null)",
                      "@if(equals(item()?['ClientUserEnabled'], null), 'clientUserEnabled', null)",
                      "@if(equals(item()?['ClientUserGuaranteedEndpointPermissionOverrideEnabled'], null), 'clientUserGuaranteedEndpointPermissionOverrideEnabled', null)",
                      "@if(equals(item()?['ClientUserSubscriptionManagerEnabled'], null), 'clientUserSubscriptionManagerEnabled', null)",
                      "@if(equals(item()?['ServiceExists'], null), 'serviceExists', null)"
                    ],
                    "runAfter": {
                      "Insert_Solace_Audit_CardSent": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Filter_Solace_Email_Missing_Fields": {
                    "type": "Query",
                    "inputs": {
                      "from": "@outputs('Compose_Solace_Email_Missing_Fields')",
                      "where": "@not(equals(item(), null))"
                    },
                    "runAfter": {
                      "Compose_Solace_Email_Missing_Fields": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Select_Solace_Email_Field_Lines": {
                    "type": "Select",
                    "inputs": {
                      "from": "@body('Filter_Solace_Email_Missing_Fields')",
                      "select": "@concat(item(), ': ')"
                    },
                    "runAfter": {
                      "Filter_Solace_Email_Missing_Fields": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Compose_Solace_Email_Body": {
                    "type": "Compose",
                    "inputs": "@concat('<p>A few details are still needed to finish Solace onboarding (Tracking: ', item()?['CorrelationId'], ').</p>', '<p>Reply to this email. Only edit the blank after each colon between the two [[FIELDS]] lines — do not change the field names or markers. If a Message Type / child row list is what''s missing instead, please use the onboarding UI directly, since that can''t be answered by email.</p>', '<pre>[[FIELDS]]', decodeUriComponent('%0A'), join(body('Select_Solace_Email_Field_Lines'), decodeUriComponent('%0A')), decodeUriComponent('%0A'), '[[/FIELDS]]</pre>')",
                    "runAfter": {
                      "Select_Solace_Email_Field_Lines": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Send_Solace_Enrichment_Email": {
                    "type": "ApiConnection",
                    "inputs": {
                      "host": {
                        "connection": {
                          "referenceName": "outlook"
                        }
                      },
                      "method": "post",
                      "body": {
                        "To": "@item()?['RecipientEmail']",
                        "Subject": "@concat('[Tracking: ', item()?['CorrelationId'], '] Solace onboarding — information needed')",
                        "Body": "@outputs('Compose_Solace_Email_Body')",
                        "Importance": "Normal"
                      },
                      "path": "/v2/Mail",
                      "retryPolicy": {
                        "type": "exponential",
                        "count": 3,
                        "interval": "PT5S",
                        "maximumInterval": "PT1M"
                      }
                    },
                    "runAfter": {
                      "Compose_Solace_Email_Body": [
                        "Succeeded"
                      ]
                    }
                  }
                },
                "runAfter": {
                  "Compose_Solace_Pending_Rows": [
                    "Succeeded"
                  ]
                },
                "runtimeConfiguration": {
                  "concurrency": {
                    "repetitions": 5
                  }
                }
              },
              "Get_Solace_TimedOut_Rows": {
                "type": "ServiceProvider",
                "inputs": {
                  "parameters": {
                    "query": "SELECT TOP 20 * FROM [dbo].[SolaceClient] WHERE EnrichmentStatus = 'AwaitingInput' AND CardSentAt IS NOT NULL AND CardRespondedAt IS NULL AND DATEDIFF(day, CardSentAt, SYSUTCDATETIME()) >= 5"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "sql",
                    "operationId": "executeQuery",
                    "serviceProviderId": "/serviceProviders/sql"
                  },
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 3,
                    "interval": "PT5S",
                    "maximumInterval": "PT1M"
                  }
                },
                "runAfter": {
                  "For_each_Solace_Pending_Row": [
                    "Succeeded"
                  ]
                }
              },
              "Compose_Solace_TimedOut_Rows": {
                "type": "Compose",
                "inputs": "@coalesce(body('Get_Solace_TimedOut_Rows')?[0], body('Get_Solace_TimedOut_Rows'), json('[]'))",
                "runAfter": {
                  "Get_Solace_TimedOut_Rows": [
                    "Succeeded"
                  ]
                }
              },
              "For_each_Solace_TimedOut_Row": {
                "type": "Foreach",
                "foreach": "@outputs('Compose_Solace_TimedOut_Rows')",
                "actions": {
                  "Update_Solace_Row_CardTimedOut": {
                    "type": "ServiceProvider",
                    "inputs": {
                      "parameters": {
                        "tableName": "[dbo].[SolaceClient]",
                        "setColumns": {
                          "EnrichmentStatus": "CardTimedOut"
                        },
                        "columnValuesForWhereCondition": {
                          "Id": "@item()?['Id']"
                        }
                      },
                      "serviceProviderConfiguration": {
                        "connectionName": "sql",
                        "operationId": "updateRows",
                        "serviceProviderId": "/serviceProviders/sql"
                      },
                      "retryPolicy": {
                        "type": "exponential",
                        "count": 3,
                        "interval": "PT5S",
                        "maximumInterval": "PT1M"
                      }
                    },
                    "runAfter": {}
                  },
                  "Insert_Solace_Audit_CardTimedOut": {
                    "type": "ServiceProvider",
                    "inputs": {
                      "parameters": {
                        "tableName": "[dbo].[EnrichmentAuditLog]",
                        "setColumns": {
                          "Domain": "Solace",
                          "CorrelationId": "@item()?['CorrelationId']",
                          "EntityKey": "@concat(concat(coalesce(item()?['Brand'],''), '/', coalesce(item()?['Env'],'')), '/', concat(coalesce(item()?['SystemName'],''), '/', coalesce(item()?['ThreePLCode'],'')))",
                          "Channel": "System",
                          "ActorEmail": "@item()?['RecipientEmail']",
                          "EventType": "CardTimedOut",
                          "EventDetail": "@null"
                        }
                      },
                      "serviceProviderConfiguration": {
                        "connectionName": "sql",
                        "operationId": "insertRow",
                        "serviceProviderId": "/serviceProviders/sql"
                      },
                      "retryPolicy": {
                        "type": "exponential",
                        "count": 3,
                        "interval": "PT5S",
                        "maximumInterval": "PT1M"
                      }
                    },
                    "runAfter": {
                      "Update_Solace_Row_CardTimedOut": [
                        "Succeeded"
                      ]
                    }
                  }
                },
                "runAfter": {
                  "Compose_Solace_TimedOut_Rows": [
                    "Succeeded"
                  ]
                }
              }
            }
          },
          "Scope-MuleSoft": {
            "type": "Scope",
            "actions": {
              "Get_MuleSoft_Pending_Rows": {
                "type": "ServiceProvider",
                "inputs": {
                  "parameters": {
                    "query": "SELECT TOP 20 * FROM [dbo].[MuleSoftPartner] WHERE EnrichmentStatus = 'AwaitingInput' AND CardSentAt IS NULL"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "sql",
                    "operationId": "executeQuery",
                    "serviceProviderId": "/serviceProviders/sql"
                  },
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 3,
                    "interval": "PT5S",
                    "maximumInterval": "PT1M"
                  }
                }
              },
              "Compose_MuleSoft_Pending_Rows": {
                "type": "Compose",
                "inputs": "@coalesce(body('Get_MuleSoft_Pending_Rows')?[0], body('Get_MuleSoft_Pending_Rows'), json('[]'))",
                "runAfter": {
                  "Get_MuleSoft_Pending_Rows": [
                    "Succeeded"
                  ]
                }
              },
              "For_each_MuleSoft_Pending_Row": {
                "type": "Foreach",
                "foreach": "@outputs('Compose_MuleSoft_Pending_Rows')",
                "actions": {
                  "Set_MuleSoft_CardSentAt": {
                    "type": "ServiceProvider",
                    "inputs": {
                      "parameters": {
                        "tableName": "[dbo].[MuleSoftPartner]",
                        "setColumns": {
                          "CardSentAt": "@utcNow()"
                        },
                        "columnValuesForWhereCondition": {
                          "Id": "@item()?['Id']"
                        }
                      },
                      "serviceProviderConfiguration": {
                        "connectionName": "sql",
                        "operationId": "updateRows",
                        "serviceProviderId": "/serviceProviders/sql"
                      },
                      "retryPolicy": {
                        "type": "exponential",
                        "count": 3,
                        "interval": "PT5S",
                        "maximumInterval": "PT1M"
                      }
                    }
                  },
                  "Insert_MuleSoft_Audit_CardSent": {
                    "type": "ServiceProvider",
                    "inputs": {
                      "parameters": {
                        "tableName": "[dbo].[EnrichmentAuditLog]",
                        "setColumns": {
                          "Domain": "MuleSoft",
                          "CorrelationId": "@item()?['CorrelationId']",
                          "EntityKey": "@coalesce(item()?['CountryKey'], '')",
                          "Channel": "System",
                          "ActorEmail": "@item()?['RecipientEmail']",
                          "EventType": "CardSent",
                          "EventDetail": "@null"
                        }
                      },
                      "serviceProviderConfiguration": {
                        "connectionName": "sql",
                        "operationId": "insertRow",
                        "serviceProviderId": "/serviceProviders/sql"
                      },
                      "retryPolicy": {
                        "type": "exponential",
                        "count": 3,
                        "interval": "PT5S",
                        "maximumInterval": "PT1M"
                      }
                    },
                    "runAfter": {
                      "Set_MuleSoft_CardSentAt": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Compose_MuleSoft_Email_Missing_Fields": {
                    "type": "Compose",
                    "inputs": [
                      "@if(empty(item()?['CountryCode']), 'countryCode', null)",
                      "@if(empty(item()?['PartnerComment']), 'partnerComment', null)",
                      "@if(empty(item()?['CreatedBy']), 'createdBy', null)",
                      "@if(empty(item()?['NavProtocol']), 'navProtocol', null)",
                      "@if(empty(item()?['NavPort']), 'navPort', null)",
                      "@if(empty(item()?['NavUsername']), 'navUsername', null)",
                      "@if(empty(item()?['NavDomain']), 'navDomain', null)",
                      "@if(empty(item()?['NavService']), 'navService', null)",
                      "@if(empty(item()?['NavSoapPort']), 'navSoapPort', null)",
                      "@if(empty(item()?['TranslationReceiverName']), 'translationReceiverName', null)",
                      "@if(empty(item()?['RepoOwner']), 'repoOwner', null)",
                      "@if(empty(item()?['RepoName']), 'repoName', null)",
                      "@if(empty(item()?['FilePathPrefix']), 'filePathPrefix', null)",
                      "@if(empty(item()?['Branch']), 'branch', null)",
                      "@if(empty(item()?['BaseBranch']), 'baseBranch', null)",
                      "@if(empty(item()?['FeatureBranchName']), 'featureBranchName', null)",
                      "@if(empty(item()?['RequesterEmail']), 'requesterEmail', null)",
                      "@if(empty(item()?['RecipientEmail']), 'recipientEmail', null)",
                      "@if(empty(item()?['CommitMessage']), 'commitMessage', null)",
                      "@if(equals(item()?['NavUseCommonCert'], null), 'navUseCommonCert', null)",
                      "@if(equals(item()?['ServiceExists'], null), 'serviceExists', null)"
                    ],
                    "runAfter": {
                      "Insert_MuleSoft_Audit_CardSent": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Filter_MuleSoft_Email_Missing_Fields": {
                    "type": "Query",
                    "inputs": {
                      "from": "@outputs('Compose_MuleSoft_Email_Missing_Fields')",
                      "where": "@not(equals(item(), null))"
                    },
                    "runAfter": {
                      "Compose_MuleSoft_Email_Missing_Fields": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Select_MuleSoft_Email_Field_Lines": {
                    "type": "Select",
                    "inputs": {
                      "from": "@body('Filter_MuleSoft_Email_Missing_Fields')",
                      "select": "@concat(item(), ': ')"
                    },
                    "runAfter": {
                      "Filter_MuleSoft_Email_Missing_Fields": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Compose_MuleSoft_Email_Body": {
                    "type": "Compose",
                    "inputs": "@concat('<p>A few details are still needed to finish MuleSoft onboarding (Tracking: ', item()?['CorrelationId'], ').</p>', '<p>Reply to this email. Only edit the blank after each colon between the two [[FIELDS]] lines — do not change the field names or markers. If a Message Type / child row list is what''s missing instead, please use the onboarding UI directly, since that can''t be answered by email.</p>', '<pre>[[FIELDS]]', decodeUriComponent('%0A'), join(body('Select_MuleSoft_Email_Field_Lines'), decodeUriComponent('%0A')), decodeUriComponent('%0A'), '[[/FIELDS]]</pre>')",
                    "runAfter": {
                      "Select_MuleSoft_Email_Field_Lines": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Send_MuleSoft_Enrichment_Email": {
                    "type": "ApiConnection",
                    "inputs": {
                      "host": {
                        "connection": {
                          "referenceName": "outlook"
                        }
                      },
                      "method": "post",
                      "body": {
                        "To": "@item()?['RecipientEmail']",
                        "Subject": "@concat('[Tracking: ', item()?['CorrelationId'], '] MuleSoft onboarding — information needed')",
                        "Body": "@outputs('Compose_MuleSoft_Email_Body')",
                        "Importance": "Normal"
                      },
                      "path": "/v2/Mail",
                      "retryPolicy": {
                        "type": "exponential",
                        "count": 3,
                        "interval": "PT5S",
                        "maximumInterval": "PT1M"
                      }
                    },
                    "runAfter": {
                      "Compose_MuleSoft_Email_Body": [
                        "Succeeded"
                      ]
                    }
                  }
                },
                "runAfter": {
                  "Compose_MuleSoft_Pending_Rows": [
                    "Succeeded"
                  ]
                },
                "runtimeConfiguration": {
                  "concurrency": {
                    "repetitions": 5
                  }
                }
              },
              "Get_MuleSoft_TimedOut_Rows": {
                "type": "ServiceProvider",
                "inputs": {
                  "parameters": {
                    "query": "SELECT TOP 20 * FROM [dbo].[MuleSoftPartner] WHERE EnrichmentStatus = 'AwaitingInput' AND CardSentAt IS NOT NULL AND CardRespondedAt IS NULL AND DATEDIFF(day, CardSentAt, SYSUTCDATETIME()) >= 5"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "sql",
                    "operationId": "executeQuery",
                    "serviceProviderId": "/serviceProviders/sql"
                  },
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 3,
                    "interval": "PT5S",
                    "maximumInterval": "PT1M"
                  }
                },
                "runAfter": {
                  "For_each_MuleSoft_Pending_Row": [
                    "Succeeded"
                  ]
                }
              },
              "Compose_MuleSoft_TimedOut_Rows": {
                "type": "Compose",
                "inputs": "@coalesce(body('Get_MuleSoft_TimedOut_Rows')?[0], body('Get_MuleSoft_TimedOut_Rows'), json('[]'))",
                "runAfter": {
                  "Get_MuleSoft_TimedOut_Rows": [
                    "Succeeded"
                  ]
                }
              },
              "For_each_MuleSoft_TimedOut_Row": {
                "type": "Foreach",
                "foreach": "@outputs('Compose_MuleSoft_TimedOut_Rows')",
                "actions": {
                  "Update_MuleSoft_Row_CardTimedOut": {
                    "type": "ServiceProvider",
                    "inputs": {
                      "parameters": {
                        "tableName": "[dbo].[MuleSoftPartner]",
                        "setColumns": {
                          "EnrichmentStatus": "CardTimedOut"
                        },
                        "columnValuesForWhereCondition": {
                          "Id": "@item()?['Id']"
                        }
                      },
                      "serviceProviderConfiguration": {
                        "connectionName": "sql",
                        "operationId": "updateRows",
                        "serviceProviderId": "/serviceProviders/sql"
                      },
                      "retryPolicy": {
                        "type": "exponential",
                        "count": 3,
                        "interval": "PT5S",
                        "maximumInterval": "PT1M"
                      }
                    },
                    "runAfter": {}
                  },
                  "Insert_MuleSoft_Audit_CardTimedOut": {
                    "type": "ServiceProvider",
                    "inputs": {
                      "parameters": {
                        "tableName": "[dbo].[EnrichmentAuditLog]",
                        "setColumns": {
                          "Domain": "MuleSoft",
                          "CorrelationId": "@item()?['CorrelationId']",
                          "EntityKey": "@coalesce(item()?['CountryKey'], '')",
                          "Channel": "System",
                          "ActorEmail": "@item()?['RecipientEmail']",
                          "EventType": "CardTimedOut",
                          "EventDetail": "@null"
                        }
                      },
                      "serviceProviderConfiguration": {
                        "connectionName": "sql",
                        "operationId": "insertRow",
                        "serviceProviderId": "/serviceProviders/sql"
                      },
                      "retryPolicy": {
                        "type": "exponential",
                        "count": 3,
                        "interval": "PT5S",
                        "maximumInterval": "PT1M"
                      }
                    },
                    "runAfter": {
                      "Update_MuleSoft_Row_CardTimedOut": [
                        "Succeeded"
                      ]
                    }
                  }
                },
                "runAfter": {
                  "Compose_MuleSoft_TimedOut_Rows": [
                    "Succeeded"
                  ]
                }
              }
            }
          }
        },
        "runAfter": {}
      },
      "Scope-Catch": {
        "type": "Scope",
        "actions": {
          "Insert_Audit_Error": {
            "type": "ServiceProvider",
            "inputs": {
              "parameters": {
                "tableName": "[dbo].[EnrichmentAuditLog]",
                "setColumns": {
                  "Domain": "System",
                  "CorrelationId": "@null",
                  "EntityKey": "@null",
                  "Channel": "System",
                  "ActorEmail": "@null",
                  "EventType": "Error",
                  "EventDetail": "@string(result('Scope-Try'))"
                }
              },
              "serviceProviderConfiguration": {
                "connectionName": "sql",
                "operationId": "insertRow",
                "serviceProviderId": "/serviceProviders/sql"
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT5S",
                "maximumInterval": "PT1M"
              }
            }
          }
        },
        "runAfter": {
          "Scope-Try": [
            "FAILED"
          ]
        }
      }
    },
    "triggers": {
      "Recurrence": {
        "type": "Recurrence",
        "recurrence": {
          "frequency": "Minute",
          "interval": 5
        }
      }
    },
    "contentVersion": "1.0.0.0",
    "outputs": {}
  },
  "kind": "stateful"
}
