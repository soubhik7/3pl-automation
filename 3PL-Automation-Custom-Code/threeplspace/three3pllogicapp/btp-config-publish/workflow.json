{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "actions": {
      "Initialize_Correlation_Id": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "correlationId",
              "type": "string",
              "value": "@coalesce(triggerBody()?['correlationId'], '')"
            }
          ]
        },
        "runAfter": {}
      },
      "Scope-Try": {
        "type": "Scope",
        "actions": {
          "Call_a_local_function-Trigger_BTP_GitHub_Action": {
            "type": "InvokeFunction",
            "inputs": {
              "functionName": "TriggerBtpDeployment",
              "parameters": {
                "repoOwner": "@coalesce(triggerBody()?['repoOwner'], 'Mars-Incorporated')",
                "repoName": "@coalesce(triggerBody()?['repoName'], 'marsis-az-core-pipeline')",
                "workflowFileName": "@coalesce(triggerBody()?['workflowFileName'], 'btp-Api-management-deploy.yml')",
                "branchRef": "@coalesce(triggerBody()?['branchRef'], 'feature-kk-btp-app-creation')",
                "subAccount": "@coalesce(triggerBody()?['subAccount'], 'Global')",
                "mode": "@coalesce(triggerBody()?['mode'], 'Create_Application_with_Product')",
                "environment": "@coalesce(triggerBody()?['environment'], 'Dev')",
                "developerId": "@coalesce(triggerBody()?['developerId'], '@effem.com')",
                "title": "@coalesce(triggerBody()?['title'], 'MyNewApplication')",
                "shortText": "@coalesce(triggerBody()?['shortText'], 'Short description here')",
                "productName": "@coalesce(triggerBody()?['productName'], 'cicd,TestAIS')",
                "correlationId": "@variables('correlationId')"
              }
            }
          },
          "Response-Success": {
            "type": "Response",
            "kind": "Http",
            "inputs": {
              "statusCode": 200,
              "body": "@body('Call_a_local_function-Trigger_BTP_GitHub_Action')"
            },
            "runAfter": {
              "Call_a_local_function-Trigger_BTP_GitHub_Action": [
                "SUCCEEDED"
              ]
            }
          }
        },
        "runAfter": {
          "Initialize_Correlation_Id": [
            "Succeeded"
          ]
        }
      },
      "Scope-Catch": {
        "type": "Scope",
        "actions": {
          "Response-Error": {
            "type": "Response",
            "kind": "Http",
            "inputs": {
              "statusCode": 500,
              "body": {
                "status": "btp-config-publish failed.",
                "correlationId": "@variables('correlationId')",
                "details": "@result('Scope-Try')"
              }
            }
          }
        },
        "runAfter": {
          "Scope-Try": [
            "FAILED"
          ]
        }
      }
    },
    "triggers": {
      "When_a_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http"
      }
    },
    "contentVersion": "1.0.0.0",
    "outputs": {}
  },
  "kind": "stateful"
}