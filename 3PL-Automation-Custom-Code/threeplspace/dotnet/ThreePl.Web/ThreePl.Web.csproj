<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The host app targets net10.0: this machine has no ASP.NET Core 8.x
         runtime, and running a net8 Blazor app roll-forwarded onto the 10.x
         framework breaks _framework/blazor.web.js serving (404 → no
         interactivity). ThreePl.Core stays net8.0 alongside
         threepllocalfunction. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>threepl-web-4f2a9c1e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThreePl.Core\ThreePl.Core.csproj" />
  </ItemGroup>

</Project>
