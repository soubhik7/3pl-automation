<div class="form-group checkbox-row">
    <input type="checkbox" id="@Id" checked="@Value" @onchange="OnChange" />
    <label for="@Id">@Label</label>
</div>

@code {
    private static int _counter;
    private string _generatedId = $"chk-auto-{Interlocked.Increment(ref _counter)}";

    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    protected override void OnParametersSet() => Id ??= _generatedId;

    private Task OnChange(ChangeEventArgs e) => ValueChanged.InvokeAsync((bool)(e.Value ?? false));
}
