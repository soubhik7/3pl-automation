                <mxCell id="c193" value="orchestrator ✓" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#107C41;fontColor=#107C41;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="lld-1" source="c189" target="c190" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c194" value="orchestrator ✗" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#C0392B;fontColor=#C0392B;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=1;dashPattern=6 4;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="lld-1" source="c189" target="c191" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
