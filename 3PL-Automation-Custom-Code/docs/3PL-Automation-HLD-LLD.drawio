    <diagram name="2 · LLD — Detailed Design" id="lld">
        <mxGraphModel dx="2150" dy="919" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="826" background="#FFFFFF" math="0" shadow="0">
            <root>
                <mxCell id="lld-0"/>
                <mxCell id="lld-1" parent="lld-0"/>
                <mxCell id="c174" value="&lt;font style=&quot;font-size:24px&quot;&gt;&lt;b&gt;3PL PARTNER ONBOARDING AUTOMATION&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:12px&quot; color=&quot;#8FB8E0&quot;&gt;Workflow Internals · Data Model · Integration Contracts&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#BFD7EF&quot;&gt;LOW-LEVEL DESIGN (LLD) — Workflow-Level Behaviour, Custom Code, SQL Schema &amp;amp; External Contracts&lt;/font&gt;" style="rounded=0;html=1;fillColor=#12263F;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=26;whiteSpace=wrap;" parent="lld-1" vertex="1">
                    <mxGeometry width="2520" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="c175" value="&lt;b&gt;Version 1.0&lt;/b&gt; · 07 Jul 2026 · Region: Central India&lt;br&gt;Logic App Standard: &lt;b&gt;3pl-automation&lt;/b&gt; · Owner: Integration Platform" style="rounded=1;arcSize=20;html=1;fillColor=#1E3A5F;strokeColor=#3D5A80;fontColor=#DCE9F5;fontSize=10;align=left;verticalAlign=middle;spacingLeft=12;whiteSpace=wrap;" parent="lld-1" vertex="1">
                    <mxGeometry x="2100" y="24" width="396" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="c176" value="&lt;b&gt;&lt;font color=&quot;#B25A00&quot;&gt;CLIENT — 3pl-onboarding.html&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• 3 views: &lt;b&gt;Intake&lt;/b&gt; (Btp 14 flat fields · Solace + messageTypes[] rows · MuleSoft + 5 child-row tables), &lt;b&gt;Status &amp;amp; Tracking&lt;/b&gt;, &lt;b&gt;Launch&lt;/b&gt;&lt;br&gt;• &lt;b&gt;correlationId = ui-&amp;lt;slug&amp;gt;-&amp;lt;timestamp&amp;gt;&lt;/b&gt; — generated per onboarding, kept in localStorage (recent list)&lt;br&gt;• per-domain Save → POST data-enrichment (partial payloads OK — AwaitingInput hands off to the notifier)&lt;br&gt;• status poll every 10 s — stops on terminal states&lt;br&gt;• Launch enabled only when readyToLaunch (server re-gates ❻)&lt;br&gt;• encryptedPassword: type=password, never echoed, never stored&lt;br&gt;• SAS invoke URLs pasted locally — &lt;b&gt;never committed&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#B25A00;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="20" y="120" width="480" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="c177" value="&lt;b&gt;&lt;font color=&quot;#C0392B&quot;&gt;SECURITY &amp;amp; CONFIGURATION&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• every HTTP trigger is SAS-signed (per-workflow invoke URL)&lt;br&gt;• CORS * on Logic App — &lt;b&gt;dev-only&lt;/b&gt;, tighten to hosted origin&lt;br&gt;• secrets in app settings: SqlConnectionString · GitHub PAT (Key Vault adoption planned)&lt;br&gt;• ActorEmail masked &lt;b&gt;inside T-SQL&lt;/b&gt;: LEFT(2) + *** + @domain — raw address never leaves SQL&lt;br&gt;• EncryptedPassword excluded from every SELECT that reaches a client&lt;br&gt;• launch gate enforced server-side — UI state is never trusted&lt;br&gt;• SQL login threepl-logicapp-svc: SELECT/UPDATE parents, INSERT audit only&lt;br&gt;• query building: concat + quote-doubling (no dynamic queryParameters)&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#C0392B;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="520" y="120" width="480" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="c178" value="&lt;b&gt;&lt;font color=&quot;#0F6E5C&quot;&gt;STATE MACHINES&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#0F6E5C;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="1020" y="120" width="740" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="c179" value="&lt;b&gt;&lt;font color=&quot;#107C41&quot;&gt;AUDIT MODEL — EnrichmentAuditLog (append-only)&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Columns:&lt;/b&gt; Id PK · CorrelationId (IX) · Domain (Btp | Solace | MuleSoft | Orchestrator) · EventType · Channel · ActorEmail (masked on read) · EventDetail · CreatedAt&lt;br&gt;&lt;br&gt;&lt;b&gt;EventTypes (11, CHECK-constrained):&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0078D4&quot;&gt;Received · Upserted · ValidationFailed&lt;/font&gt; — intake&lt;br&gt;&lt;font color=&quot;#5059C9&quot;&gt;CardSent · CardResponded · CardTimedOut&lt;/font&gt; — Teams HITL&lt;br&gt;&lt;font color=&quot;#0F6CBD&quot;&gt;MailRejected&lt;/font&gt; — mail intake guardrails&lt;br&gt;&lt;font color=&quot;#7B5CD6&quot;&gt;OrchestrationStarted · OrchestrationSucceeded · OrchestrationFailed&lt;/font&gt; — launch&lt;br&gt;&lt;font color=&quot;#C0392B&quot;&gt;Error&lt;/font&gt; — Scope-Catch (channel System)&lt;br&gt;&lt;br&gt;&lt;b&gt;Channels:&lt;/b&gt; Api · AdaptiveCard · Mail · System — the TOP-100 trail per correlationId feeds the portal timeline ❺&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#107C41;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="1780" y="120" width="720" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="c180" value="&lt;b&gt;EnrichmentStatus&lt;/b&gt; (per domain row)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;fontSize=10;fontStyle=1;" parent="lld-1" vertex="1">
