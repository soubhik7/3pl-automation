                            <mxPoint x="1440" y="437"/>
                            <mxPoint x="1281" y="437"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="c197" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#5B6B7C&quot;&gt;Double-launch guard: any row InProgress → 409 · any row Deployed without forceRedeploy → 409&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;" parent="lld-1" vertex="1">
                    <mxGeometry x="1530" y="348" width="220" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="c198" value="LOGIC APP STANDARD &#39;3pl-automation&#39; — WORKFLOW-LEVEL DESIGN" style="rounded=1;arcSize=3;html=1;fillColor=#F7FBFF;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#0078D4;whiteSpace=wrap;" parent="lld-1" vertex="1">
                    <mxGeometry x="10" y="498" width="2433" height="1152" as="geometry"/>
                </mxCell>
                <mxCell id="c200" value="&lt;b&gt;&lt;font color=&quot;#0078D4&quot;&gt;⚡ data-enrichment&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;HTTP Request (SAS) · called by portal ❶ and mail-intake&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;1. Audit &lt;b&gt;Received&lt;/b&gt; (channel Api / Mail)&lt;br&gt;2. Switch(domain): Btp | Solace | MuleSoft — unknown → 400&lt;br&gt;3. Upsert parent: UPDATE → INSERT → conflict re-UPDATE&lt;br&gt;4. Replace children (DELETE + INSERT): Solace messageTypes · 5 MuleSoft sets&lt;br&gt;5. Recompute &lt;b&gt;EnrichmentStatus&lt;/b&gt; from the required-field list per domain&lt;br&gt;6. Audit &lt;b&gt;Upserted&lt;/b&gt; / &lt;b&gt;ValidationFailed&lt;/b&gt;&lt;br&gt;7. Respond 200 {enrichmentStatus} · 400 · 500 (Scope-Catch → audit Error)&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="50" y="560" width="560" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="c201" value="&lt;b&gt;&lt;font color=&quot;#0078D4&quot;&gt;⚡ enrichment-status&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;HTTP Request (SAS) · portal poll ❺ · read-only&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;1. Validate correlationId → else 400&lt;br&gt;2. SELECT 3 parents — explicit column list, &lt;b&gt;EncryptedPassword never selected&lt;/b&gt;&lt;br&gt;3. SELECT child counts · audit TOP 100 (ActorEmail masked in T-SQL)&lt;br&gt;4. Compose per domain: found · enrichmentStatus · deploymentStatus · cardSentAt/RespondedAt · missingFields[]&lt;br&gt;5. &lt;b&gt;readyToLaunch&lt;/b&gt; = all 3 found ∧ Complete → Respond 200 · 500 on error&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="50" y="850" width="560" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="c202" value="&lt;b&gt;&lt;font color=&quot;#0078D4&quot;&gt;⚡ onboarding-launcher&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;HTTP Request (SAS) · gated async launch ❻&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;1. Audit &lt;b&gt;Received&lt;/b&gt; (Domain=Orchestrator) · 2. SELECT 3 parents by correlationId&lt;br&gt;3. &lt;b&gt;GATE&lt;/b&gt;: all found ∧ Complete · none InProgress · Deployed ⇒ forceRedeploy — fail → audit + &lt;b&gt;409&lt;/b&gt; per-domain reasons&lt;br&gt;4. UPDATE ×3 DeploymentStatus=InProgress + audit &lt;b&gt;OrchestrationStarted&lt;/b&gt;&lt;br&gt;5. &lt;b&gt;Respond 202&lt;/b&gt; — respond-then-continue (run keeps going)&lt;br&gt;6. SELECT 6 child-row sets · 7. InvokeFunction &lt;b&gt;BuildSolaceCsv&lt;/b&gt; + &lt;b&gt;BuildMuleSoftCsv&lt;/b&gt;&lt;br&gt;8. Compose orchestrator payload (Postman contract — btp / mulesoft / solace sections + csvContent)&lt;br&gt;9. Invoke &lt;b&gt;onboarding-orchestrator&lt;/b&gt; (sync child — hours OK post-202)&lt;br&gt;10. ✓ → ×3 Deployed + audit OrchestrationSucceeded · ✗ → ×3 Failed + audit OrchestrationFailed (error body persisted)&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="50" y="1100" width="560" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="c203" value="&lt;b&gt;&lt;font color=&quot;#5059C9&quot;&gt;⚡ data-enrichment-notifier&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;Recurrence — every 5 min · HITL chase ❸&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;For each domain (Btp · Solace · MuleSoft):&lt;br&gt;1. SELECT pending rows (EnrichmentStatus=AwaitingInput, card not yet sent)&lt;br&gt;2. UPDATE CardSentAt + audit &lt;b&gt;CardSent&lt;/b&gt;&lt;br&gt;3. Outlook tracking e-mail (embeds reply marker) · Teams adaptive card &lt;b&gt;post &amp;amp; wait&lt;/b&gt; (webhook)&lt;br&gt;4. response → UPDATE answered fields + recompute status + audit &lt;b&gt;CardResponded&lt;/b&gt; ❹&lt;br&gt;5. timeout → UPDATE CardTimedOut + audit &lt;b&gt;CardTimedOut&lt;/b&gt;&lt;br&gt;Scope-Catch → audit Error (channel System)&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#5059C9;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="650" y="560" width="560" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="c204" value="&lt;b&gt;&lt;font color=&quot;#0F6CBD&quot;&gt;⚡ data-enrichment-mail-intake&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;O365 trigger — when a new e-mail arrives (V2) ❹&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;1. Parse tracking marker (correlationId + domain) from the reply&lt;br&gt;2. Audit lookup for the tracking id — none → audit &lt;b&gt;MailRejected&lt;/b&gt; (NoMarker / UnknownId)&lt;br&gt;3. SELECT current domain row: not found → MailRejected(NotFound) · already Complete → MailRejected(AlreadyDone) · unknown domain → MailRejected(UnknownDomain)&lt;br&gt;4. Map answers → &lt;b&gt;invoke data-enrichment&lt;/b&gt; (channel Mail) — same validation + audit path&lt;br&gt;Scope-Catch → audit Error&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#0F6CBD;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="650" y="860" width="560" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="c205" value="&lt;b&gt;&lt;font color=&quot;#7B5CD6&quot;&gt;⚡ onboarding-orchestrator&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;HTTP Request · invoked by launcher ❼&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Scope-Try — &lt;b&gt;3 parallel scopes&lt;/b&gt;:&lt;br&gt;• Scope-BTP: invoke &lt;b&gt;btp-config-publish&lt;/b&gt;&lt;br&gt;• Scope-MuleSoft: &lt;b&gt;mulesoft-config-generation → mulesoft-config-publish&lt;/b&gt;&lt;br&gt;• Scope-Solace: &lt;b&gt;solace-config-generation → solace-config-publish&lt;/b&gt;&lt;br&gt;Response 200 after all 3 · Scope-Catch → Response 500 with per-domain result() detail&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#7B5CD6;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="650" y="1140" width="560" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="c206" value="&lt;b&gt;&lt;font color=&quot;#3D447F&quot;&gt;⚡ request-feature-branch-via-teams&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;HTTP Request · HITL ❽&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Post approval adaptive card to Architect &amp;amp; wait (webhook) → approve / reject → Response&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#3D447F;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="1250" y="560" width="700" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="c207" value="&lt;b&gt;&lt;font color=&quot;#24292F&quot;&gt;⚡ solace-config-generation&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;HTTP Request · invoked by orchestrator&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;1. &lt;b&gt;CheckGitHubBranchExists&lt;/b&gt; — missing → invoke &lt;b&gt;request-feature-branch-via-teams&lt;/b&gt;: rejected → Response 4xx (run stops) · approved → &lt;b&gt;EnsureGitHubBranchExists&lt;/b&gt; (POST git/refs)&lt;br&gt;2. &lt;b&gt;FetchExistingConfigFile&lt;/b&gt; — current YAML from branch&lt;br&gt;3. &lt;b&gt;GenerateSolaceConfig&lt;/b&gt; — 26-col CSV → client/queue YAML&lt;br&gt;4. &lt;b&gt;MergeSolaceConfig&lt;/b&gt; — merge into existing YAML → Response 200 {yaml}&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#24292F;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="1370" y="651" width="700" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="c208" value="&lt;b&gt;&lt;font color=&quot;#24292F&quot;&gt;⚡ mulesoft-config-generation&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;HTTP Request · invoked by orchestrator&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;1. Branch ensure — same HITL pattern as Solace (Check → Teams approval → Ensure)&lt;br&gt;2. &lt;b&gt;FetchExistingConfigFile ×4&lt;/b&gt; — app / dev / tst / prod YAML&lt;br&gt;3. &lt;b&gt;GenerateMuleSoftConfig&lt;/b&gt; — CSV → 4-document YAML set (updateExisting merge semantics)&lt;br&gt;4. Response 200 {yaml set}&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#24292F;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="1440" y="863" width="700" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="c209" value="&lt;b&gt;&lt;font color=&quot;#24292F&quot;&gt;⚡ solace-config-publish · mulesoft-config-publish&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;HTTP Request ×2 · invoked by orchestrator ❾&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;&lt;b&gt;PublishSolaceConfigToFeatureBranch&lt;/b&gt; / &lt;b&gt;PublishMuleSoftConfigToFeatureBranch&lt;/b&gt; — GitHub Contents API PUT (base64, sha-aware create/update) on the feature branch → Response 200 {commit}&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#24292F;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="1515" y="1092" width="700" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="c210" value="&lt;b&gt;&lt;font color=&quot;#24292F&quot;&gt;⚡ btp-config-publish&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;HTTP Request · invoked by orchestrator ❿&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;&lt;b&gt;TriggerBtpDeployment&lt;/b&gt; → POST /repos/{o}/{r}/actions/workflows/{file}/dispatches {ref, inputs} → 204 → Response 200&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#24292F;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="1607" y="1236" width="700" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="c211" value="&lt;b&gt;.NET 8 CUSTOM CODE — InvokeFunction (in-process, no HTTP hop)&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:9px&quot; color=&quot;#5B6B7C&quot;&gt;shared: GitHubApiClient (PAT) · GitHubRetryHandler (backoff) · GitHubBranchChecker/Publisher/Reader · CsvFieldEscaper + CsvLineSplitter (escaping round-trip guarantee) · Guard&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FBFCFE;strokeColor=#57606A;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=0;" parent="lld-1" vertex="1">
                    <mxGeometry x="50" y="1400" width="1900" height="180" as="geometry"/>
