                </mxCell>
                <mxCell id="c26" value="&lt;b&gt;&lt;font color=&quot;#B25A00&quot;&gt;ONBOARDING PORTAL&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;3pl-onboarding.html (SPA)&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Intake — 3 domain forms + &lt;b&gt;Direction&lt;/b&gt; (Inbound/Outbound)&lt;br&gt;• Status &amp;amp; Tracking — live poll, incl. approval states&lt;br&gt;• Launch — per-domain or all, server re-gated&lt;br&gt;• one &lt;b&gt;correlationId&lt;/b&gt; per onboarding&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#B25A00;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="hld-1" vertex="1">
                    <mxGeometry x="45" y="510" width="250" height="178" as="geometry"/>
                </mxCell>
                <mxCell id="c27" value="&lt;b&gt;Domain SME&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7C&quot; style=&quot;font-size:9px&quot;&gt;answers missing fields by e-mail reply&amp;nbsp;&amp;nbsp;③ — &lt;b&gt;Outbound domains only&lt;/b&gt;; Inbound skips this entirely&lt;/font&gt;" style="image;sketch=0;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#1F2A37;image=img/lib/azure2/identity/Users.svg;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;whiteSpace=wrap;" parent="hld-1" vertex="1">
                    <mxGeometry x="120" y="730" width="58" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="c28" value="&lt;b&gt;Platform Architect&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7C&quot; style=&quot;font-size:9px&quot;&gt;approves by e-mail reply: architecture sign-off ⑦ and/or feature-branch creation ⑪&lt;/font&gt;" style="image;sketch=0;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#1F2A37;image=img/lib/azure2/identity/Users.svg;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;whiteSpace=wrap;" parent="hld-1" vertex="1">
