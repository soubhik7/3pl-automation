                    <mxGeometry y="210" relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c220" value="Approved ⑫ → poller resumes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#8A5A00;fontColor=#8A5A00;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" parent="lld-1" source="c215" target="c214" edge="1">
                    <mxGeometry y="210" relative="1" as="geometry">
