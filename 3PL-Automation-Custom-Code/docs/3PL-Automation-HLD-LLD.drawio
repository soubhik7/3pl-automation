                <mxCell id="c218" value="both gates ✓ ⑥⑦⑨" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#0078D4;fontColor=#0078D4;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="lld-1" source="c213" target="c214" edge="1">
