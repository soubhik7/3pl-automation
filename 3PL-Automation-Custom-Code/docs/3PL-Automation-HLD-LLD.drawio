                </mxCell>
                <mxCell id="c223" value="Rejected ⑫" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#C0392B;fontColor=#C0392B;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=1;dashPattern=6 4;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" parent="lld-1" source="c215" target="c217" edge="1">
                    <mxGeometry y="210" relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c224" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#5B6B7C&quot;&gt;Double-launch guard: any row InProgress → 409 · any row Deployed without forceRedeploy → 409. AwaitingBranchApproval is a genuine third outcome — never mistaken for Failed by the orchestrator/launcher.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;" parent="lld-1" vertex="1">
                    <mxGeometry x="1040" y="620" width="660" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="c225" value="&lt;b&gt;&lt;font color=&quot;#8A5A00&quot;&gt;ArchitectureApprovalStatus&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size:8px&quot; color=&quot;#8A97A6&quot;&gt;1 row/correlationId&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;&lt;b&gt;Pending&lt;/b&gt; →APPROVE⑧→ &lt;b&gt;Approved&lt;/b&gt; (gates ALL requested domains, checked after the enrichment gate) · &lt;b&gt;Pending&lt;/b&gt; →REJECT⑧→ &lt;b&gt;Rejected&lt;/b&gt; → next launch re-inserts Pending&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#8A5A00;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=0;" parent="lld-1" vertex="1">
                    <mxGeometry x="1470" y="362" width="280" height="124" as="geometry"/>
                </mxCell>
                <mxCell id="c226" value="LOGIC APP STANDARD &#39;3pl-automation&#39; — WORKFLOW-LEVEL DESIGN" style="rounded=1;arcSize=3;html=1;fillColor=#F7FBFF;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#0078D4;whiteSpace=wrap;" parent="lld-1" vertex="1">
                    <mxGeometry x="20" y="700" width="1980" height="1170" as="geometry"/>
                </mxCell>
                <mxCell id="c227" value="EXTERNAL CONTRACTS" style="rounded=1;arcSize=3;html=1;fillColor=#F2F4F7;strokeColor=#40474F;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#40474F;whiteSpace=wrap;" parent="lld-1" vertex="1">
                    <mxGeometry x="2020" y="700" width="480" height="1170" as="geometry"/>
                </mxCell>
                <mxCell id="c228" value="&lt;b&gt;&lt;font color=&quot;#0078D4&quot;&gt;⚡ data-enrichment&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;HTTP Request (SAS) · called by portal ① and mail-intake&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;1. Audit &lt;b&gt;Received&lt;/b&gt; (channel Api / Mail)&lt;br&gt;2. Switch(domain): Btp | Solace | MuleSoft — unknown → 400&lt;br&gt;3. Upsert parent: UPDATE → INSERT → conflict re-UPDATE (incl. &lt;b&gt;Direction&lt;/b&gt;)&lt;br&gt;4. Replace children (DELETE + INSERT): Solace messageTypes · 5 MuleSoft sets&lt;br&gt;5. &lt;b&gt;Direction=Inbound&lt;/b&gt; ⇒ EnrichmentStatus=Complete immediately; else recompute from the required-field list (unchanged)&lt;br&gt;6. Audit &lt;b&gt;Upserted&lt;/b&gt; / &lt;b&gt;ValidationFailed&lt;/b&gt;&lt;br&gt;7. Respond 200 {enrichmentStatus} · 400 · 500 (Scope-Catch → audit Error)&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="50" y="770" width="560" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="c229" value="&lt;b&gt;&lt;font color=&quot;#0078D4&quot;&gt;⚡ enrichment-status&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;HTTP Request (SAS) · portal poll ⑤ · read-only&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;1. Validate correlationId → else 400&lt;br&gt;2. SELECT 3 parents (incl. Direction, BranchApprovalStatus, PendingBranchName) + &lt;b&gt;OnboardingApproval&lt;/b&gt; row — &lt;b&gt;EncryptedPassword never selected&lt;/b&gt;&lt;br&gt;3. SELECT child counts · audit TOP 100 (ActorEmail masked in T-SQL)&lt;br&gt;4. Compose per domain: found · enrichmentStatus · deploymentStatus · direction · branchApprovalStatus/pendingBranchName · missingFields[]; top-level &lt;b&gt;architectureApproval&lt;/b&gt;{status,approverEmail,respondedAt}&lt;br&gt;5. &lt;b&gt;readyToLaunch&lt;/b&gt; = all 3 found ∧ Complete → Respond 200 · 500 on error&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="50" y="1050" width="560" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="c230" value="&lt;b&gt;&lt;font color=&quot;#0078D4&quot;&gt;⚡ onboarding-launcher&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;HTTP Request (SAS) · gated async launch ⑥⑦⑨⑩&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;1. Audit &lt;b&gt;Received&lt;/b&gt; · 2. SELECT 3 parents by correlationId&lt;br&gt;3. &lt;b&gt;Enrichment GATE&lt;/b&gt; (unchanged): all requested domains found ∧ Complete · none InProgress · Deployed ⇒ forceRedeploy — fail → 409&lt;br&gt;4. &lt;b&gt;NEW — Architecture-approval GATE&lt;/b&gt;: SELECT OnboardingApproval; Approved → continue below; not requested → insert/reset Pending + send e-mail + &lt;b&gt;Respond 202 AwaitingArchitectureApproval&lt;/b&gt;; already Pending → 202 again, no duplicate e-mail&lt;br&gt;5. (Approved path) UPDATE ×N DeploymentStatus=InProgress + audit OrchestrationStarted · &lt;b&gt;Respond 202&lt;/b&gt;&lt;br&gt;6. Rebuild CSVs via BuildSolaceCsv/BuildMuleSoftCsv · invoke &lt;b&gt;onboarding-orchestrator&lt;/b&gt;&lt;br&gt;7. Per domain: skip the Deployed update if that domain&#39;s result is &lt;b&gt;AwaitingBranchApproval&lt;/b&gt; (already written directly); else ✓ → Deployed · ✗ → Failed + audit&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="50" y="1330" width="560" height="275" as="geometry"/>
                </mxCell>
                <mxCell id="c231" value="&lt;b&gt;&lt;font color=&quot;#0F6CBD&quot;&gt;⚡ data-enrichment-notifier&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;Recurrence — every 5 min · e-mail-only chase ③&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;For each domain (Btp · Solace · MuleSoft):&lt;br&gt;1. SELECT pending Outbound rows (EnrichmentStatus=AwaitingInput, e-mail not yet sent)&lt;br&gt;2. UPDATE CardSentAt + audit &lt;b&gt;CardSent&lt;/b&gt;&lt;br&gt;3. Build the missing-scalar-field list (same whitelist ParseEnrichmentReply uses) → structured &lt;b&gt;[[FIELDS]]…[[/FIELDS]]&lt;/b&gt; e-mail via Outlook — &lt;b&gt;no more adaptive card, no webhook wait&lt;/b&gt;&lt;br&gt;4. Second pass, same recurrence tick: SELECT rows with CardSentAt but no CardRespondedAt and &lt;b&gt;DATEDIFF(day,…) ≥ 5&lt;/b&gt; → CardTimedOut + audit (replaces the old synchronous webhook timeout)&lt;br&gt;Scope-Catch → audit Error (channel System)&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#0F6CBD;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="650" y="770" width="560" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="c232" value="&lt;b&gt;&lt;font color=&quot;#0F6CBD&quot;&gt;⚡ data-enrichment-mail-intake&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;O365 trigger — when a new e-mail arrives (V2) ④⑧⑫&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;1. Check subject for &lt;b&gt;[Approval: …]&lt;/b&gt; first — if present, route by embedded type (Architecture / Branch-Solace / Branch-MuleSoft): parse APPROVE/REJECT (reject-words checked first), &lt;b&gt;UPDATE the relevant status column only&lt;/b&gt; — never invokes anything else&lt;br&gt;2. Else, existing &lt;b&gt;[Tracking: …]&lt;/b&gt; path (unchanged): validate against audit log + live row, still AwaitingInput → &lt;b&gt;InvokeFunction ParseEnrichmentReply&lt;/b&gt; then re-invoke data-enrichment (channel Mail) with the parsed fields; otherwise audit MailRejected&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#0F6CBD;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="650" y="1050" width="560" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="c233" value="&lt;b&gt;&lt;font color=&quot;#7B5CD6&quot;&gt;⚡ onboarding-orchestrator&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;HTTP Request · invoked by launcher ⑩&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Scope-Try — per-domain scopes, only for domains in the requested list:&lt;br&gt;• Scope-BTP: invoke &lt;b&gt;btp-config-publish&lt;/b&gt;&lt;br&gt;• Scope-MuleSoft / Scope-Solace: generation → &lt;b&gt;If status==AwaitingBranchApproval, skip publish&lt;/b&gt;, else → publish&lt;br&gt;Nothing throws for the awaiting-approval case — it is a genuine 200 outcome, not Scope-Catch. Response 200 always includes each domain&#39;s {status, generate, publish?}&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#7B5CD6;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="650" y="1270" width="560" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="c234" value="&lt;b&gt;&lt;font color=&quot;#8A5A00&quot;&gt;⚡ request-branch-approval-via-email&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;HTTP Request · async, no blocking wait ⑪ (renamed from request-feature-branch-via-teams)&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Per domain (Solace/MuleSoft): if BranchApprovalStatus already Pending, respond immediately (no duplicate e-mail). Else: send the branch-approval e-mail, set BranchApprovalStatus=Pending + PendingBranchName + DeploymentStatus=AwaitingBranchApproval, audit BranchApprovalRequested, &lt;b&gt;Respond 200 {status:AwaitingBranchApproval}&lt;/b&gt; — cannot block, so it never waits for a decision&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#8A5A00;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="1250" y="770" width="700" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="c235" value="&lt;b&gt;&lt;font color=&quot;#24292F&quot;&gt;⚡ solace-config-generation&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;HTTP Request · invoked by orchestrator — checkpoint/resume restructured&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;1. &lt;b&gt;Check_Branch_Exists&lt;/b&gt; — condition &lt;b&gt;fixed&lt;/b&gt; (was always-true: dropped a bogus second OR clause)&lt;br&gt;2. Missing → &lt;b&gt;Request_Branch_Approval_Via_Email&lt;/b&gt; → &lt;b&gt;Response {status:AwaitingBranchApproval}&lt;/b&gt;, stop here&lt;br&gt;3. Exists (else branch) → FetchExistingConfigFile → GenerateSolaceConfig → MergeSolaceConfig → &lt;b&gt;Response {status:Complete, mergedConfigJson, …}&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#24292F;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="1250" y="900" width="700" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="c236" value="&lt;b&gt;&lt;font color=&quot;#24292F&quot;&gt;⚡ mulesoft-config-generation&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;HTTP Request · invoked by orchestrator — same restructuring&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;1. Check_Branch_Exists (condition fixed, same bug) → missing → Request_Branch_Approval_Via_Email → Response {status:AwaitingBranchApproval}&lt;br&gt;2. Exists → FetchExistingConfigFile ×4 → GenerateMuleSoftConfig → &lt;b&gt;Response = union(rawYamlOutput, {status:Complete})&lt;/b&gt; — preserves the existing app.yaml/dev.yaml/… keys the publish step already reads directly&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#24292F;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="1250" y="1080" width="700" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="c237" value="&lt;b&gt;&lt;font color=&quot;#24292F&quot;&gt;⚡ solace-config-publish · mulesoft-config-publish&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;HTTP Request ×2 · invoked by orchestrator only when NOT awaiting branch approval&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;&lt;b&gt;PublishSolaceConfigToFeatureBranch&lt;/b&gt; / &lt;b&gt;PublishMuleSoftConfigToFeatureBranch&lt;/b&gt; — GitHub Contents API PUT (base64, sha-aware create/update) on the feature branch → Response 200 {commit}&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#24292F;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="1250" y="1240" width="700" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="c238" value="&lt;b&gt;&lt;font color=&quot;#24292F&quot;&gt;⚡ btp-config-publish&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;HTTP Request · invoked by orchestrator ⑬&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;&lt;b&gt;TriggerBtpDeployment&lt;/b&gt; → POST /repos/{o}/{r}/actions/workflows/{file}/dispatches {ref, inputs} → 204 → Response 200. Also now checks the function&#39;s own success:false (this session&#39;s earlier fix) and returns 502 instead of always 200 on a real GitHub failure.&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#24292F;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="1250" y="1360" width="700" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="c239" value="&lt;b&gt;&lt;font color=&quot;#8A5A00&quot;&gt;⚡ approval-resume&lt;/font&gt;&lt;/b&gt; — &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;Recurrence — every 5 min · NEW workflow ⑨⑫&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Scope-Architecture: SELECT correlationIds where OnboardingApproval.ArchitectureApprovalStatus=Approved and ≥1 domain not yet Deployed/InProgress/AwaitingBranchApproval (UNION ALL across the 3 domain tables + STRING_AGG to build the still-pending domains[]) → invoke onboarding-launcher.&lt;br&gt;Scope-Branch-Approval: SELECT SolaceClient/MuleSoftPartner rows with DeploymentStatus=AwaitingBranchApproval AND BranchApprovalStatus=Approved → invoke onboarding-launcher with domains:[that one domain].&lt;br&gt;Both scopes only ever call onboarding-launcher — zero gate/CSV-build logic duplicated here.&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#8A5A00;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="lld-1" vertex="1">
                    <mxGeometry x="650" y="1475" width="1300" height="138" as="geometry"/>
                </mxCell>
