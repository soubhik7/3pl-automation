                </mxCell>
                <mxCell id="c29" value="" style="image;sketch=0;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#1F2A37;image=img/lib/azure2/integration/Logic_Apps.svg;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;whiteSpace=wrap;" parent="hld-1" vertex="1">
                    <mxGeometry x="380" y="366" width="52" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="c30" value="&lt;b&gt;Logic App Standard — 3pl-automation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7C&quot; style=&quot;font-size:10px&quot;&gt;13 workflows · SAS-secured HTTP triggers · Scope-Try/Catch + audit on every workflow&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;" parent="hld-1" vertex="1">
                    <mxGeometry x="448" y="372" width="540" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="c31" value="&lt;b&gt;Application Insights&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7C&quot; style=&quot;font-size:9px&quot;&gt;run history · diagnostics&lt;/font&gt;" style="image;sketch=0;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#1F2A37;image=img/lib/azure2/devops/Application_Insights.svg;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;whiteSpace=wrap;" parent="hld-1" vertex="1">
                    <mxGeometry x="1080" y="366" width="44" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="c32" value="&lt;b&gt;&lt;font color=&quot;#0078D4&quot;&gt;INTAKE, STATUS &amp;amp; LAUNCH&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#8A97A6&quot; style=&quot;font-size:9px&quot;&gt;HTTP Request + SAS&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• &lt;b&gt;data-enrichment&lt;/b&gt; — validate + upsert; &lt;b&gt;Direction=Inbound&lt;/b&gt; ⇒ EnrichmentStatus=Complete immediately, no chase&lt;br&gt;• &lt;b&gt;enrichment-status&lt;/b&gt; — read-only aggregate incl. Direction / architecture &amp;amp; branch approval&lt;br&gt;• &lt;b&gt;onboarding-launcher&lt;/b&gt; — enrichment gate → &lt;b&gt;architecture-approval gate&lt;/b&gt; ⑥⑦ → orchestrator&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="hld-1" vertex="1">
                    <mxGeometry x="380" y="440" width="410" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="c33" value="&lt;b&gt;&lt;font color=&quot;#0F6CBD&quot;&gt;ENRICHMENT LOOP (e-mail only)&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• &lt;b&gt;data-enrichment-notifier&lt;/b&gt; — ⏱ every 5 min: structured [[FIELDS]] e-mail (Outbound rows only); DATEDIFF≥5d ⇒ CardTimedOut&lt;br&gt;• &lt;b&gt;data-enrichment-mail-intake&lt;/b&gt; — routes replies by subject tag: &lt;b&gt;[Tracking:…]&lt;/b&gt; → parses fields, re-submits · &lt;b&gt;[Approval:…]&lt;/b&gt; → flips approval status only&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#0F6CBD;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="hld-1" vertex="1">
                    <mxGeometry x="820" y="440" width="405" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="c34" value="&lt;b&gt;&lt;font color=&quot;#8A5A00&quot;&gt;APPROVAL-RESUME POLLER&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• &lt;b&gt;approval-resume&lt;/b&gt; — ⏱ every 5 min: finds correlationIds with architecture approval &lt;b&gt;Approved&lt;/b&gt; (not yet launched) and domains with branch approval &lt;b&gt;Approved&lt;/b&gt; — &lt;b&gt;re-invokes onboarding-launcher&lt;/b&gt; for exactly those. No gate/CSV logic duplicated — launcher stays the single source of truth ⑨⑫&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#8A5A00;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="hld-1" vertex="1">
                    <mxGeometry x="380" y="620" width="845" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="c35" value="&lt;b&gt;&lt;font color=&quot;#7B5CD6&quot;&gt;ORCHESTRATION&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• &lt;b&gt;onboarding-orchestrator&lt;/b&gt; — fan-out to only the requested domain scopes; a domain whose branch is missing returns a third outcome &lt;b&gt;AwaitingBranchApproval&lt;/b&gt; (not a failure) ⑩&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#7B5CD6;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=1;" parent="hld-1" vertex="1">
