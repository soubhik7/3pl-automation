                <mxCell id="c214" value="&lt;b&gt;CONFIG GENERATORS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;GenerateSolaceConfig · MergeSolaceConfig · GenerateMuleSoftConfig — CsvParser / MuleSoftCsvParser → YAML builders&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#57606A;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingRight=8;fontSize=11;fontColor=#1F2A37;whiteSpace=wrap;shadow=0;" parent="lld-1" vertex="1">
