                <mxCell id="c25" value="&lt;b&gt;Business User&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7C&quot; style=&quot;font-size:9px&quot;&gt;starts onboarding · sets Direction · tracks · launches&lt;/font&gt;" style="image;sketch=0;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#1F2A37;image=img/lib/azure2/identity/Users.svg;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;whiteSpace=wrap;" parent="hld-1" vertex="1">
