                <mxCell id="c214" value="InProgress" style="rounded=1;arcSize=50;html=1;fillColor=#EAF3FB;strokeColor=#0078D4;fontColor=#0078D4;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;" parent="lld-1" vertex="1">
                    <mxGeometry x="1150" y="534" width="100" height="32" as="geometry"/>
